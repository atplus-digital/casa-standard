#!/bin/sh
# casa-update-check — compares the CASA contract declared in the router against
# upstream and maintains ONE notice issue in the repo tracker (ADR-0016, SPEC-0008).
#
# Runs SCHEDULED in host CI (casa-update-check.yml workflow) — never inside the gate:
# network calls are acceptable here and external failures never block anyone (exits 0
# whenever external I/O fails; router integrity belongs to docs-check).
#
# Usage: sh scripts/casa-update-check [root]
# Requires: curl and authenticated gh (GITHUB_TOKEN on Actions). Upstream changelog URL
# can be overridden via CASA_SOURCE_URL (tests/forks).
set -u
ROOT="${1:-.}"
LABEL="casa-update"
SOURCE_URL="${CASA_SOURCE_URL:-https://raw.githubusercontent.com/atplus-digital/casa-standard/main/CHANGELOG.md}"

[ -d "$ROOT" ] || { echo "casa-update-check: non-existent root: $ROOT"; exit 2; }
# gh resolves the target repository from the current working directory: ALWAYS cd into
# the inspected root — never operate on the caller's checkout.
cd "$ROOT" || exit 2

declared=$(sed -n 's/^casa-version: *\([0-9][0-9.]*\).*/\1/p' AGENTS.md 2>/dev/null | head -1)
if [ -z "$declared" ]; then
    echo "casa-version unreadable in AGENTS.md — docs-check enforces router validity; nothing to do."
    exit 0
fi

latest=$(curl -fsSL --max-time 20 "$SOURCE_URL" 2>/dev/null | sed -n 's/^## CASA \([0-9][0-9.]*\).*/\1/p' | head -1)
if [ -z "$latest" ]; then
    echo "could not read upstream CASA version from $SOURCE_URL — will retry on next schedule."
    exit 0
fi

echo "declared contract: $declared · upstream: $latest"
newer=$(printf '%s\n%s\n' "$declared" "$latest" | sort -V | tail -1)

if [ "$declared" = "$latest" ] || [ "$newer" = "$declared" ]; then
    # up to date (or ahead — judging that is not this job's role): close any open notice
    open_issues=$(gh issue list --label "$LABEL" --state open --json number --jq '.[].number' 2>/dev/null) || {
        echo "could not query '$LABEL' issues (is gh authenticated? are issues enabled?) — will retry on next schedule."
        exit 0
    }
    for n in $open_issues; do
        if gh issue close "$n" --comment "CASA contract up to date ($declared). Closed automatically by casa-update-check." >/dev/null 2>&1; then
            echo "closed issue #$n (repo caught up with upstream contract)."
        else
            echo "failed to close issue #$n — will retry on next schedule."
        fi
    done
    echo "up to date."
    exit 0
fi

TITLE="CASA contract outdated: declared $declared, upstream $latest"
BODY="The current upstream CASA contract is **$latest**, while this repository declares **casa-version: $declared**.

1. Update the toolchain: run \`scripts/casa-init <this-repo>\` from a current clone of \`casa-standard\` — or without cloning: \`curl -fsSL https://raw.githubusercontent.com/atplus-digital/casa-standard/main/install.sh | sh\`.
2. Read the \`casa-standard\` \`CHANGELOG.md\` entries between $declared and $latest.
3. Once this repository satisfies the new contract, bump \`casa-version\` in \`AGENTS.md\` — the declaration is the repository's own promise and \`casa-init\` never alters it (ADR-0010); until then, \`docs-check\` emits a warning.

_Automated notice from \`casa-update-check\` (casa-standard ADR-0016). This issue is updated in place while behind and closes automatically once caught up._"

gh label create "$LABEL" --color BFD4F2 --description "automated notice from casa-update-check (ADR-0016)" 2>/dev/null || true
# A failed query is NOT "zero open issues": creating blindly would duplicate notices.
existing=$(gh issue list --label "$LABEL" --state open --json number --jq '.[0].number' 2>/dev/null) || {
    echo "could not query '$LABEL' issues (is gh authenticated? are issues enabled?) — refusing to create blindly; will retry on next schedule."
    exit 0
}
if [ -n "$existing" ]; then
    if gh issue edit "$existing" --title "$TITLE" --body "$BODY" >/dev/null 2>&1; then
        echo "updated issue #$existing: $TITLE"
    else
        echo "failed to edit issue #$existing (missing issues: write permission?) — will retry on next schedule."
    fi
else
    if gh issue create --title "$TITLE" --body "$BODY" --label "$LABEL" >/dev/null 2>&1; then
        echo "created issue: $TITLE"
    else
        echo "failed to create issue (missing issues: write permission? issues disabled?) — will retry on next schedule."
    fi
fi
exit 0
