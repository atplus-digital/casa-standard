#!/usr/bin/env bash
# Scenarios for SPEC-0002 (install.sh). DoD: exit 0 = all green. Runs OFFLINE:
# tarballs are built from the local working tree (covering uncommitted changes).
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SH="$ROOT/install.sh"
# Isolate host git config (global core.hooksPath, etc.) so tests stay deterministic.
GIT_CONFIG_GLOBAL=/dev/null; GIT_CONFIG_NOSYSTEM=1; export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM
pass=0; fail=0
ck() { if eval "$2" >/dev/null 2>&1; then echo "PASS: $1"; pass=$((pass+1)); else echo "FAIL: $1"; fail=$((fail+1)); fi; }

W="$(mktemp -d)"
trap 'rm -rf "$W"' EXIT
TB_FLAT="$W/flat.tgz"
tar -czf "$TB_FLAT" --exclude .git -C "$ROOT" scripts docs
STAGE="$W/stage"; mkdir -p "$STAGE/casa-standard-abc1234"
tar -cf - --exclude .git -C "$ROOT" scripts docs | tar -xf - -C "$STAGE/casa-standard-abc1234"
TB_PREFIX="$W/prefix.tgz"
tar -czf "$TB_PREFIX" -C "$STAGE" casa-standard-abc1234

# EARS 7 + 2 — local tarball, target and flags forwarded intact
A="$W/a"
CASA_TARBALL="$TB_FLAT" sh "$SH" "$A" --repo-id app-via-curl >/dev/null 2>&1
ck "EARS-7: bootstrap via local tarball, offline"      '[ -f "$A/AGENTS.md" ]'
ck "EARS-2: flags forwarded intact to casa-init"       'grep -q "casa-repo-id: app-via-curl" "$A/AGENTS.md"'
ck "bootstrapped target passes docs-check"             '(cd "$A" && python3 scripts/docs-check)'

# EARS 6 — pinned ref becomes router stamp
B="$W/b"
CASA_TARBALL="$TB_FLAT" CASA_REF=v9.9.9-test sh "$SH" "$B" >/dev/null 2>&1
ck "EARS-6: CASA_REF stamped in router"                'grep -q "casa-standard-ref: v9.9.9-test" "$B/AGENTS.md"'

# EARS 8 — codeload format (top-level directory prefix)
C="$W/c"
CASA_TARBALL="$TB_PREFIX" sh "$SH" "$C" >/dev/null 2>&1
ck "EARS-8: prefixed-directory tarball works"          '[ -f "$C/AGENTS.md" ]'

# EARS 1 — no arguments → current working directory
D="$W/d"; mkdir -p "$D"
(cd "$D" && CASA_TARBALL="$TB_FLAT" sh "$SH" >/dev/null 2>&1)
ck "EARS-1: no arguments targets PWD"                  '[ -f "$D/AGENTS.md" ]'

# EARS 3 — flags only → current working directory as target
E="$W/e"; mkdir -p "$E"
(cd "$E" && CASA_TARBALL="$TB_FLAT" sh "$SH" --repo-id flags-only >/dev/null 2>&1)
ck "EARS-3: flags only assumes PWD as target"          'grep -q "casa-repo-id: flags-only" "$E/AGENTS.md"'

# EARS 4 — missing python3: clear failure before writing anything
F="$W/f"; mkdir -p "$F"
EMPTYBIN="$W/bin"; mkdir -p "$EMPTYBIN"
OUT=$( (cd "$F" && env PATH="$EMPTYBIN" CASA_TARBALL="$TB_FLAT" "$(command -v sh)" "$SH" 2>&1); echo "rc=$?" )
ck "EARS-4: missing python3 fails with clear message"  'echo "$OUT" | grep -q "python3" && echo "$OUT" | grep -q "rc=1"'
ck "EARS-4: nothing written to target"                 '[ ! -e "$F/AGENTS.md" ]'

# EARS 5 — structural guard against truncated downloads
ck "EARS-5: body inside main(), invoked on last line"  '[ "$(tail -1 "$SH")" = "main \"\$@\"" ]'
ck "valid POSIX sh syntax (sh -n)"                     'sh -n "$SH"'

# SPEC-0009/21 — documented pinning passes CASA_REF to sh (prefixing curl never reaches sh)
ck "SPEC-0009/21: README pins with | CASA_REF=… sh"    'grep -q "| CASA_REF=<tag|sha> sh -s --" "$ROOT/README.md"'
ck "SPEC-0009/21: STANDARD pins with | CASA_REF=… sh"  'grep -q "| CASA_REF=<tag|sha> sh -s --" "$ROOT/STANDARD.md"'

echo
echo "==== $pass PASS / $fail FAIL ===="
[ "$fail" -eq 0 ]
