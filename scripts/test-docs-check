#!/usr/bin/env bash
# Cenários da SPEC-0003 e SPEC-0004 (docs-check). DoD: exit 0 = todos verdes.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CHECK="$ROOT/scripts/docs-check"
INIT="$ROOT/scripts/casa-init"
# Versão de contrato derivada da constante do validador (nunca hardcodada no fixture).
DC_V="$(sed -n 's/^CONTRACT_VERSION = "\(.*\)"$/\1/p' "$CHECK")"
pass=0; fail=0
ck() { if eval "$2" >/dev/null 2>&1; then echo "PASS: $1"; pass=$((pass+1)); else echo "FAIL: $1"; fail=$((fail+1)); fi; }

set_version() { # troca o casa-version do router do fixture atual
    sed "s/^casa-version: .*/casa-version: $1/" "$R/AGENTS.md" > "$R/AGENTS.tmp" \
        && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
}

mkrepo() {
    R="$(mktemp -d)"
    mkdir -p "$R"
    cat > "$R/AGENTS.md" <<'EOF'
# AGENTS.md

```yaml
casa-repo-id: teste
casa-tier: T1
casa-version: 0.0
casa-standard-ref: test
```

## Como validar (DoD global do repo)

```bash
python3 scripts/docs-check
```

## Mapa de contexto

| Capítulo | Quando carregar |
|---|---|
| (nenhum ainda) | — |
EOF
    set_version "$DC_V"
}

spec_doc() {
    status="$1"; impl="$2"; questions="$3"; dod="$4"; verification="$5"
    mkdir -p "$R/docs/specs"
    cat > "$R/docs/specs/0001-x.md" <<EOF
---
status: $status
date: 2026-06-13
builds-on: []
implemented-by: $impl
---

# Spec de teste

## Questões em aberto

$questions

## Definition of Done

\`\`\`bash
$dod
\`\`\`

## Verificação

\`\`\`text
$verification
\`\`\`
EOF
}

adr_doc() {
    path="$1"; status="$2"; superseded_by="$3"; truth="$4"; body="$5"
    mkdir -p "$(dirname "$path")"
    cat > "$path" <<EOF
---
status: $status
date: 2026-06-13
builds-on: []
superseded-by: $superseded_by
deciders: [maicon]
---

$truth
# Decisão de teste

## Contexto e problema

$body

## Direcionadores da decisão

- teste

## Opções consideradas

### Opção 1 — teste
**Prós:** simples
**Contras:** nenhum

## Decisão

Manter teste.

## Consequências

- teste

## Confirmação

\`\`\`bash
true
\`\`\`
EOF
}

# EARS 1 — greenfield via casa-init continua verde
A="$(mktemp -d)/novo"
python3 "$INIT" "$A" --repo-id app >/dev/null
ck "EARS-1: repo novo criado pelo casa-init passa docs-check" \
   '(cd "$A" && python3 scripts/docs-check)'

# EARS 2 — router sem casa-version falha
mkrepo
grep -v '^casa-version:' "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-2: router sem casa-version falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "casa-version"'

# EARS 3 — ponteiro de contexto quebrado falha
mkrepo
awk '{ if ($0 == "| (nenhum ainda) | — |") print "| `docs/context/INFRA.md` | mexeu em infra |"; else print }' \
    "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-3: Mapa de contexto com arquivo inexistente falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "Mapa de contexto"'

# EARS 4 — Spec accepted com questão aberta falha
mkrepo
spec_doc accepted "[]" "- [ ] decidir borda" "true" "não implementada"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-4: Spec accepted com checkbox aberto falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "questões em aberto"'

# EARS 5 — DoD com placeholder falha
mkrepo
spec_doc accepted "[]" "(nenhuma)" "npm test -- --run <escopo>" "não implementada"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-5: DoD com placeholder falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "placeholder"'

# EARS 6 — implemented-by precisa existir
mkrepo
spec_doc implemented "[nao-existe.py]" "(nenhuma)" "true" "true -> exit 0"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-6: implemented-by inexistente falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "path inexistente"'

# EARS 7 — ADR aceito não aceita emenda substantiva
mkrepo
mkdir -p "$R/docs/adr"
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto original."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git init -q &&
 git config user.email casa@example.invalid && git config user.name CASA &&
 git add . && git commit -q -m base)
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto alterado."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git add . && git commit -q -m bad)
OUT=$(python3 "$CHECK" --root "$R" --check-adr-immutability --base-ref HEAD~1 2>&1); RC=$?
ck "EARS-7: emenda substantiva em ADR aceito falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "corpo alterado"'

# EARS 8 — supersessão com VERDADE ATUAL passa
mkrepo
mkdir -p "$R/docs/adr"
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto original."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git init -q &&
 git config user.email casa@example.invalid && git config user.name CASA &&
 git add . && git commit -q -m base)
adr_doc "$R/docs/adr/0002-y.md" accepted null "" "Nova decisão."
adr_doc "$R/docs/adr/0001-x.md" superseded ADR-0002 "> VERDADE ATUAL: substituído por ADR-0002" "Contexto original."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git add . && git commit -q -m supersede)
OUT=$(python3 "$CHECK" --root "$R" --check-adr-immutability --base-ref HEAD~1 2>&1); RC=$?
ck "EARS-8: supersessão com VERDADE ATUAL passa" '[ "$RC" -eq 0 ]'

# --- SPEC-0004: capítulo de contexto reconhecido (TESTS) ---

decl_tests() { # injeta o ponteiro do capítulo $1 no Mapa de contexto do router
    awk -v row="| \`$1\` | mexeu em teste |" \
        '{ if ($0 == "| (nenhum ainda) | — |") print row; else print }' \
        "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
    mkdir -p "$R/docs/context"
}

# EARS 9 — TESTS.md declarado com comando canônico passa
mkrepo
decl_tests "docs/context/TESTS.md"
cat > "$R/docs/context/TESTS.md" <<'EOF'
# Testes

## Comandos canônicos

```bash
pytest -q
```
EOF
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-9: TESTS.md declarado com comando canônico passa" '[ "$RC" -eq 0 ]'

# EARS 10 — TESTS.md declarado sem comando falha
mkrepo
decl_tests "docs/context/TESTS.md"
printf '# Testes\n\nRodamos os testes manualmente antes do merge.\n' > "$R/docs/context/TESTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-10: TESTS.md declarado sem comando falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "capítulo reconhecido"'

# EARS 11 — capítulo genérico (INFRA) sem comando passa: só TESTS é reconhecido
mkrepo
decl_tests "docs/context/INFRA.md"
printf '# Infra\n\nSelf-hosted no Hetzner.\n' > "$R/docs/context/INFRA.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-11: capítulo genérico sem comando passa (registry fechado)" '[ "$RC" -eq 0 ]'

# --- SPEC-0006: sinalização de manutenção (ADR-0010, ADR-0011) ---

# SPEC-0006/1 — contrato declarado menor que a toolchain → aviso, exit 0
mkrepo
set_version "0.9"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/1: casa-version menor gera aviso e passa" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*atrás da toolchain"'

# SPEC-0006/2 — contrato declarado maior que a toolchain → aviso de toolchain atrás
mkrepo
set_version "99.9"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/2: casa-version maior avisa toolchain atrás" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*rode scripts/casa-init"'

# SPEC-0006/3 — versões iguais → nenhum aviso ADR-0010
mkrepo
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/3: versões iguais não geram aviso" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "ADR-0010"'

# SPEC-0006/4 — casa-version malformado: só o erro de formato, sem aviso por cima
mkrepo
set_version "banana"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/4: versão malformada só gera o erro de formato" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "semver simples" && ! echo "$OUT" | grep -q "ADR-0010"'

# SPEC-0006/5 — backlog em docs/context/ → aviso de localização, exit 0
mkrepo
mkdir -p "$R/docs/context"
printf '# Backlog\n\n- pendência\n' > "$R/docs/context/BACKLOG.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/5: BACKLOG.md em docs/context/ gera aviso" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*mova para docs/BACKLOG.md"'

# SPEC-0006/5b — variação de case também é apontada (listagem, não exists())
mkrepo
mkdir -p "$R/docs/context"
printf '# Backlog\n' > "$R/docs/context/backlog.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/5b: backlog.md (case variante) gera aviso" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*mova para docs/BACKLOG.md"'

# SPEC-0006/6 — docs/BACKLOG.md na raiz de docs é o lugar certo: silêncio
mkrepo
mkdir -p "$R/docs"
printf '# Backlog\n\n- pendência\n' > "$R/docs/BACKLOG.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/6: docs/BACKLOG.md na raiz não gera aviso" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "ADR-0011"'

# --- ADR-0014: design-ref no vocabulário central ---

# design-ref é campo conhecido (sem aviso) e exportado ao index.json
mkrepo
mkdir -p "$R/docs/specs"
cat > "$R/docs/specs/0001-ui.md" <<EOF
---
status: draft
date: 2026-07-05
builds-on: []
design-ref: docs/design/mock.html
---

# Spec de UI
EOF
python3 "$CHECK" --root "$R" --emit-index >/dev/null
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "ADR-0014: design-ref não gera aviso de vocabulário" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "fora do vocabulário"'
ck "ADR-0014: design-ref exportado ao index.json" \
   'grep -q "design-ref" "$R/docs/index.json"'

# controle: campo realmente desconhecido segue avisando
mkrepo
mkdir -p "$R/docs/specs"
cat > "$R/docs/specs/0001-x.md" <<EOF
---
status: draft
date: 2026-07-05
campo-inventado: x
---

# Spec com campo estranho
EOF
python3 "$CHECK" --root "$R" --emit-index >/dev/null
OUT=$(python3 "$CHECK" --root "$R" 2>&1)
ck "ADR-0014: campo desconhecido continua avisando" \
   'echo "$OUT" | grep -q "fora do vocabulário"'

# --- SPEC-0009: README gerado por conteúdo canônico ---

mkrepo
mkdir -p "$R/docs/specs"
cat > "$R/docs/specs/0001-a.md" <<'EOF'
---
status: draft
date: 2026-07-08
builds-on: []
---

# Spec A
EOF
cat > "$R/docs/specs/0002-b.md" <<'EOF'
---
status: draft
date: 2026-07-08
builds-on: []
---

# Spec B
EOF
python3 "$CHECK" --root "$R" --emit-index >/dev/null
BASE="$R/docs/specs/README.md"
python3 - "$BASE" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
lines = p.read_text(encoding="utf-8").splitlines()
rows = lines[6:]
rows[0] = rows[0].replace("| [SPEC-0001](0001-a.md) | Spec A | draft |", "|  [SPEC-0001](0001-a.md)  |  Spec A  |  draft  |")
rows[1] = rows[1].replace("| [SPEC-0002](0002-b.md) | Spec B | accepted |", "| [SPEC-0002](0002-b.md) | Spec B | accepted |")
cosmetic = [
    lines[0],
    "",
    lines[2],
    "",
    "|  id  |  título  |  status  |",
    "| :--- | :---: | ---: |",
    "",
    rows[0],
    "",
    rows[1],
]
p.write_text("\n".join(cosmetic) + "\n", encoding="utf-8")
PY
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/1: README reformatado continua verde" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "índices: docs/specs/README.md"'

cp "$R/docs/specs/README.md" "$R/docs/specs/README.md.bak"
python3 - "$R/docs/specs/README.md" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
text = p.read_text(encoding="utf-8")
text = text.replace("| [SPEC-0002](0002-b.md) | Spec B | draft |", "| [SPEC-0002](0002-b.md) | Spec B | accepted |")
p.write_text(text, encoding="utf-8")
PY
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/2: mudança real de status falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "divergente do gerado"'
mv "$R/docs/specs/README.md.bak" "$R/docs/specs/README.md"

cp "$R/docs/specs/README.md" "$R/docs/specs/README.md.bak"
python3 - "$R/docs/specs/README.md" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
text = p.read_text(encoding="utf-8")
text = text.replace("(0001-a.md)", "(0001-a-renamed.md)")
p.write_text(text, encoding="utf-8")
PY
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/3: mudança real no link do id falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "divergente do gerado"'
mv "$R/docs/specs/README.md.bak" "$R/docs/specs/README.md"

cp "$R/docs/specs/README.md" "$R/docs/specs/README.md.bak"
python3 - "$R/docs/specs/README.md" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
lines = p.read_text(encoding="utf-8").splitlines()
head = lines[:6]
rows = [ln for ln in lines[6:] if ln.strip()]
rows = [rows[1], rows[0]]
p.write_text("\n".join(head + ["", rows[0], "", rows[1]]) + "\n", encoding="utf-8")
PY
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/4: reordenação real falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "divergente do gerado"'
mv "$R/docs/specs/README.md.bak" "$R/docs/specs/README.md"

cp "$R/docs/specs/README.md" "$R/docs/specs/README.md.bak"
python3 - "$R/docs/specs/README.md" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
lines = [ln for ln in p.read_text(encoding="utf-8").splitlines() if "GERADO" not in ln]
p.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/5: marcador ausente falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "inválido como README gerado"'
mv "$R/docs/specs/README.md.bak" "$R/docs/specs/README.md"

echo
echo "==== $pass PASS / $fail FAIL ===="
[ "$fail" -eq 0 ]
