#!/usr/bin/env bash
# Cenários das SPEC-0003, 0004, 0006 e 0009 (docs-check). DoD: exit 0 = todos verdes.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CHECK="$ROOT/scripts/docs-check"
INIT="$ROOT/scripts/casa-init"
# Versão de contrato derivada da constante do validador (nunca hardcodada no fixture).
DC_V="$(sed -n 's/^CONTRACT_VERSION = "\(.*\)"$/\1/p' "$CHECK")"
pass=0; fail=0
ck() { if eval "$2" >/dev/null 2>&1; then echo "PASS: $1"; pass=$((pass+1)); else echo "FAIL: $1"; fail=$((fail+1)); fi; }

set_version() { # troca o casa-version do router do fixture atual
    sed "s/^casa-version: .*/casa-version: $1/" "$R/AGENTS.md" > "$R/AGENTS.tmp" \
        && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
}

mkrepo() {
    R="$(mktemp -d)"
    mkdir -p "$R"
    cat > "$R/AGENTS.md" <<'EOF'
# AGENTS.md

```yaml
casa-repo-id: teste
casa-tier: T1
casa-version: 0.0
casa-standard-ref: test
```

## Como validar (DoD global do repo)

```bash
python3 scripts/docs-check
```

## Mapa de contexto

| Capítulo | Quando carregar |
|---|---|
| (nenhum ainda) | — |
EOF
    set_version "$DC_V"
}

spec_doc() {
    status="$1"; impl="$2"; questions="$3"; dod="$4"; verification="$5"
    mkdir -p "$R/docs/specs"
    cat > "$R/docs/specs/0001-x.md" <<EOF
---
status: $status
date: 2026-06-13
builds-on: []
implemented-by: $impl
---

# Spec de teste

## Questões em aberto

$questions

## Definition of Done

\`\`\`bash
$dod
\`\`\`

## Verificação

\`\`\`text
$verification
\`\`\`
EOF
}

adr_doc() {
    path="$1"; status="$2"; superseded_by="$3"; truth="$4"; body="$5"
    mkdir -p "$(dirname "$path")"
    cat > "$path" <<EOF
---
status: $status
date: 2026-06-13
builds-on: []
superseded-by: $superseded_by
deciders: [maicon]
---

$truth
# Decisão de teste

## Contexto e problema

$body

## Direcionadores da decisão

- teste

## Opções consideradas

### Opção 1 — teste
**Prós:** simples
**Contras:** nenhum

## Decisão

Manter teste.

## Consequências

- teste

## Confirmação

\`\`\`bash
true
\`\`\`
EOF
}

# EARS 1 — greenfield via casa-init continua verde
A="$(mktemp -d)/novo"
python3 "$INIT" "$A" --repo-id app >/dev/null
ck "EARS-1: repo novo criado pelo casa-init passa docs-check" \
   '(cd "$A" && python3 scripts/docs-check)'

# EARS 2 — router sem casa-version falha
mkrepo
grep -v '^casa-version:' "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-2: router sem casa-version falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "casa-version"'

# EARS 3 — ponteiro de contexto quebrado falha
mkrepo
awk '{ if ($0 == "| (nenhum ainda) | — |") print "| `docs/context/INFRA.md` | mexeu em infra |"; else print }' \
    "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-3: Mapa de contexto com arquivo inexistente falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "Mapa de contexto"'

# EARS 4 — Spec accepted com questão aberta falha
mkrepo
spec_doc accepted "[]" "- [ ] decidir borda" "true" "não implementada"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-4: Spec accepted com checkbox aberto falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "questões em aberto"'

# EARS 5 — DoD com placeholder falha
mkrepo
spec_doc accepted "[]" "(nenhuma)" "npm test -- --run <escopo>" "não implementada"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-5: DoD com placeholder falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "placeholder"'

# EARS 6 — implemented-by precisa existir
mkrepo
spec_doc implemented "[nao-existe.py]" "(nenhuma)" "true" "true -> exit 0"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-6: implemented-by inexistente falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "path inexistente"'

# EARS 7 — ADR aceito não aceita emenda substantiva
mkrepo
mkdir -p "$R/docs/adr"
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto original."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git init -q &&
 git config user.email casa@example.invalid && git config user.name CASA &&
 git add . && git commit -q -m base)
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto alterado."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git add . && git commit -q -m bad)
OUT=$(python3 "$CHECK" --root "$R" --check-adr-immutability --base-ref HEAD~1 2>&1); RC=$?
ck "EARS-7: emenda substantiva em ADR aceito falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "corpo alterado"'

# EARS 8 — supersessão com VERDADE ATUAL passa
mkrepo
mkdir -p "$R/docs/adr"
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto original."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git init -q &&
 git config user.email casa@example.invalid && git config user.name CASA &&
 git add . && git commit -q -m base)
adr_doc "$R/docs/adr/0002-y.md" accepted null "" "Nova decisão."
adr_doc "$R/docs/adr/0001-x.md" superseded ADR-0002 "> VERDADE ATUAL: substituído por ADR-0002" "Contexto original."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git add . && git commit -q -m supersede)
OUT=$(python3 "$CHECK" --root "$R" --check-adr-immutability --base-ref HEAD~1 2>&1); RC=$?
ck "EARS-8: supersessão com VERDADE ATUAL passa" '[ "$RC" -eq 0 ]'

# --- SPEC-0004: capítulo de contexto reconhecido (TESTS) ---

decl_tests() { # injeta o ponteiro do capítulo $1 no Mapa de contexto do router
    awk -v row="| \`$1\` | mexeu em teste |" \
        '{ if ($0 == "| (nenhum ainda) | — |") print row; else print }' \
        "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
    mkdir -p "$R/docs/context"
}

# EARS 9 — TESTS.md declarado com comando canônico passa
mkrepo
decl_tests "docs/context/TESTS.md"
cat > "$R/docs/context/TESTS.md" <<'EOF'
# Testes

## Comandos canônicos

```bash
pytest -q
```
EOF
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-9: TESTS.md declarado com comando canônico passa" '[ "$RC" -eq 0 ]'

# EARS 10 — TESTS.md declarado sem comando falha
mkrepo
decl_tests "docs/context/TESTS.md"
printf '# Testes\n\nRodamos os testes manualmente antes do merge.\n' > "$R/docs/context/TESTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-10: TESTS.md declarado sem comando falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "capítulo reconhecido"'

# EARS 11 — capítulo genérico (INFRA) sem comando passa: só TESTS é reconhecido
mkrepo
decl_tests "docs/context/INFRA.md"
printf '# Infra\n\nSelf-hosted no Hetzner.\n' > "$R/docs/context/INFRA.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-11: capítulo genérico sem comando passa (registry fechado)" '[ "$RC" -eq 0 ]'

# --- SPEC-0006: sinalização de manutenção (ADR-0010, ADR-0011) ---

# SPEC-0006/1 — contrato declarado menor que a toolchain → aviso, exit 0
mkrepo
set_version "0.9"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/1: casa-version menor gera aviso e passa" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*atrás da toolchain"'

# SPEC-0006/2 — contrato declarado maior que a toolchain → aviso de toolchain atrás
mkrepo
set_version "99.9"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/2: casa-version maior avisa toolchain atrás" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*rode scripts/casa-init"'

# SPEC-0006/3 — versões iguais → nenhum aviso ADR-0010
mkrepo
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/3: versões iguais não geram aviso" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "ADR-0010"'

# SPEC-0006/4 — casa-version malformado: só o erro de formato, sem aviso por cima
mkrepo
set_version "banana"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/4: versão malformada só gera o erro de formato" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "semver simples" && ! echo "$OUT" | grep -q "ADR-0010"'

# SPEC-0006/5 — backlog em docs/context/ → aviso de localização, exit 0
mkrepo
mkdir -p "$R/docs/context"
printf '# Backlog\n\n- pendência\n' > "$R/docs/context/BACKLOG.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/5: BACKLOG.md em docs/context/ gera aviso" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*mova para docs/BACKLOG.md"'

# SPEC-0006/5b — variação de case também é apontada (listagem, não exists())
mkrepo
mkdir -p "$R/docs/context"
printf '# Backlog\n' > "$R/docs/context/backlog.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/5b: backlog.md (case variante) gera aviso" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*mova para docs/BACKLOG.md"'

# SPEC-0006/6 — docs/BACKLOG.md na raiz de docs é o lugar certo: silêncio
mkrepo
mkdir -p "$R/docs"
printf '# Backlog\n\n- pendência\n' > "$R/docs/BACKLOG.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/6: docs/BACKLOG.md na raiz não gera aviso" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "ADR-0011"'

# --- ADR-0014: design-ref no vocabulário central ---

# design-ref é campo conhecido (sem aviso) e exportado ao index.json
mkrepo
mkdir -p "$R/docs/specs"
cat > "$R/docs/specs/0001-ui.md" <<EOF
---
status: draft
date: 2026-07-05
builds-on: []
design-ref: docs/design/mock.html
---

# Spec de UI
EOF
python3 "$CHECK" --root "$R" --emit-index >/dev/null
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "ADR-0014: design-ref não gera aviso de vocabulário" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "fora do vocabulário"'
ck "ADR-0014: design-ref exportado ao index.json" \
   'grep -q "design-ref" "$R/docs/index.json"'

# controle: campo realmente desconhecido segue avisando
mkrepo
mkdir -p "$R/docs/specs"
cat > "$R/docs/specs/0001-x.md" <<EOF
---
status: draft
date: 2026-07-05
campo-inventado: x
---

# Spec com campo estranho
EOF
python3 "$CHECK" --root "$R" --emit-index >/dev/null
OUT=$(python3 "$CHECK" --root "$R" 2>&1)
ck "ADR-0014: campo desconhecido continua avisando" \
   'echo "$OUT" | grep -q "fora do vocabulário"'

# --- SPEC-0009: gate confiável ---

gitify() { # transforma o fixture atual em repo git com um commit base
    (cd "$R" && git init -q -b main && git config user.email casa@example.invalid &&
     git config user.name CASA && python3 "$CHECK" --emit-index >/dev/null &&
     git add -A && git commit -q -m base)
}
commit_all() { (cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git add -A && git commit -q -m "$1"); }
set_dod() { # troca o bloco do DoD global do router pelo conteúdo de $1 (arquivo)
    python3 - "$R/AGENTS.md" "$1" <<'EOF'
import re, sys
p, blk = sys.argv[1], open(sys.argv[2]).read()
t = open(p).read()
t = re.sub(r"(## Como validar \(DoD global do repo\)\n\n)```bash\n.*?\n```\n", lambda m: m.group(1) + blk, t, flags=re.S)
open(p, "w").write(t)
EOF
}

# SPEC-0009/2 — DoD de exemplo do template antigo → AVISO
mkrepo
printf '```bash\nnpm run typecheck        # exit 0\nnpm test                 # tudo verde\n```\n' > "$R/dod"; set_dod "$R/dod"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/2: DoD de exemplo do template avisa" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*exemplo do template"'

# SPEC-0009/3 — DoD global só dentro de comentário HTML → erro
mkrepo
printf '<!--\n```bash\nmake test\n```\n-->\n' > "$R/dod"; set_dod "$R/dod"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/3: DoD global comentado falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "DoD global sem linha executável"'

# SPEC-0009/3b — TESTS.md cujo único comando está comentado → erro
mkrepo
decl_tests "docs/context/TESTS.md"
printf '# Testes\n<!--\n```bash\nnpm test\n```\n-->\n' > "$R/docs/context/TESTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/3b: TESTS.md com comando só em comentário falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "capítulo reconhecido"'

# SPEC-0009/4 — placeholder no DoD global falha; literal entre aspas e redireção passam
mkrepo
printf '```bash\nnpm test -- <escopo>   # exit 0\n```\n' > "$R/dod"; set_dod "$R/dod"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/4: placeholder no DoD global falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "DoD global contém placeholder"'
mkrepo
spec_doc accepted "[]" "(nenhuma)" 'npx vitest run -t "renders <Button> disabled"   # casos 1-2
python3 tool.py <in.json >out.json   # caso 3' "não implementada"
python3 "$CHECK" --root "$R" --emit-index >/dev/null
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/4: <Tag> entre aspas e redireção não são placeholder" '[ "$RC" -eq 0 ]'

# SPEC-0009/5 — ponteiro como link markdown para capítulo inexistente → erro
mkrepo
awk '{ if ($0 == "| (nenhum ainda) | — |") print "| [INFRA](docs/context/INFRA.md) | mexeu em infra |"; else print }' \
    "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/5: link markdown para capítulo inexistente falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "inexistente .docs/context/INFRA.md"'

# SPEC-0009/6 — frontmatter: chave duplicada, status vazio, status lista (sem traceback)
mkrepo
mkdir -p "$R/docs/adr"
printf -- '---\nstatus: proposed\ndate: 2026-01-01\nstatus: accepted\n---\n# X\n' > "$R/docs/adr/0001-x.md"
python3 "$CHECK" --root "$R" --emit-index >/dev/null
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/6: chave duplicada falha" '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "chave duplicada .status."'
printf -- '---\nstatus: ""\ndate: 2026-01-01\n---\n# X\n' > "$R/docs/adr/0001-x.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/6: status vazio conta como ausente" '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "obrigatórios ausentes"'
printf -- '---\nstatus: [accepted]\ndate: 2026-01-01\n---\n# X\n' > "$R/docs/adr/0001-x.md"
OUT=$(python3 "$CHECK" --root "$R" --warn-only 2>&1); RC=$?
ck "SPEC-0009/6: status lista vira erro, sem traceback, --warn-only sai 0" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "status deve ser escalar" && ! echo "$OUT" | grep -q Traceback'

# SPEC-0009/7 — builds-on apontando para o próprio doc → erro
mkrepo
mkdir -p "$R/docs/adr"
printf -- '---\nstatus: proposed\ndate: 2026-01-01\nbuilds-on: [ADR-0001]\n---\n# X\n' > "$R/docs/adr/0001-x.md"
python3 "$CHECK" --root "$R" --emit-index >/dev/null
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/7: builds-on autorreferente falha" '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "próprio doc"'

imm() { python3 "$CHECK" --root "$R" --check-adr-immutability --base-ref "$1" 2>&1; }

# SPEC-0009/8 — renomear ADR aceito não esconde edição; rename puro passa
mkrepo; adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto original."; gitify
(cd "$R" && git mv docs/adr/0001-x.md docs/adr/0001-novo-nome.md)
commit_all rename
OUT=$(imm HEAD~1); RC=$?
ck "SPEC-0009/8: rename puro de ADR aceito passa" '[ "$RC" -eq 0 ]'
adr_doc "$R/docs/adr/0001-novo-nome.md" accepted null "" "Contexto alterado."
commit_all edit
OUT=$(imm HEAD~2); RC=$?
ck "SPEC-0009/8: rename + edição de ADR aceito falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "renomeado de docs/adr/0001-x.md"'

# SPEC-0009/9 — ADR aceito removido → erro
mkrepo; adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto."; gitify
rm "$R/docs/adr/0001-x.md"; commit_all delete
OUT=$(imm HEAD~1); RC=$?
ck "SPEC-0009/9: ADR aceito removido falha" '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "foi removido"'

# SPEC-0009/10 — status de ADR aceito não regride (accepted → proposed)
mkrepo; adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto."; gitify
adr_doc "$R/docs/adr/0001-x.md" proposed null "" "Contexto."; commit_all regress
OUT=$(imm HEAD~1); RC=$?
ck "SPEC-0009/10: accepted → proposed falha" '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "regrediu"'

# SPEC-0009/11 — VERDADE ATUAL só vale no topo e com até 3 linhas
mkrepo; adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto."; gitify
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto.

> VERDADE ATUAL: na prática decidimos o contrário"
commit_all meio
OUT=$(imm HEAD~1); RC=$?
ck "SPEC-0009/11: VERDADE ATUAL no meio do corpo conta como corpo" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "corpo alterado"'
mkrepo; adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto."; gitify
adr_doc "$R/docs/adr/0001-x.md" accepted null "> VERDADE ATUAL: 1
> 2
> 3
> 4 — linha além do limite" "Contexto."
commit_all longo
OUT=$(imm HEAD~1); RC=$?
ck "SPEC-0009/11: VERDADE ATUAL com mais de 3 linhas falha" '[ "$RC" -ne 0 ]'

# SPEC-0009/12 — branch atrás da base: ADR aceito novo na base não vira falso "removido"
mkrepo; adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto."; gitify
(cd "$R" && git checkout -q -b feat)
mkdir -p "$R/src"; echo x > "$R/src/a.txt"; commit_all feat
(cd "$R" && git checkout -q main)
adr_doc "$R/docs/adr/0002-y.md" accepted null "" "Nova."; commit_all main-avanca
(cd "$R" && git checkout -q feat)
OUT=$(imm main); RC=$?
ck "SPEC-0009/12: compara com a merge-base, não com a ponta da base" '[ "$RC" -eq 0 ]'

# SPEC-0009/13 — higiene segue o git: ignorado não reprova; duplicado versionável reprova
mkrepo; gitify
printf '.DS_Store\n' > "$R/.gitignore"; mkdir -p "$R/src"; : > "$R/src/.DS_Store"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/13: .DS_Store ignorado pelo .gitignore não reprova" '[ "$RC" -eq 0 ]'
: > "$R/src/notas.md"; : > "$R/src/notas 2.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/13: duplicado não ignorado reprova" '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "duplicado de sync"'

# SPEC-0009/14 — --staged valida o INDEX, não a working tree
mkrepo; gitify
mkdir -p "$R/docs/adr"
printf -- '---\nstatus: banana\n---\nsem h1\n' > "$R/docs/adr/0001-x.md"
(cd "$R" && git add docs/adr/0001-x.md); rm "$R/docs/adr/0001-x.md"
OUT=$(cd "$R" && python3 "$CHECK" --staged 2>&1); RC=$?
ck "SPEC-0009/14: doc inválido no index falha mesmo corrigido no disco" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "status inválido"'
(cd "$R" && git reset -q)
printf -- '---\nstatus: proposed\ndate: 2026-01-01\n---\n# X\n' > "$R/docs/adr/0001-x.md"
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git add -A)
printf -- '---\nstatus: banana\n---\n' > "$R/docs/adr/0001-x.md"
OUT=$(cd "$R" && python3 "$CHECK" --staged 2>&1); RC=$?
ck "SPEC-0009/14: index válido passa mesmo com o disco quebrado" '[ "$RC" -eq 0 ]'

echo
echo "==== $pass PASS / $fail FAIL ===="
[ "$fail" -eq 0 ]
