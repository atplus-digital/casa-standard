#!/usr/bin/env bash
# Cenários das SPEC-0003, SPEC-0004, SPEC-0006 e SPEC-0009. DoD: exit 0 = todos verdes.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CHECK="$ROOT/scripts/docs-check"
INIT="$ROOT/scripts/casa-init"
# Versão de contrato derivada da constante do validador (nunca hardcodada no fixture).
DC_V="$(sed -n 's/^CONTRACT_VERSION = "\(.*\)"$/\1/p' "$CHECK")"
pass=0; fail=0
ck() { if eval "$2" >/dev/null 2>&1; then echo "PASS: $1"; pass=$((pass+1)); else echo "FAIL: $1"; fail=$((fail+1)); fi; }

set_version() { # troca o casa-version do router do fixture atual
    sed "s/^casa-version: .*/casa-version: $1/" "$R/AGENTS.md" > "$R/AGENTS.tmp" \
        && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
}

mkrepo() {
    R="$(mktemp -d)"
    mkdir -p "$R"
    cat > "$R/AGENTS.md" <<'EOF'
# AGENTS.md

```yaml
casa-repo-id: teste
casa-tier: T1
casa-version: 0.0
casa-standard-ref: test
```

## Como validar (DoD global do repo)

```bash
python3 scripts/docs-check
```

## Mapa de contexto

| Capítulo | Quando carregar |
|---|---|
| (nenhum ainda) | — |
EOF
    set_version "$DC_V"
}

spec_doc() {
    status="$1"; impl="$2"; questions="$3"; dod="$4"; verification="$5"
    mkdir -p "$R/docs/specs"
    cat > "$R/docs/specs/0001-x.md" <<EOF
---
status: $status
date: 2026-06-13
builds-on: []
implemented-by: $impl
---

# Spec de teste

## Questões em aberto

$questions

## Definition of Done

\`\`\`bash
$dod
\`\`\`

## Verificação

\`\`\`text
$verification
\`\`\`
EOF
}

adr_doc() {
    path="$1"; status="$2"; superseded_by="$3"; truth="$4"; body="$5"
    mkdir -p "$(dirname "$path")"
    cat > "$path" <<EOF
---
status: $status
date: 2026-06-13
builds-on: []
superseded-by: $superseded_by
deciders: [maicon]
---

$truth
# Decisão de teste

## Contexto e problema

$body

## Direcionadores da decisão

- teste

## Opções consideradas

### Opção 1 — teste
**Prós:** simples
**Contras:** nenhum

## Decisão

Manter teste.

## Consequências

- teste

## Confirmação

\`\`\`bash
true
\`\`\`
EOF
}

# EARS 1 — greenfield via casa-init continua verde
A="$(mktemp -d)/novo"
python3 "$INIT" "$A" --repo-id app >/dev/null
ck "EARS-1: repo novo criado pelo casa-init passa docs-check" \
   '(cd "$A" && python3 scripts/docs-check)'

# EARS 2 — router sem casa-version falha
mkrepo
grep -v '^casa-version:' "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-2: router sem casa-version falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "casa-version"'

# EARS 3 — ponteiro de contexto quebrado falha
mkrepo
awk '{ if ($0 == "| (nenhum ainda) | — |") print "| `docs/context/INFRA.md` | mexeu em infra |"; else print }' \
    "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-3: Mapa de contexto com arquivo inexistente falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "Mapa de contexto"'

# EARS 4 — Spec accepted com questão aberta falha
mkrepo
spec_doc accepted "[]" "- [ ] decidir borda" "true" "não implementada"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-4: Spec accepted com checkbox aberto falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "questões em aberto"'

# EARS 5 — DoD com placeholder falha
mkrepo
spec_doc accepted "[]" "(nenhuma)" "npm test -- --run <escopo>" "não implementada"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-5: DoD com placeholder falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "placeholder"'

# EARS 6 — implemented-by precisa existir
mkrepo
spec_doc implemented "[nao-existe.py]" "(nenhuma)" "true" "true -> exit 0"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-6: implemented-by inexistente falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "path inexistente"'

# EARS 7 — ADR aceito não aceita emenda substantiva
mkrepo
mkdir -p "$R/docs/adr"
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto original."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git init -q &&
 git config user.email casa@example.invalid && git config user.name CASA &&
 git add . && git commit -q -m base)
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto alterado."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git add . && git commit -q -m bad)
OUT=$(python3 "$CHECK" --root "$R" --check-adr-immutability --base-ref HEAD~1 2>&1); RC=$?
ck "EARS-7: emenda substantiva em ADR aceito falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "corpo alterado"'

# EARS 8 — supersessão com VERDADE ATUAL passa
mkrepo
mkdir -p "$R/docs/adr"
adr_doc "$R/docs/adr/0001-x.md" accepted null "" "Contexto original."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git init -q &&
 git config user.email casa@example.invalid && git config user.name CASA &&
 git add . && git commit -q -m base)
adr_doc "$R/docs/adr/0002-y.md" accepted null "" "Nova decisão."
adr_doc "$R/docs/adr/0001-x.md" superseded ADR-0002 "> VERDADE ATUAL: substituído por ADR-0002" "Contexto original."
(cd "$R" && python3 "$CHECK" --emit-index >/dev/null && git add . && git commit -q -m supersede)
OUT=$(python3 "$CHECK" --root "$R" --check-adr-immutability --base-ref HEAD~1 2>&1); RC=$?
ck "EARS-8: supersessão com VERDADE ATUAL passa" '[ "$RC" -eq 0 ]'

# --- SPEC-0004: capítulo de contexto reconhecido (TESTS) ---

decl_tests() { # injeta o ponteiro do capítulo $1 no Mapa de contexto do router
    awk -v row="| \`$1\` | mexeu em teste |" \
        '{ if ($0 == "| (nenhum ainda) | — |") print row; else print }' \
        "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
    mkdir -p "$R/docs/context"
}

# EARS 9 — TESTS.md declarado com comando canônico passa
mkrepo
decl_tests "docs/context/TESTS.md"
cat > "$R/docs/context/TESTS.md" <<'EOF'
# Testes

## Comandos canônicos

```bash
pytest -q
```
EOF
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-9: TESTS.md declarado com comando canônico passa" '[ "$RC" -eq 0 ]'

# EARS 10 — TESTS.md declarado sem comando falha
mkrepo
decl_tests "docs/context/TESTS.md"
printf '# Testes\n\nRodamos os testes manualmente antes do merge.\n' > "$R/docs/context/TESTS.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-10: TESTS.md declarado sem comando falha" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "capítulo reconhecido"'

# EARS 11 — capítulo genérico (INFRA) sem comando passa: só TESTS é reconhecido
mkrepo
decl_tests "docs/context/INFRA.md"
printf '# Infra\n\nSelf-hosted no Hetzner.\n' > "$R/docs/context/INFRA.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "EARS-11: capítulo genérico sem comando passa (registry fechado)" '[ "$RC" -eq 0 ]'

# --- SPEC-0006: sinalização de manutenção (ADR-0010, ADR-0011) ---

# SPEC-0006/1 — contrato declarado menor que a toolchain → aviso, exit 0
mkrepo
set_version "0.9"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/1: casa-version menor gera aviso e passa" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*atrás da toolchain"'

# SPEC-0006/2 — contrato declarado maior que a toolchain → aviso de toolchain atrás
mkrepo
set_version "99.9"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/2: casa-version maior avisa toolchain atrás" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*rode scripts/casa-init"'

# SPEC-0006/3 — versões iguais → nenhum aviso ADR-0010
mkrepo
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/3: versões iguais não geram aviso" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "ADR-0010"'

# SPEC-0006/4 — casa-version malformado: só o erro de formato, sem aviso por cima
mkrepo
set_version "banana"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/4: versão malformada só gera o erro de formato" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "semver simples" && ! echo "$OUT" | grep -q "ADR-0010"'

# SPEC-0006/5 — backlog em docs/context/ → aviso de localização, exit 0
mkrepo
mkdir -p "$R/docs/context"
printf '# Backlog\n\n- pendência\n' > "$R/docs/context/BACKLOG.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/5: BACKLOG.md em docs/context/ gera aviso" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*mova para docs/BACKLOG.md"'

# SPEC-0006/5b — variação de case também é apontada (listagem, não exists())
mkrepo
mkdir -p "$R/docs/context"
printf '# Backlog\n' > "$R/docs/context/backlog.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/5b: backlog.md (case variante) gera aviso" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "AVISO.*mova para docs/BACKLOG.md"'

# SPEC-0006/6 — docs/BACKLOG.md na raiz de docs é o lugar certo: silêncio
mkrepo
mkdir -p "$R/docs"
printf '# Backlog\n\n- pendência\n' > "$R/docs/BACKLOG.md"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0006/6: docs/BACKLOG.md na raiz não gera aviso" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "ADR-0011"'

# --- ADR-0014: design-ref no vocabulário central ---

# design-ref é campo conhecido (sem aviso) e exportado ao index.json
mkrepo
mkdir -p "$R/docs/specs"
cat > "$R/docs/specs/0001-ui.md" <<EOF
---
status: draft
date: 2026-07-05
builds-on: []
design-ref: docs/design/mock.html
---

# Spec de UI
EOF
python3 "$CHECK" --root "$R" --emit-index >/dev/null
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "ADR-0014: design-ref não gera aviso de vocabulário" \
   '[ "$RC" -eq 0 ] && ! echo "$OUT" | grep -q "fora do vocabulário"'
ck "ADR-0014: design-ref exportado ao index.json" \
   'grep -q "design-ref" "$R/docs/index.json"'

# controle: campo realmente desconhecido segue avisando
mkrepo
mkdir -p "$R/docs/specs"
cat > "$R/docs/specs/0001-x.md" <<EOF
---
status: draft
date: 2026-07-05
campo-inventado: x
---

# Spec com campo estranho
EOF
python3 "$CHECK" --root "$R" --emit-index >/dev/null
OUT=$(python3 "$CHECK" --root "$R" 2>&1)
ck "ADR-0014: campo desconhecido continua avisando" \
   'echo "$OUT" | grep -q "fora do vocabulário"'

# --- SPEC-0009: ratchet monotônico da janela de adoção (ADR-0017) ---

git_base() {
    (cd "$R" && git init -q &&
     git config user.email casa@example.invalid && git config user.name CASA &&
     git add . && git commit -q -m base)
}

git_legacy_base() {
    sed 's/casa-version: 2.0/casa-version: 1.8/' "$R/AGENTS.md" > "$R/AGENTS.tmp" \
        && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
    git_base
    sed 's/casa-version: 1.8/casa-version: 2.0/' "$R/AGENTS.md" > "$R/AGENTS.tmp" \
        && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
}

remove_router_key() {
    key="$1"
    grep -v "^${key}:" "$R/AGENTS.md" > "$R/AGENTS.tmp" && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
}

# Casos 1–3, 7 e 13 — baseline ausente falha; primeira captura, estado igual,
# emissão idempotente e alias depreciado passam.
mkrepo
remove_router_key "casa-standard-ref"
git_legacy_base
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/1: adoção sem baseline falha com comando de captura" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q -- "--emit-baseline"'
OUT=$(python3 "$CHECK" --root "$R" --warn-only --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/13a: primeiro warn-only pós-upgrade falha fechado" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "depreciado" && echo "$OUT" | grep -q -- "--emit-baseline"'
touch "$R/novo-no-bootstrap.orig"
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/2a: primeira captura recusa erro ausente da base" \
   '[ "$RC" -ne 0 ] && [ ! -e "$R/docs/.docs-check-baseline.json" ] && echo "$OUT" | grep -q "teto verificado"'
rm "$R/novo-no-bootstrap.orig"
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/2: primeira captura cria baseline canônica" \
   '[ "$RC" -eq 0 ] && [ -f "$R/docs/.docs-check-baseline.json" ] && grep -q '"'"'"schema": 1'"'"' "$R/docs/.docs-check-baseline.json"'
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/3: conjunto idêntico mantém adoção verde" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "teto mantido"'
PARENT=$(dirname "$R"); NAME=$(basename "$R")
OUT=$(cd "$PARENT" && python3 "$CHECK" --root "$NAME" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/3b: identidade independe da grafia relativa do root" '[ "$RC" -eq 0 ]'
BEFORE=$(git -C "$R" hash-object docs/.docs-check-baseline.json)
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
AFTER=$(git -C "$R" hash-object docs/.docs-check-baseline.json)
ck "SPEC-0009/7: emissão sem mudança é no-op idempotente" \
   '[ "$RC" -eq 0 ] && [ "$BEFORE" = "$AFTER" ] && echo "$OUT" | grep -q "já está no teto"'
OUT=$(python3 "$CHECK" --root "$R" --warn-only --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/13: warn-only é alias seguro e depreciado" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "depreciado"'

# Caso 4 — erro novo falha no gate e não pode ser incorporado pelo emissor.
(cd "$R" && git add . && git commit -q -m baseline)
touch "$R/regressao.orig"
BASELINE_HASH=$(git -C "$R" hash-object docs/.docs-check-baseline.json)
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/4a: erro novo falha e é nomeado" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "regressão" && echo "$OUT" | grep -q "regressao.orig"'
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/4b: emissor recusa aumentar o teto" \
   '[ "$RC" -ne 0 ] && [ "$BASELINE_HASH" = "$(git -C "$R" hash-object docs/.docs-check-baseline.json)" ]'

# Casos 5 e 6 — progresso fica vermelho até a baseline ser apertada no mesmo PR.
mkrepo
remove_router_key "casa-standard-ref"
touch "$R/legado.orig"
git_legacy_base
python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD >/dev/null
(cd "$R" && git add . && git commit -q -m baseline)
rm "$R/legado.orig"
touch "$R/troca.orig"
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/4c: trocar erro entre paths falha como novo + resolvido" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "troca.orig" && echo "$OUT" | grep -q "também foram resolvidos"'
rm "$R/troca.orig"
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/5: erro resolvido pede para apertar o teto" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "boa notícia" && echo "$OUT" | grep -q -- "--emit-baseline"'
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/6a: emissão reduz a baseline" \
   '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "apertada para 1 erro"'
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/6b: teto menor passa contra a baseline maior da base" '[ "$RC" -eq 0 ]'

# Casos 8 e 9 — zero força o fim da janela nos modos de adoção e estrito.
mkrepo
remove_router_key "casa-standard-ref"
git_legacy_base
python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD >/dev/null
(cd "$R" && git add . && git commit -q -m baseline)
sed '/^casa-tier:/a casa-standard-ref: restaurado' "$R/AGENTS.md" > "$R/AGENTS.tmp" \
    && mv "$R/AGENTS.tmp" "$R/AGENTS.md"
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/8a: zero no modo de adoção exige encerrar a janela" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "chegou a zero erros"'
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/8b: emissor recusa baseline vazia" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "zero erros"'
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/9a: gate estrito rejeita baseline residual" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "baseline residual"'
rm "$R/docs/.docs-check-baseline.json"
OUT=$(python3 "$CHECK" --root "$R" 2>&1); RC=$?
ck "SPEC-0009/9b: remover baseline deixa gate estrito verde" '[ "$RC" -eq 0 ]'

# Caso 10 — delete-and-recapture não lava erro novo contra a baseline da base Git.
mkrepo
remove_router_key "casa-standard-ref"
git_legacy_base
python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD >/dev/null
(cd "$R" && git add . && git commit -q -m baseline)
rm "$R/docs/.docs-check-baseline.json"
touch "$R/lavagem.orig"
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/10: apagar e recapturar não aumenta teto da base" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "excedem o teto verificado" && [ ! -f "$R/docs/.docs-check-baseline.json" ]'
BASELINE_COMMIT=$(git -C "$R" rev-parse HEAD)
git -C "$R" show "${BASELINE_COMMIT}:docs/.docs-check-baseline.json" \
    > "$R/docs/.docs-check-baseline.json"
python3 - "$R/docs/.docs-check-baseline.json" <<'PY'
import json, sys
from pathlib import Path

path = Path(sys.argv[1])
payload = json.loads(path.read_text(encoding="utf-8"))
payload["errors"].append("higiene: arquivo proibido na árvore: lavagem.orig")
payload["errors"].sort(key=lambda value: value.encode("utf-8"))
path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref "$BASELINE_COMMIT" 2>&1); RC=$?
ck "SPEC-0009/10b: gate rejeita baseline adulterada que cresceu" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "a baseline cresceu"'

# Caso 10c — depois de encerrada em CASA 2.x, a janela não pode ser reaberta.
mkrepo
git_base
remove_router_key "casa-standard-ref"
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/10c: base CASA 2.x sem baseline impede reabertura" \
   '[ "$RC" -ne 0 ] && [ ! -e "$R/docs/.docs-check-baseline.json" ] && echo "$OUT" | grep -q "não pode ser reaberta"'

# Caso 11 — estados de arquivo inválidos falham sem sobrescrita silenciosa.
mkrepo
git_base
remove_router_key "casa-standard-ref"
mkdir -p "$R/docs"
printf '{}\n' > "$R/docs/.docs-check-baseline.json"
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/11a: baseline com campos inválidos falha especificamente" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "campos da baseline inválidos"'
cat > "$R/docs/.docs-check-baseline.json" <<'EOF'
{
  "schema": 1,
  "diagnostic-format": 1,
  "errors": []
}
EOF
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/11b: baseline vazia manual é estado inválido" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "baseline vazia é inválida"'

# Caso 12 — multiplicidade é preservada; resolver uma ocorrência conta como progresso.
mkrepo
mkdir -p "$R/docs/specs"
cat > "$R/docs/specs/0001-duplicado.md" <<'EOF'
---
status: draft
date: 2026-07-31
builds-on: []
???
???
---

# Diagnóstico duplicado
EOF
python3 "$CHECK" --root "$R" --emit-index >/dev/null 2>&1 || true
git_legacy_base
python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD >/dev/null
(cd "$R" && git add . && git commit -q -m baseline)
COUNT=$(grep -c "sintaxe não suportada" "$R/docs/.docs-check-baseline.json")
awk 'BEGIN { seen=0 } /^\?\?\?$/ { seen++; if (seen == 2) next } { print }' \
    "$R/docs/specs/0001-duplicado.md" > "$R/docs/specs/0001.tmp" \
    && mv "$R/docs/specs/0001.tmp" "$R/docs/specs/0001-duplicado.md"
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/12: duplicata preservada e uma resolução reduz multiplicidade" \
   '[ "$COUNT" -eq 2 ] && [ "$RC" -ne 0 ] && echo "$OUT" | grep -q "1 erro(s) foram resolvidos"'

# Guardas operacionais — base ausente e imutabilidade nunca entram na baseline.
mkrepo
remove_router_key "casa-standard-ref"
printf 'AGENTS.md export-ignore\n' > "$R/.gitattributes"
git_legacy_base
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/snapshot: export-ignore não pode inflar teto inicial" \
   '[ "$RC" -ne 0 ] && [ ! -e "$R/docs/.docs-check-baseline.json" ] && echo "$OUT" | grep -q "diverge da árvore Git"'

mkrepo
remove_router_key "casa-standard-ref"
printf '\n<!-- $Format:%%H$ -->\n' >> "$R/AGENTS.md"
printf 'AGENTS.md export-subst\n' > "$R/.gitattributes"
git_legacy_base
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline --base-ref HEAD 2>&1); RC=$?
ck "SPEC-0009/snapshot: export-subst não pode alterar teto inicial" \
   '[ "$RC" -ne 0 ] && [ ! -e "$R/docs/.docs-check-baseline.json" ] && echo "$OUT" | grep -q "conteúdo materializado"'

mkrepo
remove_router_key "casa-standard-ref"
OUT=$(python3 "$CHECK" --root "$R" --adoption --base-ref refs/heads/inexistente 2>&1); RC=$?
ck "SPEC-0009/base: ref Git irresolvível falha sem traceback" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "não foi possível resolver" && ! echo "$OUT" | grep -q "Traceback"'
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-index 2>&1); RC=$?
ck "SPEC-0009/flags: adoção e emit-index exigem execuções separadas" \
   '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "rode separadamente"'

mkrepo
mkdir -p "$R/docs/adr"
cat > "$R/docs/adr/0001-imutavel.md" <<'EOF'
---
status: accepted
date: 2026-07-31
builds-on: []
superseded-by: null
deciders: [casa]
---

# Imutável

Corpo original.
EOF
python3 "$CHECK" --root "$R" --emit-index >/dev/null
git_legacy_base
git -C "$R" branch base-ref
printf '\nEmenda proibida.\n' >> "$R/docs/adr/0001-imutavel.md"
remove_router_key "casa-standard-ref"
(cd "$R" && git add . && git commit -q -m candidato)
OUT=$(python3 "$CHECK" --root "$R" --adoption --emit-baseline \
      --check-adr-immutability --base-ref base-ref 2>&1); RC=$?
ck "SPEC-0009/imutabilidade: violação não pode ser baselinada" \
   '[ "$RC" -ne 0 ] && [ ! -e "$R/docs/.docs-check-baseline.json" ] && echo "$OUT" | grep -q "teve corpo alterado"'

echo
echo "==== $pass PASS / $fail FAIL ===="
[ "$fail" -eq 0 ]
