#!/usr/bin/env bash
# Scenarios for SPEC-0008 (casa-update-check), using curl/gh stubs. DoD: exit 0.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
UC="$ROOT/scripts/casa-update-check"
GIT_CONFIG_GLOBAL=/dev/null; GIT_CONFIG_NOSYSTEM=1; export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM
pass=0; fail=0
ck() { if eval "$2" >/dev/null 2>&1; then echo "PASS: $1"; pass=$((pass+1)); else echo "FAIL: $1"; fail=$((fail+1)); fi; }

STUB="$(mktemp -d)"
cat > "$STUB/gh" <<'EOF'
#!/bin/sh
echo "gh $*" >> "$GH_LOG"
echo "cwd=$(pwd)" >> "$GH_LOG"
case "$1 $2" in
  "issue list") [ "${GH_LIST_FAIL:-0}" = "1" ] && exit 1; cat "${GH_LIST:-/dev/null}" 2>/dev/null ;;
esac
exit 0
EOF
cat > "$STUB/curl" <<'EOF'
#!/bin/sh
[ "${CURL_FAIL:-0}" = "1" ] && exit 22
cat "$CURL_FILE"
EOF
chmod +x "$STUB/gh" "$STUB/curl"
PATH="$STUB:$PATH"; export PATH

CHANGELOG="$STUB/changelog.md"
printf '# Changelog\n\n## CASA 9.9 — 2099-01-01\n\n- notes\n\n## CASA 9.8 — 2098-01-01\n' > "$CHANGELOG"
CASA_SOURCE_URL="stub://changelog"; CURL_FILE="$CHANGELOG"
export CASA_SOURCE_URL CURL_FILE

mkrepo() {
    R="$(mktemp -d)"
    printf '# AGENTS.md\n\n```yaml\ncasa-repo-id: t\ncasa-tier: T1\ncasa-version: %s\ncasa-standard-ref: x\n```\n' "$1" > "$R/AGENTS.md"
    GH_LOG="$R/gh.log"; : > "$GH_LOG"; export GH_LOG
    GH_LIST="/dev/null"; export GH_LIST
}

# SPEC-0008/1 — declared behind upstream → creates issue with both versions
mkrepo 1.1
OUT=$(sh "$UC" "$R" 2>&1); RC=$?
ck "SPEC-0008/1: behind upstream creates issue"    '[ "$RC" -eq 0 ] && grep -q "issue create" "$GH_LOG"'
ck "SPEC-0008/1: title contains both versions"     'grep -q "declared 1.1, upstream 9.9" "$GH_LOG"'

# SPEC-0008/2 — open issue already exists → edits in place, never duplicates
mkrepo 1.1
printf '42\n' > "$STUB/list"; GH_LIST="$STUB/list"; export GH_LIST
sh "$UC" "$R" >/dev/null 2>&1
ck "SPEC-0008/2: existing issue edited"            'grep -q "issue edit 42" "$GH_LOG"'
ck "SPEC-0008/2: no duplicate issue created"       '! grep -q "issue create" "$GH_LOG"'

# SPEC-0008/3 — caught up → closes open notice
mkrepo 9.9
printf '7\n' > "$STUB/list"; GH_LIST="$STUB/list"; export GH_LIST
OUT=$(sh "$UC" "$R" 2>&1); RC=$?
ck "SPEC-0008/3: caught up closes open notice"     '[ "$RC" -eq 0 ] && grep -q "issue close 7" "$GH_LOG"'
ck "SPEC-0008/3: and creates no new issue"         '! grep -q "issue create" "$GH_LOG"'

# SPEC-0008/3b — caught up with no open notice → touches no issues
mkrepo 9.9
OUT=$(sh "$UC" "$R" 2>&1); RC=$?
ck "SPEC-0008/3b: caught up without notice touches no issues" '[ "$RC" -eq 0 ] && ! grep -qE "issue (create|edit|close)" "$GH_LOG"'

# SPEC-0008/4 — network failure → exits 0, touches no issues, logs clearly
mkrepo 1.1
OUT=$(CURL_FAIL=1 sh "$UC" "$R" 2>&1); RC=$?
ck "SPEC-0008/4: network failure exits 0"          '[ "$RC" -eq 0 ]'
ck "SPEC-0008/4: logs and touches no issues"       'echo "$OUT" | grep -q "could not read" && ! grep -q "issue" "$GH_LOG"'

# SPEC-0008/5 — unreadable casa-version → exits 0
R="$(mktemp -d)"; printf '# AGENTS.md\nno yaml\n' > "$R/AGENTS.md"
GH_LOG="$R/gh.log"; : > "$GH_LOG"; export GH_LOG
OUT=$(sh "$UC" "$R" 2>&1); RC=$?
ck "SPEC-0008/5: unreadable router exits 0 with log" '[ "$RC" -eq 0 ] && echo "$OUT" | grep -q "unreadable"'

# SPEC-0008/6 — declared ahead of upstream → treated as up to date
mkrepo 99.9
OUT=$(sh "$UC" "$R" 2>&1); RC=$?
ck "SPEC-0008/6: ahead of upstream creates no issue" '[ "$RC" -eq 0 ] && ! grep -q "issue create" "$GH_LOG"'

# SPEC-0009/20 — failed gh query is NOT "zero open issues": never creates duplicate
mkrepo 1.1
GH_LIST_FAIL=1; export GH_LIST_FAIL
OUT=$(sh "$UC" "$R" 2>&1); RC=$?
ck "SPEC-0009/20: failed query creates no issue"   '[ "$RC" -eq 0 ] && ! grep -q "issue create" "$GH_LOG"'
ck "SPEC-0009/20: failed query logs reason"        'echo "$OUT" | grep -q "could not query"'
unset GH_LIST_FAIL

# SPEC-0009/20b — gh runs inside the inspected root, not caller's CWD
mkrepo 1.1
OUT=$(cd "$(mktemp -d)" && sh "$UC" "$R" 2>&1)
ck "SPEC-0009/20b: gh operates in target root"     'grep -q "^cwd=$R$" "$GH_LOG"'

echo
echo "==== $pass PASS / $fail FAIL ===="
[ "$fail" -eq 0 ]
