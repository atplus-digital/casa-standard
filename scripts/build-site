    canonical_url = base_url.rstrip("/") + "/" + page_url.lstrip("/") if base_url else ""
    canonical_tag = (
        f'\n  <link rel="canonical" href="{html.escape(canonical_url, quote=True)}">'
        f'\n  <meta property="og:url" content="{html.escape(canonical_url, quote=True)}">'
        if canonical_url
        else ""
    )

    def nav_attr(key: str) -> str:
        return ' aria-current="page"' if active_nav == key else ""

    return f"""<!DOCTYPE html>
<html lang="pt-BR" data-site-root="{rel_root}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
