#!/usr/bin/env python3
"""build-site — Compiles the bilingual CASA Standard static site from canonical sources.

Zero external dependencies (Python 3 stdlib only). Reads directly:
  - Canonical English: STANDARD.md, README.md, CHANGELOG.md, docs/templates/skills/*/SKILL.md
  - Canonical graph & records: docs/index.json, docs/adr/*.md, docs/specs/*.md
  - Presentation i18n overlays (ADR-0019 / SPEC-0012):
      site/i18n/en/docs.json
      site/i18n/pt/{STANDARD.md,CHANGELOG.md,pillars.json,skills.json,docs.json}
  - Shared assets: site/{style.css,app.js,favicon.svg}

Emits deterministic static HTML with strictly relative internal links (compatible with
GitHub Pages subpath hosting):
  - English (`lang="en"`): / , /standard/ , /graph/ (plus /grafo/ redirect), /skills/ , /changelog/ , /{adr,specs}/<stem>/
  - Portuguese (`lang="pt-BR"`): /pt/ , /pt/standard/ , /pt/grafo/ , /pt/skills/ , /pt/changelog/ , /pt/{adr,specs}/<stem>/
"""

from __future__ import annotations

import argparse
import html
import json
import re
import shutil
import sys
import unicodedata
from pathlib import Path
from typing import Any

GITHUB_REPO_URL = "https://github.com/atplus-digital/casa-standard"
SKILL_CYCLE_ORDER = [
    "casa-explore",
    "casa-propose",
    "casa-apply",
    "casa-verify",
    "casa-close",
]

PT_DOC_MARKERS = (
    "## Contexto e problema",
    "## Direcionadores",
    "## Decisão",
    "## Confirmação",
    "## Objetivo",
    "## Casos de borda",
    "## Questões em aberto",
    "## Verificação",
)

HTML_COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)
FENCE_OPEN_RE = re.compile(r"^(\s*)(`{3,}|~{3,})([^\n`]*)$")
HEADING_RE = re.compile(r"^(#{1,4})\s+(.+?)\s*$")
HR_RE = re.compile(r"^\s*(?:---+|\*\*\*+)\s*$")
BLOCKQUOTE_RE = re.compile(r"^\s*>\s?(.*)$")
TABLE_SEP_RE = re.compile(r"^\s*\|[\s:\-|]+\|\s*$")
LIST_ITEM_RE = re.compile(r"^(\s*)([-*]|\d+\.)\s+(.+?)\s*$")
DOC_REF_RE = re.compile(r"(?:casa-standard:)?\b(ADR-\d{4}|SPEC-\d{4})\b")
INLINE_CODE_RE = re.compile(r"(`+)(.+?)\1")
MD_LINK_RE = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")
BOLD_RE = re.compile(r"\*\*(.+?)\*\*")
ITALIC_RE = re.compile(r"(?<!\*)\*(?!\s|\*)(.+?)(?<!\s|\*)\*(?!\*)")
CHANGELOG_VER_RE = re.compile(r"^##\s+CASA\s+([0-9]+\.[0-9]+(?:\.[0-9]+)?)\b", re.MULTILINE)


def slugify(text: str) -> str:
    norm = unicodedata.normalize("NFKD", text)
    ascii_text = norm.encode("ascii", "ignore").decode("ascii").lower()
    slug = re.sub(r"[^a-z0-9]+", "-", ascii_text).strip("-")
    return slug or "section"


def standard_heading_id(raw_heading: str, used: set[str]) -> str:
    clean = re.sub(r"`([^`]+)`", r"\1", raw_heading).strip()
    lower = clean.lower()
    m_sec = re.match(r"^(\d+(?:\.\d+)*)\.?\s+", clean)
    if m_sec:
        base = "sec-" + m_sec.group(1).replace(".", "-")
    elif lower.startswith(("appendix a", "apêndice a", "apendice a")):
        base = "appendix-a"
    elif lower in ("package contents", "anexos deste pacote"):
        base = "package-contents"
    else:
        base = slugify(clean)
    candidate = base
    idx = 2
    while candidate in used:
        candidate = f"{base}-{idx}"
        idx += 1
    used.add(candidate)
    return candidate


def strip_comments_outside_fences(md_text: str) -> str:
    lines = md_text.splitlines()
    out: list[str] = []
    buf: list[str] = []
    in_fence = False
    fence_char = ""
    fence_len = 0

    def flush_prose() -> None:
        if not buf:
            return
        joined = "\n".join(buf)
        cleaned = HTML_COMMENT_RE.sub("", joined)
        out.extend(cleaned.split("\n"))
        buf.clear()

    for line in lines:
        if not in_fence:
            m = FENCE_OPEN_RE.match(line)
            if m and "\u200b" not in line[: len(m.group(1)) + len(m.group(2))]:
                flush_prose()
                in_fence = True
                fence_char = m.group(2)[0]
                fence_len = len(m.group(2))
                out.append(line)
            else:
                buf.append(line)
        else:
            out.append(line)
            stripped = line.strip()
            if (
                not line.lstrip().startswith("\u200b")
                and stripped
                and all(ch == fence_char for ch in stripped)
                and len(stripped) >= fence_len
            ):
                in_fence = False
    flush_prose()
    return "\n".join(out)


def parse_frontmatter(md_text: str) -> tuple[dict[str, Any], str]:
    lines = md_text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}, md_text
    end_idx = None
    for idx in range(1, len(lines)):
        if lines[idx].strip() == "---":
            end_idx = idx
            break
    if end_idx is None:
        return {}, md_text

    fm: dict[str, Any] = {}
    current_list_key: str | None = None
    for raw in lines[1:end_idx]:
        line = re.sub(r"\s+#.*$", "", raw).strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("- ") and current_list_key is not None:
            item = line[2:].strip().strip("\"'")
            fm[current_list_key].append(item)
            continue
        current_list_key = None
        if ":" in line:
            key, val = line.split(":", 1)
            key = key.strip()
            val = val.strip()
            if not val:
                fm[key] = []
                current_list_key = key
            elif val.startswith("[") and val.endswith("]"):
                inner = val[1:-1].strip()
                fm[key] = (
                    [x.strip().strip("\"'") for x in inner.split(",") if x.strip()]
                    if inner
                    else []
                )
            elif val == "null":
                fm[key] = None
            else:
                fm[key] = val.strip("\"'")
    body = "\n".join(lines[end_idx + 1 :])
    return fm, body


def extract_truth_callout(body: str) -> tuple[str | None, str]:
    cleaned = strip_comments_outside_fences(body)
    lines = cleaned.splitlines()
    idx = 0
    while idx < len(lines) and not lines[idx].strip():
        idx += 1
    quote_lines: list[str] = []
    start = idx
    while idx < len(lines):
        m = BLOCKQUOTE_RE.match(lines[idx])
        if m:
            quote_lines.append(m.group(1).strip())
            idx += 1
        else:
            break
    joined = " ".join(quote_lines).strip()
    if quote_lines and ("CURRENT TRUTH" in joined or "VERDADE ATUAL" in joined):
        remaining = "\n".join(lines[:start] + lines[idx:])
        return joined, remaining
    return None, body


def detect_source_lang(body: str, truth_callout: str | None) -> str:
    if truth_callout and "VERDADE ATUAL" in truth_callout:
        return "pt"
    if re.search(
        r"^##\s+(?:Contexto e problema|Direcionadores|Decisão|Confirmação|Objetivo|Casos de borda|Questões em aberto|Verificação)\b",
        body,
        re.MULTILINE,
    ):
        return "pt"
    return "en"


def split_table_row(line: str) -> list[str]:
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|"):
        s = s[:-1]
    cells: list[str] = []
    cur: list[str] = []
    in_code = False
    i = 0
    while i < len(s):
        ch = s[i]
        if ch == "`":
            in_code = not in_code
            cur.append(ch)
        elif ch == "\\" and i + 1 < len(s) and s[i + 1] == "|":
            cur.append("|")
            i += 1
        elif ch == "|" and not in_code:
            cells.append("".join(cur).strip())
            cur = []
        else:
            cur.append(ch)
        i += 1
    cells.append("".join(cur).strip())
    return cells


def plain_text_from_md(md_text: str, max_len: int = 220) -> str:
    cleaned = strip_comments_outside_fences(md_text)
    cleaned = re.sub(r"```.*?```", " ", cleaned, flags=re.DOTALL)
    cleaned = re.sub(r"^#{1,6}\s+", "", cleaned, flags=re.MULTILINE)
    cleaned = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", cleaned)
    cleaned = re.sub(r"[`*_>|]", " ", cleaned)
    cleaned = re.sub(r"\s+", " ", cleaned).strip()
    if len(cleaned) <= max_len:
        return cleaned
    return cleaned[: max_len - 1].rstrip() + "…"


class MarkdownRenderer:
    def __init__(
        self,
        doc_urls: dict[str, str],
        lang_root: str,
        page_slug: str,
        *,
        locale: str = "en",
        current_doc_id: str | None = None,
    ) -> None:
        self.doc_urls = doc_urls
        self.lang_root = lang_root
        self.page_slug = page_slug
        self.locale = locale
        self.current_doc_id = current_doc_id
        self.code_counter = 0

    def render_inline(self, text: str, allow_autolink: bool = True) -> str:
        code_tokens: list[str] = []
        link_tokens: list[str] = []

        def save_code(match: re.Match[str]) -> str:
            idx = len(code_tokens)
            code_tokens.append(f"<code>{html.escape(match.group(2), quote=False)}</code>")
            return f"\x00CODE{idx}\x00"

        work = INLINE_CODE_RE.sub(save_code, text)

        def save_link(match: re.Match[str]) -> str:
            label_raw = match.group(1)
            href_raw = match.group(2).strip()
            label_html = self.render_inline(label_raw, allow_autolink=False)
            resolved_href = self._resolve_md_href(href_raw)
            ext_attrs = (
                ' target="_blank" rel="noopener noreferrer"'
                if resolved_href.startswith(("http://", "https://"))
                else ""
            )
            idx = len(link_tokens)
            link_tokens.append(
                f'<a href="{html.escape(resolved_href, quote=True)}"{ext_attrs}>{label_html}</a>'
            )
            return f"\x00LINK{idx}\x00"

        work = MD_LINK_RE.sub(save_link, work)
        work = html.escape(work, quote=False)
        work = BOLD_RE.sub(r"<strong>\1</strong>", work)
        work = ITALIC_RE.sub(r"<em>\1</em>", work)

        if allow_autolink:
            def link_doc_ref(match: re.Match[str]) -> str:
                full = match.group(0)
                doc_id = match.group(1)
                if doc_id in self.doc_urls and doc_id != self.current_doc_id:
                    href = f"{self.lang_root}{self.doc_urls[doc_id]}"
                    return f'<a class="doc-inline-ref" href="{html.escape(href, quote=True)}">{full}</a>'
                return full

            work = DOC_REF_RE.sub(link_doc_ref, work)

        for idx, val in enumerate(link_tokens):
            work = work.replace(f"\x00LINK{idx}\x00", val)
        for idx, val in enumerate(code_tokens):
            work = work.replace(f"\x00CODE{idx}\x00", val)
        return work

    def _resolve_md_href(self, href: str) -> str:
        if href in ("STANDARD.md", "./STANDARD.md"):
            return f"{self.lang_root}standard/"
        if href in ("CHANGELOG.md", "./CHANGELOG.md"):
            return f"{self.lang_root}changelog/"
        if href.startswith("https://github.com/atplus-digital/casa-standard/blob/main/STANDARD.md"):
            return f"{self.lang_root}standard/"
        if href in ("docs/templates/", "scripts/docs-check", "LICENSE", "CONTRIBUTING.md"):
            kind = "tree" if href.endswith("/") else "blob"
            return f"{GITHUB_REPO_URL}/{kind}/main/{href.rstrip('/')}"
        return href

    def render(
        self,
        md_text: str,
        *,
        skip_first_h1: bool = False,
        heading_offset: int = 0,
        standard_ids: bool = False,
    ) -> tuple[str, list[dict[str, Any]]]:
        cleaned = strip_comments_outside_fences(md_text)
        lines = cleaned.splitlines()
        out: list[str] = []
        toc: list[dict[str, Any]] = []
        used_ids: set[str] = set()
        skipped_h1 = False
        i = 0
        n = len(lines)
        default_fence_lang = "texto" if self.locale == "pt" else "text"
        copy_label = "Copiar" if self.locale == "pt" else "Copy"
        anchor_aria = "Link para esta seção" if self.locale == "pt" else "Link to this section"

        while i < n:
            line = lines[i]
            if not line.strip():
                i += 1
                continue

            # Fenced code block
            m_fence = FENCE_OPEN_RE.match(line)
            if m_fence and "\u200b" not in line[: len(m_fence.group(1)) + len(m_fence.group(2))]:
                fence_char = m_fence.group(2)[0]
                fence_len = len(m_fence.group(2))
                lang = m_fence.group(3).strip() or default_fence_lang
                i += 1
                code_lines: list[str] = []
                while i < n:
                    cur = lines[i]
                    stripped = cur.strip()
                    if (
                        not cur.lstrip().startswith("\u200b")
                        and stripped
                        and all(ch == fence_char for ch in stripped)
                        and len(stripped) >= fence_len
                    ):
                        i += 1
                        break
                    code_lines.append(cur.replace("\u200b```", "```"))
                    i += 1
                self.code_counter += 1
                code_id = f"code-{self.page_slug}-{self.code_counter}"
                escaped_code = html.escape("\n".join(code_lines), quote=False)
                out.append(
                    f'<div class="code-frame">'
                    f'<div class="code-frame-bar">'
                    f"<span>{html.escape(lang)}</span>"
                    f'<button type="button" class="copy-btn" data-copy-target="{code_id}">{copy_label}</button>'
                    f"</div>"
                    f'<pre><code id="{code_id}">{escaped_code}</code></pre>'
                    f"</div>"
                )
                continue

            # Horizontal rule
            if HR_RE.match(line):
                out.append("<hr>")
                i += 1
                continue

            # Heading
            m_head = HEADING_RE.match(line)
            if m_head:
                raw_level = len(m_head.group(1))
                raw_title = m_head.group(2).strip()
                if raw_level == 1 and skip_first_h1 and not skipped_h1:
                    skipped_h1 = True
                    i += 1
                    continue
                level = min(4, raw_level + heading_offset)
                if raw_level == 1 and skip_first_h1:
                    level = max(2, level)
                if level == 1:
                    out.append(f"<h1>{self.render_inline(raw_title)}</h1>")
                else:
                    if standard_ids:
                        hid = standard_heading_id(raw_title, used_ids)
                    else:
                        base = slugify(re.sub(r"`([^`]+)`", r"\1", raw_title))
                        hid = base
                        c = 2
                        while hid in used_ids:
                            hid = f"{base}-{c}"
                            c += 1
                        used_ids.add(hid)
                    title_html = self.render_inline(raw_title)
                    anchor = (
                        f'<a class="heading-anchor" href="#{hid}" '
                        f'aria-label="{anchor_aria}">#</a>'
                    )
                    out.append(f'<h{level} id="{hid}">{title_html}{anchor}</h{level}>')
                    if level in (2, 3):
                        toc_label = re.sub(r"`([^`]+)`", r"\1", raw_title)
                        toc_label = re.sub(r"\*\*(.+?)\*\*", r"\1", toc_label)
                        toc.append({"id": hid, "level": level, "label": toc_label})
                i += 1
                continue

            # Blockquote
            if BLOCKQUOTE_RE.match(line):
                bq_lines: list[str] = []
                while i < n:
                    m_bq = BLOCKQUOTE_RE.match(lines[i])
                    if not m_bq:
                        break
                    bq_lines.append(m_bq.group(1))
                    i += 1
                inner_html, _ = self.render("\n".join(bq_lines), heading_offset=1)
                out.append(f"<blockquote>{inner_html}</blockquote>")
                continue

            # GFM Table
            if (
                line.lstrip().startswith("|")
                and i + 1 < n
                and TABLE_SEP_RE.match(lines[i + 1])
            ):
                headers = split_table_row(lines[i])
                i += 2
                rows: list[list[str]] = []
                while i < n and lines[i].lstrip().startswith("|"):
                    rows.append(split_table_row(lines[i]))
                    i += 1
                th_html = "".join(f"<th>{self.render_inline(h)}</th>" for h in headers)
                body_rows: list[str] = []
                for r in rows:
                    padded = r + [""] * max(0, len(headers) - len(r))
                    tds = "".join(
                        f"<td>{self.render_inline(cell)}</td>"
                        for cell in padded[: len(headers)]
                    )
                    body_rows.append(f"<tr>{tds}</tr>")
                body_joined = "".join(body_rows)
                out.append(
                    f'<div class="table-wrap"><table>'
                    f"<thead><tr>{th_html}</tr></thead>"
                    f"<tbody>{body_joined}</tbody>"
                    f"</table></div>"
                )
                continue

            # Lists (supports nested 2-level lists and multiline item continuations)
            m_list = LIST_ITEM_RE.match(line)
            if m_list:
                list_html, i = self._parse_list(lines, i, len(m_list.group(1)))
                out.append(list_html)
                continue

            # Paragraph
            para_lines: list[str] = []
            while i < n:
                cur = lines[i]
                if (
                    not cur.strip()
                    or HR_RE.match(cur)
                    or HEADING_RE.match(cur)
                    or BLOCKQUOTE_RE.match(cur)
                    or LIST_ITEM_RE.match(cur)
                    or (
                        FENCE_OPEN_RE.match(cur)
                        and not cur.lstrip().startswith("\u200b")
                    )
                    or (
                        cur.lstrip().startswith("|")
                        and i + 1 < n
                        and TABLE_SEP_RE.match(lines[i + 1])
                    )
                    or (
                        para_lines
                        and cur.lstrip().startswith(
                            ("**Pros:**", "**Cons:**", "**Prós:**", "**Contras:**")
                        )
                    )
                ):
                    break
                para_lines.append(cur.strip())
                i += 1
            if para_lines:
                joined_para = self.render_inline(" ".join(para_lines))
                out.append(f"<p>{joined_para}</p>")

        return "\n".join(out), toc

    def _parse_list(
        self, lines: list[str], start_idx: int, base_indent: int
    ) -> tuple[str, int]:
        n = len(lines)
        first_m = LIST_ITEM_RE.match(lines[start_idx])
        assert first_m is not None
        ordered = first_m.group(2).endswith(".")
        tag = "ol" if ordered else "ul"
        items_html: list[str] = []
        i = start_idx

        while i < n:
            if not lines[i].strip():
                j = i + 1
                while j < n and not lines[j].strip():
                    j += 1
                if j >= n:
                    i = j
                    break
                m_next = LIST_ITEM_RE.match(lines[j])
                if m_next and len(m_next.group(1)) >= base_indent:
                    i = j
                else:
                    break

            m_item = LIST_ITEM_RE.match(lines[i])
            if not m_item:
                break
            indent = len(m_item.group(1))
            item_ordered = m_item.group(2).endswith(".")
            if indent < base_indent:
                break
            if indent == base_indent and item_ordered != ordered:
                break
            if indent > base_indent:
                sub_html, i = self._parse_list(lines, i, indent)
                if items_html:
                    items_html[-1] = items_html[-1][:-5] + sub_html + "</li>"
                continue

            text_parts = [m_item.group(3).strip()]
            subblocks: list[str] = []
            i += 1
            while i < n:
                cur = lines[i]
                if not cur.strip():
                    break
                if HR_RE.match(cur) or HEADING_RE.match(cur) or FENCE_OPEN_RE.match(cur):
                    break
                m_sub = LIST_ITEM_RE.match(cur)
                if m_sub:
                    sub_indent = len(m_sub.group(1))
                    if sub_indent > base_indent:
                        sub_html, i = self._parse_list(lines, i, sub_indent)
                        subblocks.append(sub_html)
                        continue
                    break
                lead_spaces = len(cur) - len(cur.lstrip(" "))
                if lead_spaces > base_indent:
                    text_parts.append(cur.strip())
                    i += 1
                else:
                    break

            item_inline = self.render_inline(" ".join(text_parts))
            if item_inline.startswith("[ ] "):
                item_inline = "☐ " + item_inline[4:]
            elif item_inline.lower().startswith("[x] "):
                item_inline = "☑ " + item_inline[4:]
            sub_joined = "".join(subblocks)
            items_html.append(f"<li>{item_inline}{sub_joined}</li>")

        all_items = "".join(items_html)
        return f"<{tag}>{all_items}</{tag}>", i


def status_badge(status: str) -> str:
    s = (status or "unknown").lower()
    if s in ("accepted", "implemented"):
        cls = "badge-ok"
    elif s in ("proposed", "draft"):
        cls = "badge-warn"
    else:
        cls = "badge-muted"
    return f'<span class="badge {cls}">{html.escape(s)}</span>'


def parse_standard_metadata(standard_md: str, locale: str = "en") -> dict[str, str]:
    m_ver = re.search(
        r"\*\*(?:CASA Version|Versão CASA):\*\*\s*([0-9]+\.[0-9]+(?:\.[0-9]+)?)",
        standard_md,
    )
    m_status = re.search(r"\*\*Status:\*\*\s*([^·\n]+)", standard_md)
    m_maint = re.search(r"\*\*(?:Maintainer|Mantenedor):\*\*\s*([^\n]+)", standard_md)
    m_crit = re.search(
        r"(?:Design criterion|Critério de design):\s*\*\*(.+?)\*\*", standard_md
    )
    default_crit = (
        "complexidade sustentada por automação é barata; complexidade sustentada por disciplina humana apodrece."
        if locale == "pt"
        else "complexity sustained by automation is cheap; complexity sustained by human discipline rots."
    )
    return {
        "version": m_ver.group(1).strip() if m_ver else "1.0",
        "status": m_status.group(1).strip() if m_status else "accepted",
        "maintainer": m_maint.group(1).strip() if m_maint else "atplus-digital",
        "criterion": m_crit.group(1).strip() if m_crit else default_crit,
    }


def load_canonical_docs(root: Path) -> list[dict[str, Any]]:
    index_path = root / "docs" / "index.json"
    raw_items: list[dict[str, Any]] = json.loads(index_path.read_text(encoding="utf-8"))
    docs: list[dict[str, Any]] = []

    for entry in raw_items:
        rel_path = entry["path"]
        file_path = root / rel_path
        stem = Path(rel_path).stem
        layer = entry["layer"]
        url_rel = f"{layer}/{stem}/"

        fm: dict[str, Any] = {}
        body = ""
        title = entry.get("title", entry["id"])
        truth_callout: str | None = None
        source_lang = "en"

        if file_path.is_file():
            raw_md = file_path.read_text(encoding="utf-8")
            fm, body = parse_frontmatter(raw_md)
            truth_callout, body_without_truth = extract_truth_callout(body)
            body = body_without_truth
            source_lang = detect_source_lang(body, truth_callout)
            cleaned_for_h1 = strip_comments_outside_fences(body)
            m_h1 = re.search(r"^#\s+(.+?)\s*$", cleaned_for_h1, re.MULTILINE)
            if m_h1:
                title = m_h1.group(1).strip()

        builds_on = fm.get("builds-on", entry.get("builds-on", []))
        if not isinstance(builds_on, list):
            builds_on = [builds_on] if builds_on else []
        impl_by = fm.get("implemented-by", entry.get("implemented-by", []))
        if not isinstance(impl_by, list):
            impl_by = [impl_by] if impl_by else []
        deciders = fm.get("deciders", [])
        if not isinstance(deciders, list):
            deciders = [deciders] if deciders else []

        docs.append(
            {
                "id": entry["id"],
                "path": rel_path,
                "stem": stem,
                "layer": layer,
                "url": url_rel,
                "title": title,
                "status": str(fm.get("status") or entry.get("status") or "draft"),
                "date": str(fm.get("date") or ""),
                "builds_on": [str(x) for x in builds_on if x],
                "superseded_by": fm.get("superseded-by", entry.get("superseded-by")),
                "implemented_by": [str(x) for x in impl_by if x],
                "deciders": [str(x) for x in deciders if x],
                "design_ref": fm.get("design-ref") or entry.get("design-ref"),
                "truth_callout": truth_callout,
                "body": body,
                "source_lang": source_lang,
                "is_translated": False,
            }
        )

    docs.sort(key=lambda d: (0 if d["layer"] == "adr" else 1, d["id"]))
    by_id = {d["id"]: d for d in docs}
    for d in docs:
        d["cited_by"] = []
        d["supersedes"] = []

    for d in docs:
        for parent_id in d["builds_on"]:
            if parent_id in by_id and d["id"] not in by_id[parent_id]["cited_by"]:
                by_id[parent_id]["cited_by"].append(d["id"])
        sup_target = d.get("superseded_by")
        if sup_target and sup_target in by_id:
            if d["id"] not in by_id[sup_target]["supersedes"]:
                by_id[sup_target]["supersedes"].append(d["id"])

    return docs


def localize_docs(
    canonical_docs: list[dict[str, Any]],
    locale: str,
    en_docs_i18n: dict[str, Any],
    pt_docs_i18n: dict[str, Any],
) -> list[dict[str, Any]]:
    localized: list[dict[str, Any]] = []
    for d in canonical_docs:
        item = dict(d)
        src_lang = d["source_lang"]
        if locale == "en":
            if src_lang == "pt":
                if d["id"] not in en_docs_i18n:
                    raise ValueError(
                        f"Missing English translation in site/i18n/en/docs.json for {d['id']} ({d['path']})"
                    )
                tr = en_docs_i18n[d["id"]]
                item["title"] = str(tr["title"])
                item["truth_callout"] = tr.get("truth_callout")
                item["body"] = str(tr["body"])
                item["is_translated"] = True
            else:
                item["is_translated"] = False
        else:
            if src_lang == "en":
                if d["id"] not in pt_docs_i18n:
                    raise ValueError(
                        f"Missing Portuguese translation in site/i18n/pt/docs.json for {d['id']} ({d['path']})"
                    )
                tr = pt_docs_i18n[d["id"]]
                item["title"] = str(tr["title"])
                item["truth_callout"] = tr.get("truth_callout")
                item["body"] = str(tr["body"])
                item["is_translated"] = True
            else:
                item["is_translated"] = False
        localized.append(item)
    return localized


def load_skills(root: Path) -> list[dict[str, Any]]:
    skills_root = root / "docs" / "templates" / "skills"
    found: dict[str, dict[str, Any]] = {}
    if skills_root.is_dir():
        for skill_file in sorted(skills_root.glob("*/SKILL.md")):
            raw = skill_file.read_text(encoding="utf-8")
            fm, body = parse_frontmatter(raw)
            name = str(fm.get("name") or skill_file.parent.name)
            desc = str(fm.get("description") or "")
            m_h1 = re.search(r"^#\s+(.+?)\s*$", body, re.MULTILINE)
            h1 = m_h1.group(1).strip() if m_h1 else name
            found[name] = {
                "name": name,
                "title": h1,
                "description": desc,
                "desc_chars": len(desc),
                "path": f"docs/templates/skills/{skill_file.parent.name}/SKILL.md",
                "body": body,
            }
    ordered: list[dict[str, Any]] = []
    for key in SKILL_CYCLE_ORDER:
        if key in found:
            ordered.append(found.pop(key))
    for key in sorted(found):
        ordered.append(found[key])
    return ordered


def load_pt_skills(
    en_skills: list[dict[str, Any]], pt_skills_map: dict[str, Any]
) -> list[dict[str, Any]]:
    pt_skills: list[dict[str, Any]] = []
    for sk in en_skills:
        name = sk["name"]
        if name not in pt_skills_map:
            raise ValueError(
                f"Missing skill translation in site/i18n/pt/skills.json for {name}"
            )
        entry = pt_skills_map[name]
        desc = str(entry.get("description") or "").strip()
        body = str(entry.get("body") or "")
        if not desc or not body.strip():
            raise ValueError(
                f"Incomplete skill translation in site/i18n/pt/skills.json for {name}"
            )
        m_h1 = re.search(r"^#\s+(.+?)\s*$", body, re.MULTILINE)
        h1 = m_h1.group(1).strip() if m_h1 else sk["title"]
        pt_skills.append(
            {
                "name": name,
                "title": h1,
                "description": desc,
                "desc_chars": len(desc),
                "path": sk["path"],
                "body": body,
            }
        )
    return pt_skills


def build_causal_svg(docs: list[dict[str, Any]], lang_root: str, locale: str) -> str:
    by_id = {d["id"]: d for d in docs}
    memo: dict[str, int] = {}

    def get_rank(did: str, stack: set[str]) -> int:
        if did in memo:
            return memo[did]
        if did in stack:
            return 0
        stack.add(did)
        parents = [p for p in by_id[did]["builds_on"] if p in by_id and p != did]
        r = 0 if not parents else 1 + max(get_rank(p, stack) for p in parents)
        stack.remove(did)
        memo[did] = r
        return r

    columns: dict[int, list[dict[str, Any]]] = {}
    for d in docs:
        r = get_rank(d["id"], set())
        columns.setdefault(r, []).append(d)

    num_cols = max(columns.keys(), default=0) + 1
    max_rows = max((len(v) for v in columns.values()), default=1)

    node_w = 136
    node_h = 46
    col_gap = 166
    row_gap = 60
    pad_x = 20
    pad_y = 22

    svg_w = max(780, pad_x * 2 + (num_cols - 1) * col_gap + node_w)
    svg_h = max(240, pad_y * 2 + max_rows * row_gap)

    coords: dict[str, tuple[float, float]] = {}
    for col_idx in sorted(columns):
        col_docs = columns[col_idx]
        total_h = len(col_docs) * node_h + max(0, len(col_docs) - 1) * (row_gap - node_h)
        start_y = (svg_h - total_h) / 2.0
        x = float(pad_x + col_idx * col_gap)
        for row_idx, d in enumerate(col_docs):
            y = start_y + row_idx * row_gap
            coords[d["id"]] = (x, y)

    edge_elems: list[str] = []
    for d in docs:
        x2, y2 = coords[d["id"]]
        cy2 = y2 + node_h / 2.0
        doc_id = d["id"]
        for parent_id in d["builds_on"]:
            if parent_id not in coords:
                continue
            x1, y1 = coords[parent_id]
            sx = x1 + node_w
            sy = y1 + node_h / 2.0
            tx = x2
            dx = max(36.0, abs(tx - sx) * 0.45)
            path_d = f"M {sx:.1f} {sy:.1f} C {sx + dx:.1f} {sy:.1f}, {tx - dx:.1f} {cy2:.1f}, {tx:.1f} {cy2:.1f}"
            edge_elems.append(
                f'<path class="graph-edge" data-from="{parent_id}" data-to="{doc_id}" d="{path_d}"/>'
            )
        sup_target = d.get("superseded_by")
        if sup_target and sup_target in coords:
            x1, y1 = coords[doc_id]
            tx_n, ty_n = coords[sup_target]
            sx = x1 + node_w
            sy = y1 + node_h / 2.0
            tx = tx_n
            ty = ty_n + node_h / 2.0
            dx = max(36.0, abs(tx - sx) * 0.45)
            path_d = f"M {sx:.1f} {sy:.1f} C {sx + dx:.1f} {sy:.1f}, {tx - dx:.1f} {ty:.1f}, {tx:.1f} {ty:.1f}"
            edge_elems.append(
                f'<path class="graph-edge graph-edge-superseded" data-from="{doc_id}" data-to="{sup_target}" d="{path_d}"/>'
            )

    node_elems: list[str] = []
    for d in docs:
        doc_id = d["id"]
        doc_layer = d["layer"]
        x, y = coords[doc_id]
        href = f'{lang_root}{d["url"]}'
        short_title = d["title"]
        if len(short_title) > 20:
            short_title = short_title[:19].rstrip() + "…"
        aria = f'{doc_id}: {d["title"]} ({d["status"]})'
        node_elems.append(
            f'<g class="graph-node node-{doc_layer}" data-id="{doc_id}" '
            f'data-href="{html.escape(href, quote=True)}" tabindex="0" role="link" '
            f'aria-label="{html.escape(aria, quote=True)}">'
            f"<title>{html.escape(aria)}</title>"
            f'<rect x="{x:.1f}" y="{y:.1f}" width="{node_w}" height="{node_h}" rx="5" ry="5"/>'
            f'<text x="{x + 10:.1f}" y="{y + 19:.1f}">{html.escape(doc_id)}</text>'
            f'<text class="node-sub" x="{x + 10:.1f}" y="{y + 34:.1f}">{html.escape(short_title)}</text>'
            f"</g>"
        )

    svg_aria = (
        "Mapa causal interativo de ADRs e Specs do CASA Standard"
        if locale == "pt"
        else "Interactive causal map of CASA Standard ADRs and Specs"
    )
    edges_html = "".join(edge_elems)
    nodes_html = "".join(node_elems)
    return (
        f'<svg id="causal-graph-svg" class="causal-svg" '
        f'viewBox="0 0 {svg_w} {svg_h}" role="img" '
        f'aria-label="{svg_aria}">'
        f'<g class="graph-edges">{edges_html}</g>'
        f'<g class="graph-nodes">{nodes_html}</g>'
        f"</svg>"
    )


def render_shell(
    *,
    locale: str,
    title: str,
    description: str,
    site_root: str,
    lang_root: str,
    en_page_url: str,
    pt_page_url: str,
    en_switch_href: str,
    pt_switch_href: str,
    base_url: str,
    casa_version: str,
    total_docs: int,
    total_skills: int,
    active_nav: str,
    main_html: str,
    extra_head: str = "",
) -> str:
    is_pt = locale == "pt"
    html_lang = "pt-BR" if is_pt else "en"
    search_index_rel = (
        f"{site_root}assets/search-index.pt.json"
        if is_pt
        else f"{site_root}assets/search-index.en.json"
    )
    canonical_rel = pt_page_url if is_pt else en_page_url

    seo_links = ""
    if base_url:
        b = base_url.rstrip("/")
        canon_abs = f"{b}/{canonical_rel.lstrip('/')}"
        en_abs = f"{b}/{en_page_url.lstrip('/')}"
        pt_abs = f"{b}/{pt_page_url.lstrip('/')}"
        seo_links = (
            f'\n  <link rel="canonical" href="{html.escape(canon_abs, quote=True)}">'
            f'\n  <link rel="alternate" hreflang="en" href="{html.escape(en_abs, quote=True)}">'
            f'\n  <link rel="alternate" hreflang="pt-BR" href="{html.escape(pt_abs, quote=True)}">'
            f'\n  <link rel="alternate" hreflang="x-default" href="{html.escape(en_abs, quote=True)}">'
            f'\n  <meta property="og:url" content="{html.escape(canon_abs, quote=True)}">'
        )

    def nav_attr(key: str) -> str:
        return ' aria-current="page"' if active_nav == key else ""

    en_curr = "" if is_pt else ' aria-current="true"'
    pt_curr = ' aria-current="true"' if is_pt else ""

    graph_slug = "grafo" if is_pt else "graph"
    nav_home = "Visão geral" if is_pt else "Overview"
    nav_graph = f"Grafo ({total_docs})" if is_pt else f"Graph ({total_docs})"
    nav_aria = "Navegação principal" if is_pt else "Primary navigation"
    skip_label = "Pular para o conteúdo principal" if is_pt else "Skip to main content"
