          <a class="lang-link" id="lang-link-en" href="{html.escape(en_switch_href, quote=True)}" lang="en" hreflang="en"{en_curr}>EN</a>
          <a class="lang-link" id="lang-link-pt" href="{html.escape(pt_switch_href, quote=True)}" lang="pt-BR" hreflang="pt-BR"{pt_curr}>PT-BR</a>
        </div>

        <button type="button" class="search-trigger" id="search-open-btn" aria-label="{search_aria}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
          </svg>
          <span class="search-trigger-label">{search_btn_txt}</span>
          <kbd class="kbd">⌘K</kbd>
        </button>

        <button type="button" class="icon-btn" id="theme-toggle-btn" aria-label="{theme_aria}" title="{theme_title}">
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
