    footer_note = (
        f"CASA Standard v{html.escape(casa_version)} · Compilado das fontes canônicas · MIT © atplus-digital"
        if is_pt
        else f"CASA Standard v{html.escape(casa_version)} · Compiled from canonical sources · MIT © atplus-digital"
    )
    footer_graph_lbl = "Grafo ADRs &amp; Specs" if is_pt else "ADRs &amp; Specs Graph"
    search_placeholder = (
        "Buscar seções do STANDARD, ADRs, Specs ou skills…"
        if is_pt
