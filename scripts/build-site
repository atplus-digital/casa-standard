    )
    search_empty_msg = (
        "Nenhum documento ou seção encontrado para este termo."
        if is_pt
        else "No document or section matched this query."
    )
    search_clear_lbl = "Limpar busca" if is_pt else "Clear search"

    return f"""<!DOCTYPE html>
<html lang="{html_lang}" data-site-root="{site_root}" data-search-index="{search_index_rel}">
