        <span>CASA Standard</span>
        <span class="brand-version">v{html.escape(casa_version)}</span>
      </a>

      <nav class="primary-nav" id="primary-nav" aria-label="{nav_aria}">
        <a class="nav-link" href="{lang_root}"{nav_attr("home")}>{nav_home}</a>
        <a class="nav-link" href="{lang_root}standard/"{nav_attr("standard")}>Standard</a>
        <a class="nav-link" href="{lang_root}{graph_slug}/"{nav_attr("graph")}>{nav_graph}</a>
        <a class="nav-link" href="{lang_root}skills/"{nav_attr("skills")}>Skills ({total_skills})</a>
