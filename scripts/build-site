          </svg>
        </a>

        <button type="button" class="icon-btn mobile-menu-btn" id="mobile-menu-btn" aria-expanded="false" aria-controls="primary-nav" aria-label="Menu">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
{main_html}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div>
        {footer_note}
      </div>
      <div class="footer-links">
        <a href="{lang_root}standard/">STANDARD.md</a>
        <a href="{lang_root}{graph_slug}/">{footer_graph_lbl}</a>
        <a href="{lang_root}skills/">Agent Skills</a>
        <a href="{lang_root}changelog/">Changelog</a>
        <a href="{html.escape(pt_switch_href if not is_pt else en_switch_href, quote=True)}">{"English" if is_pt else "Português (PT-BR)"}</a>
        <a href="{GITHUB_REPO_URL}" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </footer>

  <div class="search-backdrop" id="search-backdrop" role="dialog" aria-modal="true" aria-label="{search_aria}" hidden>
    <div class="search-dialog">
      <div class="search-input-row">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
        </svg>
        <input type="search" class="search-modal-input" id="search-modal-input" placeholder="{search_placeholder}" autocomplete="off">
        <kbd class="kbd">ESC</kbd>
      </div>
      <ul class="search-results" id="search-results-list"></ul>
      <div class="empty-state" id="search-empty-state" hidden>
        <p>{search_empty_msg}</p>
        <button type="button" class="btn btn-secondary" id="search-clear-btn">{search_clear_lbl}</button>
      </div>
    </div>
  </div>

  <script src="{site_root}assets/app.js" defer></script>
</body>
</html>
"""


def render_toc_sidebar(toc_items: list[dict[str, Any]], label: str) -> str:
    if not toc_items:
        return ""
    lis: list[str] = []
    for item in toc_items:
        sub_cls = " toc-sub" if item["level"] == 3 else ""
        item_id = item["id"]
        item_label = html.escape(item["label"])
        lis.append(
            f'<li><a class="toc-link{sub_cls}" href="#{item_id}">{item_label}</a></li>'
        )
    joined_lis = "".join(lis)
    return (
        f'<aside class="toc-sidebar" aria-label="{html.escape(label)}">'
        f'<p class="toc-title">{html.escape(label)}</p>'
        f'<ul class="toc-list">{joined_lis}</ul>'
        f"</aside>"
    )


def parse_readme_pillars(readme_md: str) -> list[dict[str, str]]:
    pillars: list[dict[str, str]] = []
    lines = readme_md.splitlines()
    for idx, line in enumerate(lines):
        if line.strip() in ("## The four pillars", "## Os quatro pilares"):
            j = idx + 1
            while j < len(lines) and not lines[j].lstrip().startswith("|"):
                j += 1
            j += 2  # skip header + separator
            while j < len(lines) and lines[j].lstrip().startswith("|"):
                cells = split_table_row(lines[j])
                if len(cells) >= 3:
                    raw_name = re.sub(r"\*\*(.+?)\*\*", r"\1", cells[0]).strip()
                    letter = raw_name[0].upper() if raw_name else "C"
                    pillars.append(
                        {
                            "letter": letter,
                            "name": raw_name,
                            "what": cells[1],
                            "where": re.sub(r"`([^`]+)`", r"\1", cells[2]),
                        }
                    )
                j += 1
            break
    return pillars


def build_home_page(
    *,
    locale: str,
    meta: dict[str, str],
    pillars: list[dict[str, str]],
    docs: list[dict[str, Any]],
    skills: list[dict[str, Any]],
    doc_urls: dict[str, str],
) -> str:
    is_pt = locale == "pt"
    graph_slug = "grafo" if is_pt else "graph"
    adr_count = sum(1 for d in docs if d["layer"] == "adr")
    spec_count = sum(1 for d in docs if d["layer"] == "specs")
    ver = html.escape(meta["version"])
    crit = html.escape(meta["criterion"])

    home_renderer = MarkdownRenderer(doc_urls, "./", f"home-{locale}", locale=locale)

    pillar_rows: list[str] = []
    for p in pillars:
        pillar_rows.append(
            f'<div class="pillar-row">'
            f'<div class="pillar-letter" aria-hidden="true">{html.escape(p["letter"])}</div>'
            f"<div>"
            f'<h3 class="pillar-title">{html.escape(p["name"])}</h3>'
            f'<p class="pillar-desc">{home_renderer.render_inline(p["what"])}</p>'
            f'<div class="pillar-where">{html.escape(p["where"])}</div>'
            f"</div>"
            f"</div>"
        )

    anatomy_items = (
        [
            (
                "AGENTS.md",
                "router · carga sempre",
                "Camada 1 (teto ~150 linhas): metadados CASA, contexto em 5 linhas, DoD global executável, gotchas não-inferíveis e Mapa de contexto.",
            ),
            (
                "CLAUDE.md",
                "ponte de host",
                "Importa @AGENTS.md para hosts que não leem AGENTS.md nativamente (ADR-0009). Criada uma vez pelo casa-init; nunca sobrescrita.",
            ),
            (
                "docs/context/*.md",
                "estado atual",
                "Camada 2 sob demanda (INFRA, TESTS, CONVENTIONS…). Conteúdo imperativo e atemporal — retira dos ADRs a pressão de emenda.",
            ),
            (
                "docs/adr/NNNN-*.md",
                "decisões imutáveis",
                "MADR 4.0 + seção Confirmação. Aceito em main, o corpo torna-se imutável no CI; mudança futura exige novo ADR que o supersede.",
            ),
            (
                "docs/specs/NNNN-*.md",
                "contratos + DoD",
                "Fluxo, contrato, casos de borda em EARS e Definition of Done com comandos reais do repositório antes da implementação.",
            ),
            (
                ".agents/skills/casa-*/",
                "ciclo executável",
                "As 5 Agent Skills (explore, propose, apply, verify, close) distribuídas pela toolchain em T1, também espelhadas em .claude/skills/.",
            ),
            (
                "scripts/docs-check",
                "gate determinístico",
                "Validador em Python stdlib: verifica router, frontmatter fechado, grafo causal, imutabilidade de ADRs, higiene e frescor de índices.",
            ),
        ]
        if is_pt
        else [
            (
                "AGENTS.md",
                "router · always loaded",
                "Layer 1 (~150-line ceiling): CASA metadata, 5-line context, executable global DoD, non-inferable gotchas, and Context map.",
            ),
            (
                "CLAUDE.md",
                "host shim",
                "Imports @AGENTS.md for hosts that do not read AGENTS.md natively (ADR-0009). Created once by casa-init; never overwritten.",
            ),
            (
                "docs/context/*.md",
                "current state",
                "On-demand Layer 2 chapters (INFRA, TESTS, CONVENTIONS…). Imperative, timeless operational truth — relieves ADRs from amendment pressure.",
            ),
            (
                "docs/adr/NNNN-*.md",
                "immutable decisions",
                "MADR 4.0 + practical Confirmation. Once accepted on main, body mutations are blocked in CI; future changes supersede via a new ADR.",
            ),
            (
                "docs/specs/NNNN-*.md",
                "contracts + DoD",
                "Flow, contract, EARS edge cases, and an executable Definition of Done wired to real repository commands before implementation.",
            ),
            (
                ".agents/skills/casa-*/",
                "executable cycle",
                "The 5 official Agent Skills (explore, propose, apply, verify, close) distributed in T1 and mirrored into .claude/skills/.",
            ),
            (
                "scripts/docs-check",
                "deterministic gate",
                "Zero-dependency Python 3 validator: checks router invariants, closed frontmatter, causal graph, ADR immutability, hygiene, and index freshness.",
            ),
        ]
    )

    tree_lis: list[str] = []
    for idx, (path_label, owner, desc) in enumerate(anatomy_items):
        selected = "true" if idx == 0 else "false"
        tree_lis.append(
            f"<li>"
            f'<button type="button" class="tree-item-btn" '
            f'aria-selected="{selected}" '
            f'data-tree-title="{html.escape(path_label, quote=True)}" '
            f'data-tree-path="{html.escape(path_label, quote=True)}" '
