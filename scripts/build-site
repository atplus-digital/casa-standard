def render_toc_sidebar(toc_items: list[dict[str, Any]], label: str = "Nesta página") -> str:
    if not toc_items:
        return ""
    lis: list[str] = []
    for item in toc_items:
        sub_cls = " toc-sub" if item["level"] == 3 else ""
        lis.append(
            f'<li><a class="toc-link{sub_cls}" href="#{item["id"]}">'
            f'{html.escape(item["label"])}</a></li>'
        )
    return (
        f'<aside class="toc-sidebar" aria-label="{html.escape(label)}">'
        f'<p class="toc-title">{html.escape(label)}</p>'
        f'<ul class="toc-list">{"".join(lis)}</ul>'
        f"</aside>"
    )


def parse_readme_pillars(readme_md: str) -> list[dict[str, str]]:
    pillars: list[dict[str, str]] = []
    lines = readme_md.splitlines()
    for idx, line in enumerate(lines):
        if line.strip() == "## Os quatro pilares":
            j = idx + 1
            while j < len(lines) and not lines[j].lstrip().startswith("|"):
                j += 1
            j += 2  # skip header + separator
            while j < len(lines) and lines[j].lstrip().startswith("|"):
                cells = split_table_row(lines[j])
                if len(cells) >= 3:
                    raw_name = re.sub(r"\*\*(.+?)\*\*", r"\1", cells[0]).strip()
                    letter = raw_name[0].upper() if raw_name else "C"
                    pillars.append(
                        {
                            "letter": letter,
                            "name": raw_name,
                            "what": cells[1],
                            "where": re.sub(r"`([^`]+)`", r"\1", cells[2]),
                        }
                    )
                j += 1
            break
    return pillars


def build_home_page(
    *,
    meta: dict[str, str],
    pillars: list[dict[str, str]],
    docs: list[dict[str, Any]],
    skills: list[dict[str, Any]],
    doc_urls: dict[str, str],
) -> str:
    adr_count = sum(1 for d in docs if d["layer"] == "adr")
    spec_count = sum(1 for d in docs if d["layer"] == "specs")
    ver = html.escape(meta["version"])
    crit = html.escape(meta["criterion"])

    home_renderer = MarkdownRenderer(doc_urls, "./", "home")

    pillar_rows: list[str] = []
    for p in pillars:
        pillar_rows.append(
            f'<div class="pillar-row">'
            f'<div class="pillar-letter" aria-hidden="true">{html.escape(p["letter"])}</div>'
            f"<div>"
            f'<h3 class="pillar-title">{html.escape(p["name"])}</h3>'
            f'<p class="pillar-desc">{home_renderer.render_inline(p["what"])}</p>'
            f'<div class="pillar-where">{html.escape(p["where"])}</div>'
            f"</div>"
            f"</div>"
        )

    anatomy_items = [
        (
            "AGENTS.md",
            "router · carga sempre",
            "Camada 1 (teto ~150 linhas): metadados CASA, contexto em 5 linhas, DoD global executável, gotchas não-inferíveis e Mapa de contexto.",
        ),
        (
            "CLAUDE.md",
            "ponte de host",
            "Importa @AGENTS.md para hosts que não leem AGENTS.md nativamente (ADR-0009). Criada uma vez pelo casa-init; nunca sobrescrita.",
        ),
        (
            "docs/context/*.md",
            "estado atual",
            "Camada 2 sob demanda (INFRA, TESTS, CONVENTIONS…). Conteúdo imperativo e atemporal — retira dos ADRs a pressão de emenda.",
        ),
        (
            "docs/adr/NNNN-*.md",
            "decisões imutáveis",
            "MADR 4.0 + seção Confirmação. Aceito em main, o corpo torna-se imutável no CI; mudança futura exige novo ADR que o supersede.",
        ),
        (
            "docs/specs/NNNN-*.md",
            "contratos + DoD",
            "Fluxo, contrato, casos de borda em EARS e Definition of Done com comandos reais do repositório antes da implementação.",
        ),
        (
            ".agents/skills/casa-*/",
            "ciclo executável",
            "As 5 Agent Skills (explore, propose, apply, verify, close) distribuídas pela toolchain em T1, também espelhadas em .claude/skills/.",
        ),
        (
            "scripts/docs-check",
            "gate determinístico",
            "Validador em Python stdlib: verifica router, frontmatter fechado, grafo causal, imutabilidade de ADRs, higiene e frescor de índices.",
        ),
    ]

    tree_lis: list[str] = []
    for idx, (path_label, owner, desc) in enumerate(anatomy_items):
        selected = "true" if idx == 0 else "false"
        tree_lis.append(
            f"<li>"
            f'<button type="button" class="tree-item-btn" '
            f'aria-selected="{selected}" '
            f'data-tree-title="{html.escape(path_label, quote=True)}" '
            f'data-tree-path="{html.escape(path_label, quote=True)}" '
            f'data-tree-desc="{html.escape(desc, quote=True)}">'
            f"<span>{html.escape(path_label)}</span>"
            f'<span class="tree-owner">{html.escape(owner)}</span>'
            f"</button>"
            f"</li>"
        )

    step_btns: list[str] = []
    step_panes: list[str] = []
    for idx, sk in enumerate(skills):
        selected = "true" if idx == 0 else "false"
        hidden_attr = "" if idx == 0 else " hidden"
        pane_id = f'cycle-pane-{sk["name"]}'
        step_btns.append(
            f'<button type="button" class="cycle-step-btn" role="tab" '
            f'id="tab-{sk["name"]}" aria-selected="{selected}" aria-controls="{pane_id}">'
            f'<span class="cycle-step-idx">0{idx + 1} · etapa</span>'
            f'<span class="cycle-step-name">{html.escape(sk["name"])}</span>'
            f"</button>"
        )
        step_panes.append(
            f'<div class="cycle-preview" id="{pane_id}" role="tabpanel" '
            f'aria-labelledby="tab-{sk["name"]}"{hidden_attr}>'
            f'<div class="cycle-preview-head">'
            f'<strong>{html.escape(sk["title"])}</strong>'
            f'<a href="./skills/#{html.escape(sk["name"])}">Ler procedimento completo →</a>'
            f"</div>"
            f'<p style="margin:0;color:var(--ink-secondary);font-size:0.93rem;">'
            f'{html.escape(sk["description"])}</p>'
            f"</div>"
        )

    recent_docs = sorted(docs, key=lambda d: (d["date"], d["id"]), reverse=True)[:6]
    recent_rows: list[str] = []
    for d in recent_docs:
        recent_rows.append(
            f"<tr>"
            f'<td><a class="doc-ref-chip" href="./{html.escape(d["url"], quote=True)}">{html.escape(d["id"])}</a></td>'
            f'<td><a href="./{html.escape(d["url"], quote=True)}">{html.escape(d["title"])}</a></td>'
            f'<td>{status_badge(d["status"])}</td>'
            f'<td style="font-family:var(--font-mono);font-size:0.78rem;color:var(--ink-muted);">{html.escape(d["date"])}</td>'
            f"</tr>"
        )

    return f"""
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Especificação normativa · Contrato v{ver} · {html.escape(meta["status"])}</p>
        <div class="hero-grid">
          <div>
            <h1>Workflow de engenharia onde agentes operam sob garantias mecânicas.</h1>
            <p class="hero-lead">
              <strong>CASA</strong> (Contexto, ADRs, Specs, Automação) organiza decisões imutáveis,
              contratos verificáveis, contexto em camadas de tokens e validação de CI sem dependências
              para repositórios conduzidos por humanos e agentes de IA.
            </p>
            <blockquote class="thesis-quote">
              “Critério de design: {crit}”
            </blockquote>
            <div class="hero-ctas">
              <a class="btn btn-primary" href="./standard/" id="cta-read-standard">Ler o STANDARD v{ver}</a>
              <a class="btn btn-secondary" href="./grafo/" id="cta-explore-graph">Explorar o grafo ({len(docs)} docs)</a>
              <a class="btn btn-secondary" href="./skills/" id="cta-browse-skills">Catálogo de Skills</a>
            </div>
          </div>

          <div class="quickstart-panel" data-tabs>
            <div class="quickstart-tabs" role="tablist" aria-label="Modos de instalação do CASA Standard">
              <button type="button" class="tab-btn" role="tab" id="qs-tab-1" aria-selected="true" aria-controls="qs-pane-1">curl | sh</button>
              <button type="button" class="tab-btn" role="tab" id="qs-tab-2" aria-selected="false" aria-controls="qs-pane-2">auditar antes</button>
              <button type="button" class="tab-btn" role="tab" id="qs-tab-3" aria-selected="false" aria-controls="qs-pane-3">validar local</button>
            </div>
            <div class="quickstart-body">
              <div class="quickstart-pane" id="qs-pane-1" role="tabpanel" aria-labelledby="qs-tab-1">
                <div class="cmd-box">
                  <button type="button" class="copy-btn" id="copy-qs-1" data-copy-target="cmd-qs-1">Copiar</button>
                  <code id="cmd-qs-1">curl -fsSL https://raw.githubusercontent.com/atplus-digital/casa-standard/main/install.sh | sh -s -- . --repo-id meu-repo</code>
                </div>
                <p class="quickstart-caption">
                  Aditivo e idempotente: instala <code>scripts/docs-check</code>, templates, skills <code>casa-*</code>,
                  ponte <code>CLAUDE.md</code> e o gate automatizado sem tocar no conteúdo do repositório.
                </p>
              </div>

              <div class="quickstart-pane" id="qs-pane-2" role="tabpanel" aria-labelledby="qs-tab-2" hidden>
                <div class="cmd-box">
                  <button type="button" class="copy-btn" id="copy-qs-2" data-copy-target="cmd-qs-2">Copiar</button>
                  <code id="cmd-qs-2">curl -fsSLO https://raw.githubusercontent.com/atplus-digital/casa-standard/main/install.sh
less install.sh
sh install.sh . --repo-id meu-repo</code>
                </div>
                <p class="quickstart-caption">
                  Para pinar uma revisão imutável, passe <code>CASA_REF=&lt;tag|sha&gt;</code> ao <code>sh</code>:
                  <code>curl -fsSL …/install.sh | CASA_REF=main sh -s -- . --repo-id meu-repo</code>.
                </p>
              </div>

              <div class="quickstart-pane" id="qs-pane-3" role="tabpanel" aria-labelledby="qs-tab-3" hidden>
                <div class="cmd-box">
                  <button type="button" class="copy-btn" id="copy-qs-3" data-copy-target="cmd-qs-3">Copiar</button>
                  <code id="cmd-qs-3">python3 scripts/docs-check
python3 scripts/docs-check --emit-index</code>
                </div>
                <p class="quickstart-caption">
                  Zero dependências externas (Python 3 stdlib). Mesmo comando executado pelo gate de CI e pelo hook local.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section aria-label="Indicadores do repositório de referência">
      <div class="metrics-strip container" style="padding:0;">
        <a class="metric-cell" href="./standard/">
          <span class="metric-value">v{ver}</span>
          <span class="metric-label">Contrato CASA vigente</span>
        </a>
        <a class="metric-cell" href="./grafo/">
          <span class="metric-value">{adr_count} ADRs · {spec_count} Specs</span>
          <span class="metric-label">Dogfooding no próprio repo</span>
        </a>
        <a class="metric-cell" href="./skills/">
          <span class="metric-value">{len(skills)} Skills</span>
          <span class="metric-label">Ciclo §9 em Agent Skills</span>
        </a>
        <div class="metric-cell">
          <span class="metric-value">0 deps</span>
          <span class="metric-label">Python 3 stdlib pura</span>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-num">§1–§4 · Arquitetura documental</span>
            <h2 class="section-title">Os quatro pilares e a anatomia no repositório</h2>
            <p class="section-sub">
              Cada artefato ocupa uma camada de custo de contexto e responde a um único papel:
              estado atual mutável não se mistura com decisão histórica imutável.
            </p>
          </div>
        </div>

        <div class="pillars-layout">
          <div class="pillars-ledger">
            {"".join(pillar_rows)}
          </div>

          <div class="anatomy-box">
            <div class="anatomy-head">
              <span>inspecionar árvore T1</span>
              <span>clique num caminho</span>
            </div>
            <ul class="tree-list" aria-label="Arquivos de um repositório CASA T1">
              {"".join(tree_lis)}
            </ul>
            <div class="anatomy-detail" aria-live="polite">
              <p class="anatomy-detail-title" id="anatomy-detail-title">{html.escape(anatomy_items[0][0])}</p>
              <p class="anatomy-detail-body" id="anatomy-detail-body">{html.escape(anatomy_items[0][2])}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="container" data-tabs>
        <div class="section-header">
          <div>
            <span class="section-num">§9 · Operação assistida</span>
            <h2 class="section-title">Ciclo de vida de uma entrega como Agent Skills</h2>
            <p class="section-sub">
              Em repositórios T1, o <code>casa-init</code> distribui cinco procedimentos enxutos
              que conduzem o agente da leitura do subgrafo ao fechamento atômico da Spec.
            </p>
          </div>
          <a class="btn btn-secondary" href="./skills/">Abrir catálogo completo</a>
        </div>

        <div class="cycle-stepper" role="tablist" aria-label="Etapas do ciclo CASA">
          {"".join(step_btns)}
        </div>
        {"".join(step_panes)}
      </div>
    </section>

    <section class="home-section" style="border-bottom:none;">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-num">§5 · Rastreabilidade real</span>
            <h2 class="section-title">Decisões e contratos recentes do próprio padrão</h2>
            <p class="section-sub">
              O <code>casa-standard</code> opera sob suas próprias regras: toda evolução da especificação
              e da toolchain nasce de ADR e Spec auditados pelo mesmo <code>docs-check</code>.
            </p>
          </div>
          <a class="btn btn-secondary" href="./grafo/">Ver grafo completo ({len(docs)})</a>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Status</th>
                <th>Data</th>
              </tr>
            </thead>
            <tbody>
              {"".join(recent_rows)}
            </tbody>
          </table>
        </div>
      </div>
    </section>
"""


def build_doc_page(
    doc: dict[str, Any],
    by_id: dict[str, dict[str, Any]],
    doc_urls: dict[str, str],
) -> tuple[str, list[dict[str, Any]]]:
    rel_root = "../../"
    renderer = MarkdownRenderer(
        doc_urls, rel_root, slugify(doc["id"]), current_doc_id=doc["id"]
    )
    body_html, toc = renderer.render(doc["body"], skip_first_h1=True)

    def render_ref_chips(ids: list[str]) -> str:
        if not ids:
            return '<span style="color:var(--ink-muted);font-size:0.82rem;">nenhum</span>'
        chips: list[str] = []
        for ref_id in ids:
            if ref_id in by_id:
                target = by_id[ref_id]
                href = f'{rel_root}{target["url"]}'
                chips.append(
                    f'<a class="doc-ref-chip" href="{html.escape(href, quote=True)}" '
                    f'title="{html.escape(target["title"], quote=True)}">{html.escape(ref_id)}</a>'
                )
            else:
                chips.append(f'<span class="doc-ref-chip">{html.escape(ref_id)}</span>')
        return "".join(chips)

    passport_cells: list[str] = [
        f'<div><span class="passport-key">Status</span><div class="passport-val">{status_badge(doc["status"])}</div></div>',
        f'<div><span class="passport-key">Data</span><div class="passport-val" style="font-family:var(--font-mono);">{html.escape(doc["date"] or "—")}</div></div>',
        f'<div><span class="passport-key">Fundamentado em (builds-on)</span><div class="passport-val">{render_ref_chips(doc["builds_on"])}</div></div>',
        f'<div><span class="passport-key">Citado por (a jusante)</span><div class="passport-val">{render_ref_chips(doc["cited_by"])}</div></div>',
    ]

    if doc["layer"] == "adr" and doc["deciders"]:
        dec_str = ", ".join(doc["deciders"])
        passport_cells.append(
            f'<div><span class="passport-key">Decisores</span><div class="passport-val" style="font-family:var(--font-mono);">{html.escape(dec_str)}</div></div>'
        )

    if doc.get("superseded_by"):
        sup = str(doc["superseded_by"])
        passport_cells.append(
            f'<div><span class="passport-key">Superado por</span><div class="passport-val">{render_ref_chips([sup])}</div></div>'
        )

    if doc.get("supersedes"):
        passport_cells.append(
            f'<div><span class="passport-key">Substitui</span><div class="passport-val">{render_ref_chips(doc["supersedes"])}</div></div>'
        )

    if doc["layer"] == "specs" and doc["implemented_by"]:
        impl_links = "".join(
            f'<a class="doc-ref-chip" href="{GITHUB_REPO_URL}/blob/main/{html.escape(p, quote=True)}" '
            f'target="_blank" rel="noopener noreferrer">{html.escape(p)}</a>'
            for p in doc["implemented_by"]
        )
        passport_cells.append(
            f'<div style="grid-column: 1 / -1;"><span class="passport-key">Implementado por (implemented-by)</span>'
            f'<div class="passport-val">{impl_links}</div></div>'
        )

    truth_html = ""
    if doc.get("truth_callout"):
        truth_html = (
            f'<div class="truth-callout" role="note">'
            f'{renderer.render_inline(doc["truth_callout"])}'
            f"</div>"
        )

    layer_label = "Architecture Decision Record" if doc["layer"] == "adr" else "Specification"
    src_url = f'{GITHUB_REPO_URL}/blob/main/{doc["path"]}'

    article_html = f"""
      <article class="prose">
        <div class="doc-meta-bar">
          <a href="{rel_root}grafo/" style="text-decoration:none;">← Grafo</a>
          <span>·</span>
          <span>{html.escape(doc["id"])}</span>
          <span>·</span>
          <span>{layer_label}</span>
          <span>·</span>
          <a href="{html.escape(src_url, quote=True)}" target="_blank" rel="noopener noreferrer">Fonte Markdown</a>
        </div>
        <h1>{html.escape(doc["title"])}</h1>
        {truth_html}
        <div class="doc-Passport" aria-label="Metadados e conexões do documento">
          <div class="passport-grid">
            {"".join(passport_cells)}
          </div>
        </div>
        {body_html}
      </article>
"""

    if len(toc) >= 2:
        sidebar = render_toc_sidebar(toc, "Seções")
        return f'<div class="container doc-shell">{sidebar}{article_html}</div>', toc
    return f'<div class="doc-shell-single">{article_html}</div>', toc


def extract_standard_search_entries(standard_md: str) -> list[dict[str, str]]:
    cleaned = strip_comments_outside_fences(standard_md)
    lines = cleaned.splitlines()
    entries: list[dict[str, str]] = []
    used_ids: set[str] = set()
    cur_title = "CASA Standard"
    cur_id = ""
    cur_buf: list[str] = []
    in_fence = False
    fence_char = ""
    fence_len = 0

    def flush() -> None:
        if not cur_buf:
            return
        snippet = plain_text_from_md("\n".join(cur_buf), max_len=200)
        if snippet:
            url = f"standard/#{cur_id}" if cur_id else "standard/"
            entries.append(
                {
                    "kind": "Standard",
                    "title": cur_title,
                    "url": url,
                    "body": snippet,
                }
            )
        cur_buf.clear()

    for line in lines:
        if not in_fence:
            m_f = FENCE_OPEN_RE.match(line)
            if m_f and not line.lstrip().startswith("\u200b"):
                in_fence = True
                fence_char = m_f.group(2)[0]
                fence_len = len(m_f.group(2))
                continue
            m_h = HEADING_RE.match(line)
            if m_h:
                lvl = len(m_h.group(1))
                raw_t = m_h.group(2).strip()
                if lvl in (2, 3):
                    flush()
                    cur_id = standard_heading_id(raw_t, used_ids)
                    cur_title = re.sub(r"`([^`]+)`", r"\1", raw_t)
                    continue
                if lvl == 1:
                    cur_title = raw_t
                    continue
            cur_buf.append(line)
        else:
            stripped = line.strip()
            if (
                not line.lstrip().startswith("\u200b")
                and stripped
                and all(ch == fence_char for ch in stripped)
                and len(stripped) >= fence_len
            ):
                in_fence = False
    flush()
    return entries


def build_site(root: Path, out_dir: Path, base_url: str) -> int:
    standard_path = root / "STANDARD.md"
    readme_path = root / "README.md"
    changelog_path = root / "CHANGELOG.md"
    site_assets_dir = root / "site"

    for required in (
        standard_path,
        readme_path,
        changelog_path,
        root / "docs" / "index.json",
        site_assets_dir / "style.css",
        site_assets_dir / "app.js",
        site_assets_dir / "favicon.svg",
    ):
        if not required.exists():
            print(f"ERRO: fonte obrigatória ausente: {required}", file=sys.stderr)
            return 1

    standard_md = standard_path.read_text(encoding="utf-8")
    readme_md = readme_path.read_text(encoding="utf-8")
    changelog_md = changelog_path.read_text(encoding="utf-8")

    meta = parse_standard_metadata(standard_md)
    casa_version = meta["version"]
    pillars = parse_readme_pillars(readme_md)
    docs = load_canonical_docs(root)
    skills = load_skills(root)

    by_id = {d["id"]: d for d in docs}
    doc_urls = {d["id"]: d["url"] for d in docs}

    if out_dir.exists():
        shutil.rmtree(out_dir)
    assets_out = out_dir / "assets"
    assets_out.mkdir(parents=True, exist_ok=True)

    for asset_name in ("style.css", "app.js", "favicon.svg"):
        shutil.copyfile(site_assets_dir / asset_name, assets_out / asset_name)

    (out_dir / ".nojekyll").write_text("", encoding="utf-8", newline="\n")

    def write_html(rel_file: str, content: str) -> None:
        target = out_dir / rel_file
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content, encoding="utf-8", newline="\n")

    # 1. Home page (index.html)
    home_main = build_home_page(
        meta=meta,
        pillars=pillars,
        docs=docs,
        skills=skills,
        doc_urls=doc_urls,
    )
    write_html(
        "index.html",
        render_shell(
            title=f"CASA Standard v{casa_version} — Contexto, ADRs, Specs, Automação",
            description=(
                "Padrão aberto de workflow de desenvolvimento orientado a agentes de IA: "
                "contexto em camadas, ADRs imutáveis, Specs com DoD executável e validação determinística."
            ),
            rel_root="./",
            page_url="",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="home",
            main_html=home_main,
        ),
    )

    # 2. STANDARD.md page (standard/index.html)
    std_renderer = MarkdownRenderer(doc_urls, "../", "standard")
    std_body_html, std_toc = std_renderer.render(standard_md, standard_ids=True)
    std_main = (
        f'<div class="container doc-shell">'
        f'{render_toc_sidebar(std_toc, "Sumário do Standard")}'
        f'<article class="prose">'
        f'<div class="doc-meta-bar">'
        f"<span>Documento normativo canônico</span>"
        f"<span>·</span>"
        f'<span>Versão {html.escape(casa_version)}</span>'
        f"<span>·</span>"
        f'<a href="{GITHUB_REPO_URL}/blob/main/STANDARD.md" target="_blank" rel="noopener noreferrer">STANDARD.md no GitHub</a>'
        f"</div>"
        f"{std_body_html}"
        f"</article>"
        f"</div>"
    )
    write_html(
        "standard/index.html",
        render_shell(
            title=f"STANDARD.md (v{casa_version}) — CASA Standard",
            description=(
                f"Especificação normativa completa do CASA Standard v{casa_version}: "
                "princípios, estrutura de repositório, camadas de contexto, ADRs, Specs e docs-check."
            ),
            rel_root="../",
            page_url="standard/",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="standard",
            main_html=std_main,
        ),
    )

    # 3. Graph Explorer (grafo/index.html)
    svg_html = build_causal_svg(docs, "../")
    statuses_present = sorted({d["status"] for d in docs})
    status_filter_btns = [
        '<button type="button" class="filter-chip" data-filter-status="all" aria-pressed="true">todos</button>'
    ] + [
        f'<button type="button" class="filter-chip" data-filter-status="{html.escape(st, quote=True)}" aria-pressed="false">{html.escape(st)}</button>'
        for st in statuses_present
    ]

    ledger_rows: list[str] = []
    for d in docs:
        up_chips = " ".join(
            f'<a class="doc-ref-chip" href="../{html.escape(by_id[p]["url"], quote=True)}">{html.escape(p)}</a>'
            for p in d["builds_on"]
            if p in by_id
        ) or '<span style="color:var(--ink-muted);">—</span>'
        down_chips = " ".join(
            f'<a class="doc-ref-chip" href="../{html.escape(by_id[c]["url"], quote=True)}">{html.escape(c)}</a>'
            for c in d["cited_by"]
            if c in by_id
        ) or '<span style="color:var(--ink-muted);">—</span>'
        search_hay = f'{d["id"]} {d["title"]} {d["status"]} {" ".join(d["builds_on"])} {" ".join(d["cited_by"])}'.lower()
        ledger_rows.append(
            f'<tr data-doc-id="{html.escape(d["id"], quote=True)}" '
            f'data-layer="{html.escape(d["layer"], quote=True)}" '
            f'data-status="{html.escape(d["status"], quote=True)}" '
            f'data-search="{html.escape(search_hay, quote=True)}">'
            f'<td><a class="doc-ref-chip" href="../{html.escape(d["url"], quote=True)}">{html.escape(d["id"])}</a></td>'
            f'<td><a href="../{html.escape(d["url"], quote=True)}">{html.escape(d["title"])}</a></td>'
            f'<td>{status_badge(d["status"])}</td>'
            f"<td>{up_chips}</td>"
            f"<td>{down_chips}</td>"
            f"</tr>"
        )

    grafo_main = f"""
    <div class="container graph-page">
      <div class="prose prose-wide">
        <div class="doc-meta-bar">
          <span>docs/index.json</span>
          <span>·</span>
          <span id="graph-visible-count">{len(docs)} documento(s)</span>
        </div>
        <h1>Grafo causal de ADRs e Specs</h1>
        <p style="max-width:68ch;">
          Passe o cursor sobre qualquer nó para iluminar sua linhagem direta (<code>builds-on</code> e
          <code>superseded-by</code>) ou clique para abrir o documento completo com suas conexões reversas.
        </p>
      </div>

      <div class="graph-canvas-wrap">
        <div class="graph-legend">
          <span>Esquerda → Direita: decisões fundacionais (ADR) até contratos derivados (Spec)</span>
          <span>Linha tracejada: supersessão de ADR</span>
        </div>
        {svg_html}
      </div>

      <div class="filter-bar" role="region" aria-label="Filtros da tabela de documentos">
        <div class="filter-group" aria-label="Filtrar por camada">
          <button type="button" class="filter-chip" data-filter-layer="all" aria-pressed="true">Todas ({len(docs)})</button>
          <button type="button" class="filter-chip" data-filter-layer="adr" aria-pressed="false">ADRs ({sum(1 for d in docs if d["layer"] == "adr")})</button>
          <button type="button" class="filter-chip" data-filter-layer="specs" aria-pressed="false">Specs ({sum(1 for d in docs if d["layer"] == "specs")})</button>
        </div>
        <div class="filter-group" aria-label="Filtrar por status">
          {"".join(status_filter_btns)}
        </div>
        <input type="search" class="filter-input" id="graph-filter-input" placeholder="Filtrar por ID, título ou relação…" aria-label="Filtrar documentos por texto">
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Título</th>
              <th>Status</th>
              <th>Fundamentado em</th>
              <th>Citado por</th>
            </tr>
          </thead>
          <tbody id="graph-ledger-body">
            {"".join(ledger_rows)}
          </tbody>
        </table>
      </div>

      <div class="empty-state" id="graph-empty-state" hidden>
        <p>Nenhum ADR ou Spec corresponde aos filtros selecionados.</p>
        <button type="button" class="btn btn-secondary" id="graph-reset-btn">Limpar filtros</button>
      </div>
    </div>
"""
    write_html(
        "grafo/index.html",
        render_shell(
            title="Grafo de ADRs e Specs — CASA Standard",
            description="Explorador interativo do grafo causal de decisões arquiteturais (ADRs) e especificações (Specs) do CASA Standard.",
            rel_root="../",
            page_url="grafo/",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="grafo",
            main_html=grafo_main,
        ),
    )

    # 4. Individual ADR & Spec pages
    for d in docs:
        doc_main, _ = build_doc_page(d, by_id, doc_urls)
        write_html(
            f'{d["url"]}index.html',
            render_shell(
                title=f'{d["id"]} · {d["title"]} — CASA Standard',
                description=f'{d["id"]} ({d["status"]}): {d["title"]}',
                rel_root="../../",
                page_url=d["url"],
                base_url=base_url,
                casa_version=casa_version,
                total_docs=len(docs),
                total_skills=len(skills),
                active_nav="grafo",
                main_html=doc_main,
            ),
        )

    # 5. Skills catalog (skills/index.html)
    total_desc_chars = sum(sk["desc_chars"] for sk in skills)
    skills_toc: list[dict[str, Any]] = []
    skill_cards: list[str] = []
    for idx, sk in enumerate(skills):
        sk_id = sk["name"]
        skills_toc.append({"id": sk_id, "level": 2, "label": f'0{idx + 1}. {sk["name"]}'})
        sk_renderer = MarkdownRenderer(doc_urls, "../", sk_id)
        sk_body_html, _ = sk_renderer.render(
            sk["body"], skip_first_h1=True, heading_offset=1
        )
        src_href = f'{GITHUB_REPO_URL}/blob/main/{sk["path"]}'
        skill_cards.append(
            f'<section class="skill-section" id="{html.escape(sk_id, quote=True)}">'
            f'<div class="skill-section-head">'
            f'<h2 style="margin:0;border:none;padding:0;">'
            f'<span style="font-family:var(--font-mono);font-size:0.85rem;color:var(--accent);margin-right:0.5rem;">0{idx + 1}</span>'
            f'{html.escape(sk["name"])} <span style="color:var(--ink-muted);font-weight:400;">— {html.escape(sk["title"])}</span>'
            f"</h2>"
            f'<span style="font-family:var(--font-mono);font-size:0.75rem;color:var(--ink-muted);">'
            f'{sk["desc_chars"]} chars · <a href="{html.escape(src_href, quote=True)}" target="_blank" rel="noopener noreferrer">SKILL.md</a>'
            f"</span>"
            f"</div>"
            f'<div class="skill-desc-box"><strong>Trigger / description:</strong> {html.escape(sk["description"])}</div>'
            f"{sk_body_html}"
            f"</section>"
        )

    skills_intro_renderer = MarkdownRenderer(doc_urls, "../", "skills-intro")
    skills_intro_p = skills_intro_renderer.render_inline(
        "Distribuídas pelo `casa-init` em repositórios T1 para `.agents/skills/` e `.claude/skills/` "
        "(ADR-0017, SPEC-0010). Cada skill é auto-contida, aponta para o `STANDARD.md` cravado no "
        "`casa-standard-ref` do adotante e mantém orçamento enxuto de descrições no launch."
    )
    skills_main = (
        f'<div class="container doc-shell">'
        f'{render_toc_sidebar(skills_toc, "Ciclo §9")}'
        f'<div class="prose prose-wide">'
        f'<div class="doc-meta-bar">'
        f"<span>Formato Agent Skills</span>"
        f"<span>·</span>"
        f"<span>{len(skills)} skills</span>"
        f"<span>·</span>"
        f"<span>Orçamento somado de descriptions: {total_desc_chars} caracteres</span>"
        f"</div>"
        f"<h1>Agent Skills do ciclo de entrega</h1>"
        f"<p style=\"max-width:68ch;\">{skills_intro_p}</p>"
        f'{"".join(skill_cards)}'
        f"</div>"
        f"</div>"
    )
    write_html(
        "skills/index.html",
        render_shell(
            title="Agent Skills (casa-*) — CASA Standard",
            description="Catálogo completo das 5 Agent Skills oficiais do CASA Standard: casa-explore, casa-propose, casa-apply, casa-verify e casa-close.",
            rel_root="../",
            page_url="skills/",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="skills",
            main_html=skills_main,
        ),
    )

    # 6. Changelog page (changelog/index.html)
    chg_renderer = MarkdownRenderer(doc_urls, "../", "changelog")
    chg_body_html, chg_toc = chg_renderer.render(changelog_md, skip_first_h1=True)
    chg_main = (
        f'<div class="container doc-shell">'
        f'{render_toc_sidebar(chg_toc, "Versões")}'
        f'<article class="prose">'
        f'<div class="doc-meta-bar">'
        f"<span>Histórico de contrato</span>"
        f"<span>·</span>"
        f'<a href="{GITHUB_REPO_URL}/blob/main/CHANGELOG.md" target="_blank" rel="noopener noreferrer">CHANGELOG.md no GitHub</a>'
        f"</div>"
        f"<h1>Changelog do contrato CASA</h1>"
        f"{chg_body_html}"
        f"</article>"
        f"</div>"
    )
    write_html(
        "changelog/index.html",
        render_shell(
            title="Changelog — CASA Standard",
            description="Histórico completo de versões e evolução do contrato normativo do CASA Standard.",
            rel_root="../",
            page_url="changelog/",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="changelog",
            main_html=chg_main,
        ),
    )

    # 7. Search index (assets/search-index.json)
    search_entries: list[dict[str, str]] = []
    search_entries.extend(extract_standard_search_entries(standard_md))
    for d in docs:
        search_entries.append(
            {
                "kind": d["id"],
                "title": f'{d["id"]} · {d["title"]}',
                "url": d["url"],
                "body": f'[{d["status"]}] ' + plain_text_from_md(d["body"], max_len=190),
            }
        )
    for sk in skills:
        search_entries.append(
            {
                "kind": "Skill",
                "title": f'{sk["name"]} — {sk["title"]}',
                "url": f'skills/#{sk["name"]}',
                "body": sk["description"],
            }
        )
    for item in chg_toc:
        if item["level"] == 2:
            search_entries.append(
                {
                    "kind": "Changelog",
                    "title": item["label"],
                    "url": f'changelog/#{item["id"]}',
                    "body": f'Notas de versão e migração de {item["label"]}.',
                }
            )

    (assets_out / "search-index.json").write_text(
        json.dumps(search_entries, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )

    total_pages = 5 + len(docs)
    print(
        f"Site gerado em {out_dir}: {total_pages} páginas HTML "
        f"(CASA v{casa_version}, {len(docs)} docs, {len(skills)} skills)."
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Compila o site estático do CASA Standard a partir das fontes canônicas."
    )
    parser.add_argument(
        "--root",
        default=str(Path(__file__).resolve().parent.parent),
        help="Raiz do repositório casa-standard (default: pai de scripts/).",
    )
    parser.add_argument(
        "--out",
        default="_site",
        help="Diretório de saída do site gerado (default: _site relativo ao CWD ou absoluto).",
    )
    parser.add_argument(
        "--base-url",
        default="https://atplus-digital.github.io/casa-standard/",
        help="URL pública canônica para tags OpenGraph e canonical.",
    )
    args = parser.parse_args()
    root = Path(args.root).resolve()
    out_dir = Path(args.out)
    if not out_dir.is_absolute():
        out_dir = (Path.cwd() / out_dir).resolve()
    return build_site(root, out_dir, args.base_url)


if __name__ == "__main__":
    sys.exit(main())
