"""


def build_doc_page(
    doc: dict[str, Any],
    by_id: dict[str, dict[str, Any]],
    doc_urls: dict[str, str],
    *,
    locale: str,
    counterpart_href: str,
) -> tuple[str, list[dict[str, Any]]]:
    is_pt = locale == "pt"
    lang_root = "../../"
    graph_slug = "grafo" if is_pt else "graph"
    renderer = MarkdownRenderer(
        doc_urls,
        lang_root,
        f'{slugify(doc["id"])}-{locale}',
        locale=locale,
        current_doc_id=doc["id"],
    )
    body_html, toc = renderer.render(doc["body"], skip_first_h1=True)

    none_lbl = "nenhum" if is_pt else "none"

    def render_ref_chips(ids: list[str]) -> str:
        if not ids:
            return f'<span style="color:var(--ink-muted);font-size:0.82rem;">{none_lbl}</span>'
        chips: list[str] = []
        for ref_id in ids:
            if ref_id in by_id:
                target = by_id[ref_id]
                href = f'{lang_root}{target["url"]}'
                chips.append(
                    f'<a class="doc-ref-chip" href="{html.escape(href, quote=True)}" '
                    f'title="{html.escape(target["title"], quote=True)}">{html.escape(ref_id)}</a>'
                )
            else:
                chips.append(f'<span class="doc-ref-chip">{html.escape(ref_id)}</span>')
        return "".join(chips)

    lbl_date = "Data" if is_pt else "Date"
    lbl_builds = "Fundamentado em (builds-on)" if is_pt else "Grounded in (builds-on)"
    lbl_cited = "Citado por (a jusante)" if is_pt else "Cited by (downstream)"
    lbl_deciders = "Decisores" if is_pt else "Deciders"
    lbl_sup_by = "Superado por" if is_pt else "Superseded by"
    lbl_supersedes = "Substitui" if is_pt else "Supersedes"
    lbl_impl_by = (
        "Implementado por (implemented-by)" if is_pt else "Implemented by (implemented-by)"
    )

    passport_cells: list[str] = [
        f'<div><span class="passport-key">Status</span><div class="passport-val">{status_badge(doc["status"])}</div></div>',
        f'<div><span class="passport-key">{lbl_date}</span><div class="passport-val" style="font-family:var(--font-mono);">{html.escape(doc["date"] or "—")}</div></div>',
        f'<div><span class="passport-key">{lbl_builds}</span><div class="passport-val">{render_ref_chips(doc["builds_on"])}</div></div>',
        f'<div><span class="passport-key">{lbl_cited}</span><div class="passport-val">{render_ref_chips(doc["cited_by"])}</div></div>',
    ]

    if doc["layer"] == "adr" and doc["deciders"]:
        dec_str = ", ".join(doc["deciders"])
        passport_cells.append(
            f'<div><span class="passport-key">{lbl_deciders}</span><div class="passport-val" style="font-family:var(--font-mono);">{html.escape(dec_str)}</div></div>'
        )

    if doc.get("superseded_by"):
        sup = str(doc["superseded_by"])
        passport_cells.append(
            f'<div><span class="passport-key">{lbl_sup_by}</span><div class="passport-val">{render_ref_chips([sup])}</div></div>'
        )

    if doc.get("supersedes"):
        passport_cells.append(
            f'<div><span class="passport-key">{lbl_supersedes}</span><div class="passport-val">{render_ref_chips(doc["supersedes"])}</div></div>'
        )

    if doc["layer"] == "specs" and doc["implemented_by"]:
        impl_links = "".join(
            f'<a class="doc-ref-chip" href="{GITHUB_REPO_URL}/blob/main/{html.escape(p, quote=True)}" '
            f'target="_blank" rel="noopener noreferrer">{html.escape(p)}</a>'
            for p in doc["implemented_by"]
        )
        passport_cells.append(
            f'<div style="grid-column: 1 / -1;"><span class="passport-key">{lbl_impl_by}</span>'
            f'<div class="passport-val">{impl_links}</div></div>'
        )

    src_url = f'{GITHUB_REPO_URL}/blob/main/{doc["path"]}'
    provenance_html = ""
    if doc.get("is_translated"):
        escaped_path = html.escape(doc["path"])
        escaped_src_url = html.escape(src_url, quote=True)
        escaped_counterpart = html.escape(counterpart_href, quote=True)
        if is_pt:
            provenance_html = (
                f'<div class="provenance-note" role="note">'
                f"<strong>Tradução de apresentação (PT-BR):</strong> "
                f'O registro canônico deste documento foi redigido em inglês (<a href="{escaped_src_url}" target="_blank" rel="noopener noreferrer">{escaped_path}</a> · '
                f'<a href="{escaped_counterpart}" lang="en">read canonical English</a>). '
                f"Em caso de divergência, prevalece o arquivo no repositório."
                f"</div>"
            )
        else:
            provenance_html = (
                f'<div class="provenance-note" role="note">'
                f"<strong>Presentation translation (EN):</strong> "
                f'This historical record is preserved untouched on disk in Brazilian Portuguese (<a href="{escaped_src_url}" target="_blank" rel="noopener noreferrer">{escaped_path}</a> · '
                f'<a href="{escaped_counterpart}" lang="pt-BR">ler original em PT-BR</a>). '
                f"Per CASA §5.1, the canonical file in git prevails in case of divergence."
                f"</div>"
            )

    truth_html = ""
    if doc.get("truth_callout"):
        truth_html = (
            f'<div class="truth-callout" role="note">'
            f'{renderer.render_inline(doc["truth_callout"])}'
            f"</div>"
        )

    layer_label = "Architecture Decision Record" if doc["layer"] == "adr" else "Specification"
    back_graph_lbl = "← Grafo" if is_pt else "← Graph"
    md_src_lbl = "Fonte Markdown" if is_pt else "Markdown Source"
    passport_aria = (
        "Metadados e conexões do documento"
        if is_pt
        else "Document metadata and causal links"
    )
    passport_joined = "".join(passport_cells)

    article_html = f"""
      <article class="prose">
        <div class="doc-meta-bar">
          <a href="{lang_root}{graph_slug}/" style="text-decoration:none;">{back_graph_lbl}</a>
          <span>·</span>
          <span>{html.escape(doc["id"])}</span>
          <span>·</span>
          <span>{layer_label}</span>
          <span>·</span>
          <a href="{html.escape(src_url, quote=True)}" target="_blank" rel="noopener noreferrer">{md_src_lbl}</a>
        </div>
        <h1>{html.escape(doc["title"])}</h1>
        {provenance_html}
        {truth_html}
        <div class="doc-Passport" aria-label="{passport_aria}">
          <div class="passport-grid">
            {passport_joined}
          </div>
        </div>
        {body_html}
      </article>
"""

    if len(toc) >= 2:
        sidebar = render_toc_sidebar(toc, "Seções" if is_pt else "On this page")
        return f'<div class="container doc-shell">{sidebar}{article_html}</div>', toc
    return f'<div class="doc-shell-single">{article_html}</div>', toc


def extract_standard_search_entries(standard_md: str, url_prefix: str = "") -> list[dict[str, str]]:
    cleaned = strip_comments_outside_fences(standard_md)
    lines = cleaned.splitlines()
    entries: list[dict[str, str]] = []
    used_ids: set[str] = set()
    cur_title = "CASA Standard"
    cur_id = ""
    cur_buf: list[str] = []
    in_fence = False
    fence_char = ""
    fence_len = 0

    def flush() -> None:
        if not cur_buf:
            return
        snippet = plain_text_from_md("\n".join(cur_buf), max_len=200)
        if snippet:
            url = f"{url_prefix}standard/#{cur_id}" if cur_id else f"{url_prefix}standard/"
            entries.append(
                {
                    "kind": "Standard",
                    "title": cur_title,
                    "url": url,
                    "body": snippet,
                }
            )
        cur_buf.clear()

    for line in lines:
        if not in_fence:
            m_f = FENCE_OPEN_RE.match(line)
            if m_f and not line.lstrip().startswith("\u200b"):
                in_fence = True
                fence_char = m_f.group(2)[0]
                fence_len = len(m_f.group(2))
                continue
            m_h = HEADING_RE.match(line)
            if m_h:
                lvl = len(m_h.group(1))
                raw_t = m_h.group(2).strip()
                if lvl in (2, 3):
                    flush()
                    cur_id = standard_heading_id(raw_t, used_ids)
                    cur_title = re.sub(r"`([^`]+)`", r"\1", raw_t)
                    continue
                if lvl == 1:
                    cur_title = raw_t
                    continue
            cur_buf.append(line)
        else:
            stripped = line.strip()
            if (
                not line.lstrip().startswith("\u200b")
                and stripped
                and all(ch == fence_char for ch in stripped)
                and len(stripped) >= fence_len
            ):
                in_fence = False
    flush()
    return entries


def render_locale_tree(
    *,
    locale: str,
    out_prefix: str,
    site_depth_base: int,
    standard_md: str,
    changelog_md: str,
    meta: dict[str, str],
    pillars: list[dict[str, str]],
    docs: list[dict[str, Any]],
    skills: list[dict[str, Any]],
    base_url: str,
    write_html_fn: Any,
) -> list[dict[str, str]]:
    is_pt = locale == "pt"
    casa_version = meta["version"]
    by_id = {d["id"]: d for d in docs}
    doc_urls = {d["id"]: d["url"] for d in docs}
    graph_slug = "grafo" if is_pt else "graph"

    def site_root_for(local_depth: int) -> str:
        total = site_depth_base + local_depth
        return "./" if total == 0 else "../" * total

    def lang_root_for(local_depth: int) -> str:
        return "./" if local_depth == 0 else "../" * local_depth

    # 1. Home page
    home_main = build_home_page(
        locale=locale,
        meta=meta,
        pillars=pillars,
        docs=docs,
        skills=skills,
        doc_urls=doc_urls,
    )
    write_html_fn(
        f"{out_prefix}index.html",
        render_shell(
            locale=locale,
            title=(
                f"CASA Standard v{casa_version} — Contexto, ADRs, Specs, Automação"
                if is_pt
                else f"CASA Standard v{casa_version} — Context, ADRs, Specs, Automation"
            ),
            description=(
                "Padrão aberto de workflow de desenvolvimento orientado a agentes de IA: "
                "contexto em camadas, ADRs imutáveis, Specs com DoD executável e validação determinística."
                if is_pt
                else "Open engineering workflow standard for AI coding agents: "
                "layered context, immutable ADRs, executable Spec DoDs, and deterministic CI validation."
            ),
            site_root=site_root_for(0),
            lang_root=lang_root_for(0),
            en_page_url="",
            pt_page_url="pt/",
            en_switch_href="../" if is_pt else "./",
            pt_switch_href="./" if is_pt else "./pt/",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="home",
            main_html=home_main,
        ),
    )

    # 2. STANDARD.md page
    std_renderer = MarkdownRenderer(
        doc_urls, lang_root_for(1), f"standard-{locale}", locale=locale
    )
    std_body_html, std_toc = std_renderer.render(standard_md, standard_ids=True)
    std_toc_lbl = "Sumário do Standard" if is_pt else "Standard Contents"
    std_meta_html = (
        f"<span>Tradução em português (referência canônica: <a href=\"../../standard/\" lang=\"en\">English STANDARD.md</a>)</span>"
        f"<span>·</span>"
        f'<span>Versão {html.escape(casa_version)}</span>'
        f"<span>·</span>"
        f'<a href="{GITHUB_REPO_URL}/blob/main/STANDARD.md" target="_blank" rel="noopener noreferrer">STANDARD.md no GitHub</a>'
        if is_pt
        else f"<span>Canonical normative specification</span>"
        f"<span>·</span>"
        f'<span>Version {html.escape(casa_version)}</span>'
        f"<span>·</span>"
        f'<a href="{GITHUB_REPO_URL}/blob/main/STANDARD.md" target="_blank" rel="noopener noreferrer">STANDARD.md on GitHub</a>'
    )
    std_main = (
        f'<div class="container doc-shell">'
        f"{render_toc_sidebar(std_toc, std_toc_lbl)}"
        f'<article class="prose">'
        f'<div class="doc-meta-bar">{std_meta_html}</div>'
        f"{std_body_html}"
        f"</article>"
        f"</div>"
    )
    write_html_fn(
        f"{out_prefix}standard/index.html",
        render_shell(
            locale=locale,
            title=f"STANDARD.md (v{casa_version}) — CASA Standard",
            description=(
                f"Especificação normativa completa do CASA Standard v{casa_version}: "
                "princípios, estrutura de repositório, camadas de contexto, ADRs, Specs e docs-check."
                if is_pt
                else f"Complete normative specification of CASA Standard v{casa_version}: "
                "principles, repository structure, layered context, ADRs, Specs, and docs-check."
            ),
            site_root=site_root_for(1),
            lang_root=lang_root_for(1),
            en_page_url="standard/",
            pt_page_url="pt/standard/",
            en_switch_href="../../standard/" if is_pt else "./",
            pt_switch_href="./" if is_pt else "../pt/standard/",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="standard",
            main_html=std_main,
        ),
    )

    # 3. Causal Graph Explorer (/graph/ for EN, /pt/grafo/ for PT)
    svg_html = build_causal_svg(docs, lang_root_for(1), locale)
    statuses_present = sorted({d["status"] for d in docs})
    all_status_lbl = "todos" if is_pt else "all"
    status_filter_btns = [
        f'<button type="button" class="filter-chip" data-filter-status="all" aria-pressed="true">{all_status_lbl}</button>'
    ] + [
        f'<button type="button" class="filter-chip" data-filter-status="{html.escape(st, quote=True)}" aria-pressed="false">{html.escape(st)}</button>'
        for st in statuses_present
    ]

    ledger_rows: list[str] = []
    for d in docs:
        up_chips = " ".join(
            f'<a class="doc-ref-chip" href="../{html.escape(by_id[p]["url"], quote=True)}">{html.escape(p)}</a>'
            for p in d["builds_on"]
            if p in by_id
        ) or '<span style="color:var(--ink-muted);">—</span>'
        down_chips = " ".join(
            f'<a class="doc-ref-chip" href="../{html.escape(by_id[c]["url"], quote=True)}">{html.escape(c)}</a>'
            for c in d["cited_by"]
            if c in by_id
        ) or '<span style="color:var(--ink-muted);">—</span>'
        search_hay = (
            f'{d["id"]} {d["title"]} {d["status"]} '
            f'{" ".join(d["builds_on"])} {" ".join(d["cited_by"])}'
        ).lower()
        d_id_esc = html.escape(d["id"], quote=True)
        d_layer_esc = html.escape(d["layer"], quote=True)
        d_status_esc = html.escape(d["status"], quote=True)
        d_url_esc = html.escape(d["url"], quote=True)
        d_title_esc = html.escape(d["title"])
        ledger_rows.append(
            f'<tr data-doc-id="{d_id_esc}" '
            f'data-layer="{d_layer_esc}" '
            f'data-status="{d_status_esc}" '
            f'data-search="{html.escape(search_hay, quote=True)}">'
            f'<td><a class="doc-ref-chip" href="../{d_url_esc}">{html.escape(d["id"])}</a></td>'
            f'<td><a href="../{d_url_esc}">{d_title_esc}</a></td>'
            f'<td>{status_badge(d["status"])}</td>'
            f"<td>{up_chips}</td>"
            f"<td>{down_chips}</td>"
            f"</tr>"
        )

    adr_total = sum(1 for d in docs if d["layer"] == "adr")
    spec_total = sum(1 for d in docs if d["layer"] == "specs")
    status_btns_html = "".join(status_filter_btns)
    ledger_rows_html = "".join(ledger_rows)

    if is_pt:
        graph_main = f"""
    <div class="container graph-page">
      <div class="prose prose-wide">
        <div class="doc-meta-bar">
          <span>docs/index.json</span>
          <span>·</span>
          <span id="graph-visible-count">{len(docs)} documento(s)</span>
        </div>
        <h1>Grafo causal de ADRs e Specs</h1>
        <p style="max-width:68ch;">
          Passe o cursor sobre qualquer nó para iluminar sua linhagem direta (<code>builds-on</code> e
          <code>superseded-by</code>) ou clique para abrir o documento completo com suas conexões reversas.
        </p>
      </div>

      <div class="graph-canvas-wrap">
        <div class="graph-legend">
          <span>Esquerda → Direita: decisões fundacionais (ADR) até contratos derivados (Spec)</span>
          <span>Linha tracejada: supersessão de ADR</span>
        </div>
        {svg_html}
      </div>

      <div class="filter-bar" role="region" aria-label="Filtros da tabela de documentos">
        <div class="filter-group" aria-label="Filtrar por camada">
          <button type="button" class="filter-chip" data-filter-layer="all" aria-pressed="true">Todas ({len(docs)})</button>
          <button type="button" class="filter-chip" data-filter-layer="adr" aria-pressed="false">ADRs ({adr_total})</button>
          <button type="button" class="filter-chip" data-filter-layer="specs" aria-pressed="false">Specs ({spec_total})</button>
        </div>
        <div class="filter-group" aria-label="Filtrar por status">
          {status_btns_html}
        </div>
        <input type="search" class="filter-input" id="graph-filter-input" placeholder="Filtrar por ID, título ou relação…" aria-label="Filtrar documentos por texto">
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Título</th>
              <th>Status</th>
              <th>Fundamentado em</th>
              <th>Citado por</th>
            </tr>
          </thead>
          <tbody id="graph-ledger-body">
            {ledger_rows_html}
          </tbody>
        </table>
      </div>

      <div class="empty-state" id="graph-empty-state" hidden>
        <p>Nenhum ADR ou Spec corresponde aos filtros selecionados.</p>
        <button type="button" class="btn btn-secondary" id="graph-reset-btn">Limpar filtros</button>
      </div>
    </div>
"""
    else:
        graph_main = f"""
    <div class="container graph-page">
      <div class="prose prose-wide">
        <div class="doc-meta-bar">
          <span>docs/index.json</span>
          <span>·</span>
          <span id="graph-visible-count">{len(docs)} document(s)</span>
        </div>
        <h1>Causal Graph of ADRs &amp; Specs</h1>
        <p style="max-width:68ch;">
          Hover or focus any node to highlight its direct lineage (<code>builds-on</code> and
          <code>superseded-by</code>), or click through to read the full record with reverse downstream links.
        </p>
      </div>

      <div class="graph-canvas-wrap">
        <div class="graph-legend">
          <span>Left → Right: foundational decisions (ADR) through derived contracts (Spec)</span>
          <span>Dashed edge: ADR supersession</span>
        </div>
        {svg_html}
      </div>

      <div class="filter-bar" role="region" aria-label="Document table filters">
        <div class="filter-group" aria-label="Filter by layer">
          <button type="button" class="filter-chip" data-filter-layer="all" aria-pressed="true">All ({len(docs)})</button>
          <button type="button" class="filter-chip" data-filter-layer="adr" aria-pressed="false">ADRs ({adr_total})</button>
          <button type="button" class="filter-chip" data-filter-layer="specs" aria-pressed="false">Specs ({spec_total})</button>
        </div>
        <div class="filter-group" aria-label="Filter by status">
          {status_btns_html}
        </div>
        <input type="search" class="filter-input" id="graph-filter-input" placeholder="Filter by ID, title, or relation…" aria-label="Filter documents by text">
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Title</th>
              <th>Status</th>
              <th>Grounded in</th>
              <th>Cited by</th>
            </tr>
          </thead>
          <tbody id="graph-ledger-body">
            {ledger_rows_html}
          </tbody>
        </table>
      </div>

      <div class="empty-state" id="graph-empty-state" hidden>
        <p>No ADR or Spec matches the active filters.</p>
        <button type="button" class="btn btn-secondary" id="graph-reset-btn">Reset filters</button>
      </div>
    </div>
"""

    write_html_fn(
        f"{out_prefix}{graph_slug}/index.html",
        render_shell(
            locale=locale,
            title=(
                "Grafo de ADRs e Specs — CASA Standard"
                if is_pt
                else "ADRs & Specs Causal Graph — CASA Standard"
            ),
            description=(
                "Explorador interativo do grafo causal de decisões arquiteturais (ADRs) e especificações (Specs) do CASA Standard."
                if is_pt
                else "Interactive causal graph explorer of CASA Standard Architecture Decision Records (ADRs) and Specifications (Specs)."
            ),
            site_root=site_root_for(1),
            lang_root=lang_root_for(1),
            en_page_url="graph/",
            pt_page_url="pt/grafo/",
            en_switch_href="../../graph/" if is_pt else "./",
            pt_switch_href="./" if is_pt else "../pt/grafo/",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="graph",
            main_html=graph_main,
        ),
    )

    # 4. Individual ADR & Spec pages
    for d in docs:
        d_url = d["url"]
        en_sw = f"../../../{d_url}" if is_pt else "./"
        pt_sw = "./" if is_pt else f"../../pt/{d_url}"
        counterpart = en_sw if is_pt else pt_sw
        doc_main, _ = build_doc_page(
            d,
            by_id,
            doc_urls,
            locale=locale,
            counterpart_href=counterpart,
        )
        write_html_fn(
            f"{out_prefix}{d_url}index.html",
            render_shell(
                locale=locale,
                title=f'{d["id"]} · {d["title"]} — CASA Standard',
                description=f'{d["id"]} ({d["status"]}): {d["title"]}',
                site_root=site_root_for(2),
                lang_root=lang_root_for(2),
                en_page_url=d_url,
                pt_page_url=f"pt/{d_url}",
                en_switch_href=en_sw,
                pt_switch_href=pt_sw,
                base_url=base_url,
                casa_version=casa_version,
                total_docs=len(docs),
                total_skills=len(skills),
                active_nav="graph",
                main_html=doc_main,
            ),
        )

    # 5. Skills catalog
    total_desc_chars = sum(sk["desc_chars"] for sk in skills)
    skills_toc: list[dict[str, Any]] = []
    skill_cards: list[str] = []
    for idx, sk in enumerate(skills):
        sk_id = sk["name"]
        skills_toc.append({"id": sk_id, "level": 2, "label": f"0{idx + 1}. {sk_id}"})
        sk_renderer = MarkdownRenderer(
            doc_urls, lang_root_for(1), f"{sk_id}-{locale}", locale=locale
        )
        sk_body_html, _ = sk_renderer.render(
            sk["body"], skip_first_h1=True, heading_offset=1
        )
        src_href = f'{GITHUB_REPO_URL}/blob/main/{sk["path"]}'
        skill_cards.append(
            f'<section class="skill-section" id="{html.escape(sk_id, quote=True)}">'
            f'<div class="skill-section-head">'
            f'<h2 style="margin:0;border:none;padding:0;">'
            f'<span style="font-family:var(--font-mono);font-size:0.85rem;color:var(--accent);margin-right:0.5rem;">0{idx + 1}</span>'
            f'{html.escape(sk_id)} <span style="color:var(--ink-muted);font-weight:400;">— {html.escape(sk["title"])}</span>'
            f"</h2>"
            f'<span style="font-family:var(--font-mono);font-size:0.75rem;color:var(--ink-muted);">'
            f'{sk["desc_chars"]} chars · <a href="{html.escape(src_href, quote=True)}" target="_blank" rel="noopener noreferrer">SKILL.md</a>'
            f"</span>"
            f"</div>"
            f'<div class="skill-desc-box"><strong>Trigger / description:</strong> {html.escape(sk["description"])}</div>'
            f"{sk_body_html}"
            f"</section>"
        )

    skills_intro_renderer = MarkdownRenderer(
        doc_urls, lang_root_for(1), f"skills-intro-{locale}", locale=locale
    )
    if is_pt:
        skills_intro_p = skills_intro_renderer.render_inline(
            "Distribuídas pelo `casa-init` em repositórios T1 para `.agents/skills/` e `.claude/skills/` "
            "(ADR-0017, SPEC-0010). No CASA 1.11+, os arquivos `SKILL.md` canônicos instalados no adotante são em inglês; "
            "abaixo apresentamos a tradução em português de cada procedimento."
        )
        skills_toc_lbl = "Ciclo §9"
        skills_meta_1 = "Formato Agent Skills"
        skills_meta_3 = f"Orçamento somado de descriptions: {total_desc_chars} caracteres"
        skills_h1 = "Agent Skills do ciclo de entrega"
    else:
        skills_intro_p = skills_intro_renderer.render_inline(
            "Distributed by `casa-init` in T1 repositories into `.agents/skills/` and `.claude/skills/` "
            "(ADR-0017, SPEC-0010). Each skill is self-contained, points to the `STANDARD.md` pinned in the "
            "adopter's `casa-standard-ref`, and stays within a tight launch description budget."
        )
        skills_toc_lbl = "§9 Cycle"
        skills_meta_1 = "Agent Skills format"
        skills_meta_3 = f"Combined description budget: {total_desc_chars} chars"
        skills_h1 = "Delivery-cycle Agent Skills"

    skill_cards_html = "".join(skill_cards)
    skills_main = (
        f'<div class="container doc-shell">'
        f"{render_toc_sidebar(skills_toc, skills_toc_lbl)}"
        f'<div class="prose prose-wide">'
        f'<div class="doc-meta-bar">'
        f"<span>{skills_meta_1}</span>"
        f"<span>·</span>"
        f"<span>{len(skills)} skills</span>"
        f"<span>·</span>"
        f"<span>{skills_meta_3}</span>"
        f"</div>"
        f"<h1>{skills_h1}</h1>"
        f'<p style="max-width:68ch;">{skills_intro_p}</p>'
        f"{skill_cards_html}"
        f"</div>"
        f"</div>"
    )
    write_html_fn(
        f"{out_prefix}skills/index.html",
        render_shell(
            locale=locale,
            title="Agent Skills (casa-*) — CASA Standard",
            description=(
                "Catálogo completo das 5 Agent Skills oficiais do CASA Standard: casa-explore, casa-propose, casa-apply, casa-verify e casa-close."
                if is_pt
                else "Complete catalog of the 5 official CASA Standard Agent Skills: casa-explore, casa-propose, casa-apply, casa-verify, and casa-close."
            ),
            site_root=site_root_for(1),
            lang_root=lang_root_for(1),
            en_page_url="skills/",
            pt_page_url="pt/skills/",
            en_switch_href="../../skills/" if is_pt else "./",
            pt_switch_href="./" if is_pt else "../pt/skills/",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="skills",
            main_html=skills_main,
        ),
    )

    # 6. Changelog page
    chg_renderer = MarkdownRenderer(
        doc_urls, lang_root_for(1), f"changelog-{locale}", locale=locale
    )
    chg_body_html, chg_toc = chg_renderer.render(changelog_md, skip_first_h1=True)
    chg_toc_lbl = "Versões" if is_pt else "Releases"
    chg_meta_1 = "Histórico de contrato" if is_pt else "Contract history"
    chg_gh_lbl = "CHANGELOG.md no GitHub" if is_pt else "CHANGELOG.md on GitHub"
    chg_h1 = "Changelog do contrato CASA" if is_pt else "CASA Contract Changelog"
    chg_main = (
        f'<div class="container doc-shell">'
        f"{render_toc_sidebar(chg_toc, chg_toc_lbl)}"
        f'<article class="prose">'
        f'<div class="doc-meta-bar">'
        f"<span>{chg_meta_1}</span>"
        f"<span>·</span>"
        f'<a href="{GITHUB_REPO_URL}/blob/main/CHANGELOG.md" target="_blank" rel="noopener noreferrer">{chg_gh_lbl}</a>'
        f"</div>"
        f"<h1>{chg_h1}</h1>"
        f"{chg_body_html}"
        f"</article>"
        f"</div>"
    )
    write_html_fn(
        f"{out_prefix}changelog/index.html",
        render_shell(
            locale=locale,
            title="Changelog — CASA Standard",
            description=(
                "Histórico completo de versões e evolução do contrato normativo do CASA Standard."
                if is_pt
                else "Complete release history and migration notes for the normative CASA Standard contract."
            ),
            site_root=site_root_for(1),
            lang_root=lang_root_for(1),
            en_page_url="changelog/",
            pt_page_url="pt/changelog/",
            en_switch_href="../../changelog/" if is_pt else "./",
            pt_switch_href="./" if is_pt else "../pt/changelog/",
            base_url=base_url,
            casa_version=casa_version,
            total_docs=len(docs),
            total_skills=len(skills),
            active_nav="changelog",
            main_html=chg_main,
        ),
    )

    # 7. Build search index entries (URLs relative to _site/ root)
    search_entries: list[dict[str, str]] = []
    search_entries.extend(extract_standard_search_entries(standard_md, url_prefix=out_prefix))
    for d in docs:
        search_entries.append(
            {
                "kind": d["id"],
                "title": f'{d["id"]} · {d["title"]}',
                "url": f'{out_prefix}{d["url"]}',
                "body": f'[{d["status"]}] ' + plain_text_from_md(d["body"], max_len=190),
            }
        )
    for sk in skills:
        search_entries.append(
            {
                "kind": "Skill",
                "title": f'{sk["name"]} — {sk["title"]}',
                "url": f'{out_prefix}skills/#{sk["name"]}',
                "body": sk["description"],
            }
        )
    for item in chg_toc:
        if item["level"] == 2:
            chg_body_note = (
                f'Notas de versão e migração de {item["label"]}.'
                if is_pt
                else f'Release and migration notes for {item["label"]}.'
            )
            search_entries.append(
                {
                    "kind": "Changelog",
                    "title": item["label"],
                    "url": f'{out_prefix}changelog/#{item["id"]}',
                    "body": chg_body_note,
                }
            )
    return search_entries


def extract_standard_heading_ids(standard_md: str) -> list[str]:
    cleaned = strip_comments_outside_fences(standard_md)
    used_ids: set[str] = set()
    ids: list[str] = []
    in_fence = False
    fence_char = ""
    fence_len = 0
    for line in cleaned.splitlines():
        if not in_fence:
            m_f = FENCE_OPEN_RE.match(line)
            if m_f and not line.lstrip().startswith("\u200b"):
                in_fence = True
                fence_char = m_f.group(2)[0]
                fence_len = len(m_f.group(2))
                continue
            m_h = HEADING_RE.match(line)
            if m_h and len(m_h.group(1)) >= 2:
                ids.append(standard_heading_id(m_h.group(2).strip(), used_ids))
        else:
            stripped = line.strip()
            if (
                not line.lstrip().startswith("\u200b")
                and stripped
                and all(ch == fence_char for ch in stripped)
                and len(stripped) >= fence_len
            ):
                in_fence = False
    return ids


def build_site(root: Path, out_dir: Path, base_url: str) -> int:
    standard_en_path = root / "STANDARD.md"
    readme_en_path = root / "README.md"
    changelog_en_path = root / "CHANGELOG.md"
    site_dir = root / "site"
    i18n_en_docs_path = site_dir / "i18n" / "en" / "docs.json"
    i18n_pt_dir = site_dir / "i18n" / "pt"
    standard_pt_path = i18n_pt_dir / "STANDARD.md"
    changelog_pt_path = i18n_pt_dir / "CHANGELOG.md"
    pillars_pt_path = i18n_pt_dir / "pillars.json"
    skills_pt_path = i18n_pt_dir / "skills.json"
    i18n_pt_docs_path = i18n_pt_dir / "docs.json"

    for required in (
        standard_en_path,
        readme_en_path,
        changelog_en_path,
        root / "docs" / "index.json",
        site_dir / "style.css",
        site_dir / "app.js",
        site_dir / "favicon.svg",
        i18n_en_docs_path,
        standard_pt_path,
        changelog_pt_path,
        pillars_pt_path,
        skills_pt_path,
        i18n_pt_docs_path,
    ):
        if not required.exists():
            print(f"ERROR: missing required source file: {required}", file=sys.stderr)
            return 1

    standard_en_md = standard_en_path.read_text(encoding="utf-8")
    readme_en_md = readme_en_path.read_text(encoding="utf-8")
    changelog_en_md = changelog_en_path.read_text(encoding="utf-8")

    standard_pt_md = standard_pt_path.read_text(encoding="utf-8")
    changelog_pt_md = changelog_pt_path.read_text(encoding="utf-8")

    try:
        en_docs_i18n: dict[str, Any] = json.loads(i18n_en_docs_path.read_text(encoding="utf-8"))
        pt_docs_i18n: dict[str, Any] = json.loads(i18n_pt_docs_path.read_text(encoding="utf-8"))
        pillars_pt: list[dict[str, str]] = json.loads(pillars_pt_path.read_text(encoding="utf-8"))
        pt_skills_map: dict[str, Any] = json.loads(skills_pt_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        print(f"ERROR: invalid JSON in site/i18n/: {exc}", file=sys.stderr)
        return 1

    # Structural i18n parity gates (SPEC-0012 case 9)
    en_std_ids = extract_standard_heading_ids(standard_en_md)
    pt_std_ids = extract_standard_heading_ids(standard_pt_md)
    if en_std_ids != pt_std_ids:
        print(
            f"ERROR: STANDARD.md section IDs diverge from site/i18n/pt/STANDARD.md: "
            f"en={en_std_ids} vs pt={pt_std_ids}",
            file=sys.stderr,
        )
        return 1

    en_chg_vers = CHANGELOG_VER_RE.findall(changelog_en_md)
    pt_chg_vers = CHANGELOG_VER_RE.findall(changelog_pt_md)
    if en_chg_vers != pt_chg_vers:
        print(
            f"ERROR: CHANGELOG.md versions diverge from site/i18n/pt/CHANGELOG.md: "
            f"en={en_chg_vers} vs pt={pt_chg_vers}",
            file=sys.stderr,
        )
        return 1

    meta_en = parse_standard_metadata(standard_en_md, locale="en")
    meta_pt = parse_standard_metadata(standard_pt_md, locale="pt")
    # Version in STANDARD.md is authoritative across both locales
    meta_pt["version"] = meta_en["version"]

    pillars_en = parse_readme_pillars(readme_en_md)
    canonical_docs = load_canonical_docs(root)
    skills_en = load_skills(root)

    try:
        docs_en = localize_docs(canonical_docs, "en", en_docs_i18n, pt_docs_i18n)
        docs_pt = localize_docs(canonical_docs, "pt", en_docs_i18n, pt_docs_i18n)
        skills_pt = load_pt_skills(skills_en, pt_skills_map)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1

    if out_dir.exists():
        shutil.rmtree(out_dir)
    assets_out = out_dir / "assets"
    assets_out.mkdir(parents=True, exist_ok=True)

    for asset_name in ("style.css", "app.js", "favicon.svg"):
        shutil.copyfile(site_dir / asset_name, assets_out / asset_name)

    (out_dir / ".nojekyll").write_text("", encoding="utf-8", newline="\n")

    def write_html(rel_file: str, content: str) -> None:
        target = out_dir / rel_file
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content, encoding="utf-8", newline="\n")

    search_en = render_locale_tree(
        locale="en",
        out_prefix="",
        site_depth_base=0,
        standard_md=standard_en_md,
        changelog_md=changelog_en_md,
        meta=meta_en,
        pillars=pillars_en,
        docs=docs_en,
        skills=skills_en,
        base_url=base_url,
        write_html_fn=write_html,
    )

    search_pt = render_locale_tree(
        locale="pt",
        out_prefix="pt/",
        site_depth_base=1,
        standard_md=standard_pt_md,
        changelog_md=changelog_pt_md,
        meta=meta_pt,
        pillars=pillars_pt,
        docs=docs_pt,
        skills=skills_pt,
        base_url=base_url,
        write_html_fn=write_html,
    )

    # Compatibility redirect stub at /grafo/index.html -> ../graph/ (SPEC-0012 case 6)
    redirect_main = """
    <div class="doc-shell-single">
      <article class="prose">
        <h1>Redirecting to Causal Graph…</h1>
        <p>
          The English causal graph lives at <a href="../graph/">./graph/</a>.
          Looking for Brazilian Portuguese? Open <a href="../pt/grafo/" lang="pt-BR">./pt/grafo/</a>.
        </p>
      </article>
    </div>
    <script>
      window.location.replace("../graph/" + (window.location.hash || ""));
    </script>
"""
    write_html(
        "grafo/index.html",
        render_shell(
            locale="en",
            title="Redirecting to Causal Graph — CASA Standard",
            description="Compatibility redirect from legacy /grafo/ route to /graph/ (and /pt/grafo/ for Portuguese).",
            site_root="../",
            lang_root="../",
            en_page_url="graph/",
            pt_page_url="pt/grafo/",
            en_switch_href="../graph/",
            pt_switch_href="../pt/grafo/",
            base_url=base_url,
            casa_version=meta_en["version"],
            total_docs=len(docs_en),
            total_skills=len(skills_en),
            active_nav="graph",
            main_html=redirect_main,
            extra_head='\n  <meta http-equiv="refresh" content="0; url=../graph/">',
        ),
    )

    (assets_out / "search-index.en.json").write_text(
        json.dumps(search_en, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    (assets_out / "search-index.pt.json").write_text(
        json.dumps(search_pt, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )

    total_pages = 2 * (5 + len(docs_en)) + 1
    print(
        f"Site built in {out_dir}: {total_pages} HTML pages across EN (/) and PT-BR (/pt/) "
        f"(CASA v{meta_en['version']}, {len(docs_en)} docs, {len(skills_en)} skills)."
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Compiles the bilingual CASA Standard static site from canonical sources."
    )
    parser.add_argument(
        "--root",
        default=str(Path(__file__).resolve().parent.parent),
        help="Root of the casa-standard repository (default: parent of scripts/).",
    )
    parser.add_argument(
        "--out",
        default="_site",
        help="Output directory for the generated site (default: _site relative to CWD or absolute).",
    )
    parser.add_argument(
        "--base-url",
        default="https://atplus-digital.github.io/casa-standard/",
        help="Canonical public URL used for canonical, hreflang, and OpenGraph tags.",
    )
    args = parser.parse_args()
    root = Path(args.root).resolve()
    out_dir = Path(args.out)
    if not out_dir.is_absolute():
        out_dir = (Path.cwd() / out_dir).resolve()
    return build_site(root, out_dir, args.base_url)


if __name__ == "__main__":
    sys.exit(main())
