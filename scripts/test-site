ck "SPEC-0011/7: search and graph empty-states show and clear cleanly in both EN and PT-BR (ADR-0014)" '
python3 - "$OUT1" << "PY"
import pathlib, shutil, subprocess, sys
site = pathlib.Path(sys.argv[1])
for gp in ("graph/index.html", "pt/grafo/index.html"):
    txt = (site / gp).read_text(encoding="utf-8")
    assert "id=\"graph-empty-state\" hidden" in txt, f"missing graph-empty-state in {gp}"
    assert "id=\"graph-reset-btn\"" in txt, f"missing graph-reset-btn in {gp}"
    assert "id=\"search-empty-state\" hidden" in txt, f"missing search-empty-state in {gp}"
    assert "id=\"search-clear-btn\"" in txt, f"missing search-clear-btn in {gp}"

node_bin = shutil.which("node")
if node_bin:
    harness = """
const fs = require("fs");
const vm = require("vm");
const code = fs.readFileSync(process.argv[1], "utf8");
const sidx = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const lang = process.argv[3];

function el(id, attrs = {}) {
  const listeners = {};
  return {
    id,
    tagName: "DIV",
    hidden: !!attrs.hidden,
    value: attrs.value || "",
    textContent: "",
    innerHTML: "",
    children: [],
    classList: { add(){}, remove(){}, toggle(){ return true; } },
    getAttribute(k) { return Object.prototype.hasOwnProperty.call(attrs, k) ? attrs[k] : null; },
    setAttribute(k, v) { attrs[k] = v; },
    removeAttribute(k) { delete attrs[k]; },
    appendChild(c) { this.children.push(c); },
    addEventListener(ev, fn) { (listeners[ev] = listeners[ev] || []).push(fn); },
    trigger(ev, payload = {}) { (listeners[ev] || []).forEach(fn => fn(payload)); },
    querySelectorAll() { return []; },
    focus() {}
  };
}

const row1 = el("r1", { "data-doc-id": "ADR-0001", "data-layer": "adr", "data-status": "superseded", "data-search": "adr-0001 gate" });
const graphTable = el("graph-ledger-body");
graphTable.querySelectorAll = () => [row1];
const filterInput = el("graph-filter-input");
const graphEmpty = el("graph-empty-state", { hidden: true });
const resetBtn = el("graph-reset-btn");
const countLabel = el("graph-visible-count");
const searchOpenBtn = el("search-open-btn");
const searchBackdrop = el("search-backdrop", { hidden: true });
const searchInput = el("search-modal-input");
const searchResults = el("search-results-list");
const searchEmpty = el("search-empty-state", { hidden: true });
const searchClearBtn = el("search-clear-btn");
const themeBtn = el("theme-toggle-btn");
const rootEl = el("html", { "lang": lang, "data-site-root": "./", "data-search-index": "./assets/search-index.json", "data-theme": "light" });
const store = {};

const byId = {
  "graph-ledger-body": graphTable,
  "graph-filter-input": filterInput,
  "graph-empty-state": graphEmpty,
  "graph-reset-btn": resetBtn,
  "graph-visible-count": countLabel,
  "search-open-btn": searchOpenBtn,
  "search-backdrop": searchBackdrop,
  "search-modal-input": searchInput,
  "search-results-list": searchResults,
  "search-empty-state": searchEmpty,
  "search-clear-btn": searchClearBtn,
  "theme-toggle-btn": themeBtn
};

const ctx = {
  document: {
    documentElement: rootEl,
    getElementById: (id) => byId[id] || null,
    querySelectorAll: () => [],
    createElement: (t) => el(t),
    addEventListener: () => {}
  },
  window: { setTimeout: (fn) => fn(), location: { href: "" } },
  localStorage: { setItem: (k, v) => { store[k] = v; }, getItem: (k) => store[k] || null },
  navigator: { clipboard: { writeText: () => Promise.resolve() } },
  fetch: () => Promise.resolve({ json: () => Promise.resolve(sidx) }),
  Promise, Set, Map, Array
};
vm.runInNewContext(code, ctx);

filterInput.value = "non-existent-query-xyz-999";
filterInput.trigger("input");
if (graphEmpty.hidden !== false || row1.hidden !== true) process.exit(11);
const expectedUnit = lang === "pt-BR" ? "0 documento(s)" : "0 document(s)";
if (countLabel.textContent !== expectedUnit) process.exit(16);
resetBtn.trigger("click");
if (graphEmpty.hidden !== true || row1.hidden !== false || filterInput.value !== "") process.exit(12);

themeBtn.trigger("click");
if (rootEl.getAttribute("data-theme") !== "dark" || store["casa-theme"] !== "dark") process.exit(13);

searchOpenBtn.trigger("click");
setImmediate(() => {
  searchInput.value = "non-existent-query-xyz-999";
  searchInput.trigger("input");
  if (searchEmpty.hidden !== false) process.exit(14);
  searchClearBtn.trigger("click");
  if (searchEmpty.hidden !== true || searchInput.value !== "") process.exit(15);
});
"""
    subprocess.run(
        [node_bin, "-e", harness, str(site / "assets/app.js"), str(site / "assets/search-index.en.json"), "en"],
        check=True,
    )
    subprocess.run(
        [node_bin, "-e", harness, str(site / "assets/app.js"), str(site / "assets/search-index.pt.json"), "pt-BR"],
        check=True,
    )
PY
'

ck "SPEC-0011/8: light/dark theme toggle, valid copy targets, and syntactically valid JS across all pages" '
python3 - "$OUT1" << "PY"
import pathlib, subprocess, shutil, sys
from html.parser import HTMLParser

site = pathlib.Path(sys.argv[1])
css = (site / "assets/style.css").read_text(encoding="utf-8")
assert "[data-theme=\"light\"]" in css and "[data-theme=\"dark\"]" in css, "missing light/dark theme tokens"

class CopyCheck(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = set()
        self.targets = []
        self.has_theme_btn = False
    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if "id" in d:
            self.ids.add(d["id"])
            if d["id"] == "theme-toggle-btn":
                self.has_theme_btn = True
        if "data-copy-target" in d:
            self.targets.append(d["data-copy-target"])

for f in sorted(site.rglob("*.html")):
    txt = f.read_text(encoding="utf-8")
    assert "localStorage.getItem(\"casa-theme\")" in txt, f"{f}: missing flash-free theme init"
    c = CopyCheck()
    c.feed(txt)
    assert c.has_theme_btn, f"{f}: missing #theme-toggle-btn"
    for t in c.targets:
        assert t in c.ids, f"{f}: data-copy-target={t} points to non-existent id"

node_bin = shutil.which("node")
if node_bin:
    subprocess.run([node_bin, "--check", str(site / "assets/app.js")], check=True)
PY
'

# ── SPEC-0011/9: Byte-for-byte determinism across two consecutive builds ──
OUT2="$TMP/site2"
python3 "$BUILD" --root "$ROOT" --out "$OUT2" >/dev/null 2>&1
ck "SPEC-0011/9: two consecutive builds produce byte-for-byte identical _site trees" '
python3 - "$OUT1" "$OUT2" << "PY"
import hashlib, pathlib, sys

def manifest(base: pathlib.Path) -> dict[str, str]:
    res = {}
    for p in sorted(base.rglob("*")):
        if p.is_file():
            res[str(p.relative_to(base))] = hashlib.sha256(p.read_bytes()).hexdigest()
    return res

m1 = manifest(pathlib.Path(sys.argv[1]))
m2 = manifest(pathlib.Path(sys.argv[2]))
assert m1 == m2, "non-deterministic build output"
PY
'

# ── SPEC-0011/2 + SPEC-0011/11: Dynamic derivation without hardcoding + docs-check compatibility ──
FIX="$TMP/repo-copy"
mkdir -p "$FIX"
(cd "$ROOT" && tar --exclude='.git' --exclude='_site' -cf - .) | (cd "$FIX" && tar -xf -)
git -C "$FIX" init -q
git -C "$FIX" config user.email "test@example.com"
git -C "$FIX" config user.name "Test"

python3 - "$FIX" << 'PY'
import json, pathlib, re, sys
fix = pathlib.Path(sys.argv[1])
std_p = fix / "STANDARD.md"
std_txt = std_p.read_text(encoding="utf-8")
std_p.write_text(re.sub(r"\*\*CASA Version:\*\*\s*[0-9.]+", "**CASA Version:** 9.42", std_txt, count=1), encoding="utf-8")

adr99 = fix / "docs/adr/0099-synthetic-dynamic-derivation.md"
adr99.write_text(
    "---\nstatus: accepted\ndate: 2026-11-19\nbuilds-on: [ADR-0004]\nsuperseded-by: null\ndeciders: [maicon]\n---\n\n"
    "# Synthetic decision proving dynamic derivation\n\n## Context and Problem\n\nTest.\n\n## Decision\n\nOk.\n\n## Confirmation\n\n```bash\ntrue\n```\n",
    encoding="utf-8",
)

pt_docs_p = fix / "site/i18n/pt/docs.json"
pt_docs = json.loads(pt_docs_p.read_text(encoding="utf-8"))
pt_docs["ADR-0099"] = {
    "title": "Decisão sintética provando derivação dinâmica",
    "truth_callout": None,
    "body": "# Decisão sintética provando derivação dinâmica\n\n## Contexto e problema\n\nTeste.\n",
}
pt_docs_p.write_text(json.dumps(pt_docs, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
python3 "$FIX/scripts/docs-check" --root "$FIX" --emit-index >/dev/null 2>&1
python3 "$FIX/scripts/build-site" --root "$FIX" --out "$FIX/_site" >/dev/null 2>&1; RC_DYN=$?

ck "SPEC-0011/2: updating version in STANDARD.md and adding an ADR propagates to EN and PT-BR pages and search indices" '
    [ "$RC_DYN" -eq 0 ] &&
    grep -q "v9.42" "$FIX/_site/index.html" &&
    grep -q "Version 9.42" "$FIX/_site/standard/index.html" &&
    grep -q "v9.42" "$FIX/_site/pt/index.html" &&
    grep -q "Versão 9.42" "$FIX/_site/pt/standard/index.html" &&
    [ -f "$FIX/_site/adr/0099-synthetic-dynamic-derivation/index.html" ] &&
    [ -f "$FIX/_site/pt/adr/0099-synthetic-dynamic-derivation/index.html" ] &&
    grep -q "ADR-0099" "$FIX/_site/graph/index.html" &&
    grep -q "ADR-0099" "$FIX/_site/pt/grafo/index.html" &&
    grep -q "ADR-0099" "$FIX/_site/assets/search-index.en.json" &&
    grep -q "ADR-0099" "$FIX/_site/assets/search-index.pt.json"
'

# ── SPEC-0012/9: CI Translation Parity gates fail build-site when i18n diverges ──
# 9a: New canonical EN doc missing from site/i18n/pt/docs.json
python3 - "$FIX" << 'PY'
import json, pathlib, sys
fix = pathlib.Path(sys.argv[1])
pt_docs_p = fix / "site/i18n/pt/docs.json"
pt_docs = json.loads(pt_docs_p.read_text(encoding="utf-8"))
del pt_docs["ADR-0099"]
pt_docs_p.write_text(json.dumps(pt_docs, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
OUT_ERR_PT="$(python3 "$FIX/scripts/build-site" --root "$FIX" --out "$TMP/fail-pt-doc" 2>&1)"; RC_ERR_PT=$?
ck "SPEC-0012/9a: missing PT-BR translation for EN doc fails build-site" '
    [ "$RC_ERR_PT" -ne 0 ] && echo "$OUT_ERR_PT" | grep -q "ADR-0099"
'

# 9b: Historical PT-BR doc missing from site/i18n/en/docs.json
FIX_PARITY="$TMP/repo-parity"
mkdir -p "$FIX_PARITY"
(cd "$ROOT" && tar --exclude='.git' --exclude='_site' -cf - .) | (cd "$FIX_PARITY" && tar -xf -)
python3 - "$FIX_PARITY" << 'PY'
import json, pathlib, sys
fix = pathlib.Path(sys.argv[1])
en_docs_p = fix / "site/i18n/en/docs.json"
en_docs = json.loads(en_docs_p.read_text(encoding="utf-8"))
saved = en_docs.pop("ADR-0001")
en_docs_p.write_text(json.dumps(en_docs, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
(fix / "_saved_adr1.json").write_text(json.dumps(saved), encoding="utf-8")
PY
OUT_ERR_EN="$(python3 "$FIX_PARITY/scripts/build-site" --root "$FIX_PARITY" --out "$TMP/fail-en-doc" 2>&1)"; RC_ERR_EN=$?
ck "SPEC-0012/9b: missing EN translation for historical PT-BR doc fails build-site" '
    [ "$RC_ERR_EN" -ne 0 ] && echo "$OUT_ERR_EN" | grep -q "ADR-0001"
'

# Restore ADR-0001 and test STANDARD.md heading divergence, CHANGELOG divergence, and missing skill translation
python3 - "$FIX_PARITY" << 'PY'
import json, pathlib, sys
fix = pathlib.Path(sys.argv[1])
en_docs_p = fix / "site/i18n/en/docs.json"
en_docs = json.loads(en_docs_p.read_text(encoding="utf-8"))
en_docs["ADR-0001"] = json.loads((fix / "_saved_adr1.json").read_text(encoding="utf-8"))
en_docs_p.write_text(json.dumps(en_docs, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
(fix / "_saved_adr1.json").unlink()
(fix / "STANDARD.md").write_text((fix / "STANDARD.md").read_text(encoding="utf-8") + "\n## 11. Untranslated section\n\nText.\n", encoding="utf-8")
PY
OUT_ERR_STD="$(python3 "$FIX_PARITY/scripts/build-site" --root "$FIX_PARITY" --out "$TMP/fail-std" 2>&1)"; RC_ERR_STD=$?
ck "SPEC-0012/9c: STANDARD.md section divergence from site/i18n/pt/STANDARD.md fails build-site" '
    [ "$RC_ERR_STD" -ne 0 ] && echo "$OUT_ERR_STD" | grep -q "STANDARD.md"
'

cp "$ROOT/STANDARD.md" "$FIX_PARITY/STANDARD.md"
python3 - "$FIX_PARITY" << 'PY'
import pathlib, sys
fix = pathlib.Path(sys.argv[1])
(fix / "CHANGELOG.md").write_text("## CASA 9.99 — 2099-01-01\n\n- Test.\n\n" + (fix / "CHANGELOG.md").read_text(encoding="utf-8"), encoding="utf-8")
PY
OUT_ERR_CHG="$(python3 "$FIX_PARITY/scripts/build-site" --root "$FIX_PARITY" --out "$TMP/fail-chg" 2>&1)"; RC_ERR_CHG=$?
ck "SPEC-0012/9d: CHANGELOG.md version divergence from site/i18n/pt/CHANGELOG.md fails build-site" '
    [ "$RC_ERR_CHG" -ne 0 ] && echo "$OUT_ERR_CHG" | grep -q "CHANGELOG.md"
'

cp "$ROOT/CHANGELOG.md" "$FIX_PARITY/CHANGELOG.md"
python3 - "$FIX_PARITY" << 'PY'
import json, pathlib, sys
fix = pathlib.Path(sys.argv[1])
sk_p = fix / "site/i18n/pt/skills.json"
sk = json.loads(sk_p.read_text(encoding="utf-8"))
del sk["casa-close"]
sk_p.write_text(json.dumps(sk, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
OUT_ERR_SK="$(python3 "$FIX_PARITY/scripts/build-site" --root "$FIX_PARITY" --out "$TMP/fail-sk" 2>&1)"; RC_ERR_SK=$?
ck "SPEC-0012/9e: missing casa-* skill in site/i18n/pt/skills.json fails build-site" '
    [ "$RC_ERR_SK" -ne 0 ] && echo "$OUT_ERR_SK" | grep -q "casa-close"
'

# Clean copy with _site/ generated at root to verify SPEC-0011/11 (0 errors and 0 warnings in docs-check)
FIX_CLEAN="$TMP/repo-clean"
mkdir -p "$FIX_CLEAN"
(cd "$ROOT" && tar --exclude='.git' --exclude='_site' -cf - .) | (cd "$FIX_CLEAN" && tar -xf -)
git -C "$FIX_CLEAN" init -q
python3 "$FIX_CLEAN/scripts/build-site" --root "$FIX_CLEAN" --out "$FIX_CLEAN/_site" >/dev/null 2>&1
DC_OUT="$(python3 "$FIX_CLEAN/scripts/docs-check" --root "$FIX_CLEAN" 2>&1)"; DC_RC=$?
ck "SPEC-0011/11: with _site/ generated at repo root, docs-check exits 0 with 0 error(s) · 0 warning(s)" '
    [ "$DC_RC" -eq 0 ] && echo "$DC_OUT" | grep -q "0 error(s) · 0 warning(s)"
'

# ── SPEC-0011/10 + SPEC-0012/10: casa-init isolation (adopter never receives build-site, test-site, site/, or site/i18n/) ──
ADOPTER="$TMP/adopter"
mkdir -p "$ADOPTER"
git -C "$ADOPTER" init -q
"$INIT" "$ADOPTER" --repo-id adopter-demo >/dev/null 2>&1; INIT_RC=$?
ck "SPEC-0011/10 + SPEC-0012/10: casa-init never copies build-site, test-site, or site/ to adopter" '
    [ "$INIT_RC" -eq 0 ] &&
    [ ! -e "$ADOPTER/scripts/build-site" ] &&
    [ ! -e "$ADOPTER/scripts/test-site" ] &&
    [ ! -e "$ADOPTER/site" ]
'

echo ""
echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
