#!/usr/bin/env bash
# Scenarios for SPEC-0011 + SPEC-0012 (build-site: bilingual EN/PT-BR static site compiler & parity gates). DoD: exit 0.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD="$ROOT/scripts/build-site"
INIT="$ROOT/scripts/casa-init"
GIT_CONFIG_GLOBAL=/dev/null; GIT_CONFIG_NOSYSTEM=1; export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

pass=0; fail=0
ck() {
    if eval "$2" >/dev/null 2>&1; then
        echo "PASS: $1"
        pass=$((pass+1))
    else
        echo "FAIL: $1"
        fail=$((fail+1))
    fi
}

# ── SPEC-0011/1 + SPEC-0012/6: Full EN (/), PT-BR (/pt/), /grafo/ redirect, search indices, and .nojekyll ──
OUT1="$TMP/site1"
python3 "$BUILD" --root "$ROOT" --out "$OUT1" >/dev/null 2>&1; RC1=$?
ck "SPEC-0011/1 + SPEC-0012/6: build-site exits 0" '[ "$RC1" -eq 0 ]'
ck "SPEC-0012/6: EN routes, PT-BR routes, /grafo/ redirect, assets, and per-locale search indices exist" '
    [ -f "$OUT1/index.html" ] &&
    [ -f "$OUT1/standard/index.html" ] &&
    [ -f "$OUT1/graph/index.html" ] &&
    [ -f "$OUT1/grafo/index.html" ] &&
    [ -f "$OUT1/skills/index.html" ] &&
    [ -f "$OUT1/changelog/index.html" ] &&
    [ -f "$OUT1/pt/index.html" ] &&
    [ -f "$OUT1/pt/standard/index.html" ] &&
    [ -f "$OUT1/pt/grafo/index.html" ] &&
    [ -f "$OUT1/pt/skills/index.html" ] &&
    [ -f "$OUT1/pt/changelog/index.html" ] &&
    [ -f "$OUT1/.nojekyll" ] &&
    [ -f "$OUT1/assets/style.css" ] &&
    [ -f "$OUT1/assets/app.js" ] &&
    [ -f "$OUT1/assets/favicon.svg" ] &&
    [ -f "$OUT1/assets/search-index.en.json" ] &&
    [ -f "$OUT1/assets/search-index.pt.json" ] &&
    grep -q "url=../graph/" "$OUT1/grafo/index.html"
'

ck "SPEC-0011/1c + SPEC-0012/8: every docs/index.json item renders in both EN and PT-BR with provenance notices where translated" '
python3 - "$ROOT" "$OUT1" << "PY"
import html, json, pathlib, sys
root = pathlib.Path(sys.argv[1])
out = pathlib.Path(sys.argv[2])
items = json.loads((root / "docs/index.json").read_text(encoding="utf-8"))
en_i18n = json.loads((root / "site/i18n/en/docs.json").read_text(encoding="utf-8"))
pt_i18n = json.loads((root / "site/i18n/pt/docs.json").read_text(encoding="utf-8"))
assert len(items) >= 30

for item in items:
    doc_id = item["id"]
    stem = pathlib.Path(item["path"]).stem
    en_page = out / item["layer"] / stem / "index.html"
    pt_page = out / "pt" / item["layer"] / stem / "index.html"
    assert en_page.is_file(), f"missing EN page {en_page}"
    assert pt_page.is_file(), f"missing PT page {pt_page}"
    en_body = en_page.read_text(encoding="utf-8")
    pt_body = pt_page.read_text(encoding="utf-8")

    if doc_id in en_i18n:
        # Historical PT-BR doc translated into EN on /
        exp_en_h1 = "<h1>" + html.escape(en_i18n[doc_id]["title"]) + "</h1>"
        exp_pt_h1 = "<h1>" + html.escape(item["title"]) + "</h1>"
        assert exp_en_h1 in en_body, f"EN translated H1 mismatch in {en_page}"
        assert exp_pt_h1 in pt_body, f"PT canonical H1 mismatch in {pt_page}"
        assert "class=\"provenance-note\"" in en_body and item["path"] in en_body, f"missing EN provenance note on {en_page}"
        assert "class=\"provenance-note\"" not in pt_body, f"unexpected provenance note on canonical PT page {pt_page}"
    else:
        # Canonical EN doc translated into PT-BR on /pt/
        assert doc_id in pt_i18n, f"{doc_id} missing from pt_i18n"
        exp_en_h1 = "<h1>" + html.escape(item["title"]) + "</h1>"
        exp_pt_h1 = "<h1>" + html.escape(pt_i18n[doc_id]["title"]) + "</h1>"
        assert exp_en_h1 in en_body, f"EN canonical H1 mismatch in {en_page}"
        assert exp_pt_h1 in pt_body, f"PT translated H1 mismatch in {pt_page}"
        assert "class=\"provenance-note\"" not in en_body, f"unexpected provenance note on canonical EN page {en_page}"
        assert "class=\"provenance-note\"" in pt_body and item["path"] in pt_body, f"missing PT provenance note on {pt_page}"
PY
'

# ── SPEC-0011/3 + SPEC-0012/7: Relative links, #fragments, EN|PT-BR counterpart switcher, and per-locale search indices ──
ck "SPEC-0011/3 + SPEC-0012/7: relative links, #fragments, EN|PT-BR counterpart links, and search indices resolve inside _site/" '
python3 - "$OUT1" << "PY"
import json, pathlib, sys
from html.parser import HTMLParser

site = pathlib.Path(sys.argv[1]).resolve()
html_files = sorted(site.rglob("*.html"))
assert len(html_files) >= 65

class PageParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = []
        self.refs = []
        self.lang_en_href = None
        self.lang_pt_href = None
    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if "id" in d:
            self.ids.append(d["id"])
            if d["id"] == "lang-link-en":
                self.lang_en_href = d.get("href")
            elif d["id"] == "lang-link-pt":
                self.lang_pt_href = d.get("href")
        for k in ("href", "src", "data-href"):
            if k in d:
                self.refs.append((k, d[k]))

parsed = {}
page_ids = {}
for f in html_files:
    p = PageParser()
    p.feed(f.read_text(encoding="utf-8"))
    parsed[f] = p
    page_ids[f] = set(p.ids)

for f, p in parsed.items():
    assert p.lang_en_href and p.lang_pt_href, f"{f}: missing EN/PT switcher links"
    for attr, val in p.refs:
        if val.startswith(("http://", "https://", "mailto:")):
            continue
        assert not val.startswith("/"), f"{f}: root-relative URL {val} breaks GitHub Pages subpath"
        path_part, _, frag = val.partition("#")
        target = f if not path_part else (f.parent / path_part).resolve()
        assert str(target).startswith(str(site)), f"{f}: escapes site root: {val}"
        target_file = (target / "index.html") if target.is_dir() else target
        assert target_file.is_file(), f"{f}: broken link {val} -> {target_file}"
        if frag and target_file in page_ids:
            assert frag in page_ids[target_file], f"{f}: broken anchor #{frag} in {val}"

    # Verify counterpart reciprocity (except /grafo/ redirect which maps EN->/graph/ and PT->/pt/grafo/)
    rel = f.relative_to(site).as_posix()
    en_target = (f.parent / p.lang_en_href).resolve()
    pt_target = (f.parent / p.lang_pt_href).resolve()
    en_file = (en_target / "index.html") if en_target.is_dir() else en_target
    pt_file = (pt_target / "index.html") if pt_target.is_dir() else pt_target
    if rel == "grafo/index.html":
        assert en_file == site / "graph/index.html"
        assert pt_file == site / "pt/grafo/index.html"
    elif rel.startswith("pt/"):
        assert pt_file == f, f"{f}: PT self-link does not point to self"
        expected_en_rel = "graph/index.html" if rel == "pt/grafo/index.html" else rel[len("pt/"):]
        assert en_file == site / expected_en_rel, f"{f}: EN switch {en_file} != {site / expected_en_rel}"
    else:
        assert en_file == f, f"{f}: EN self-link does not point to self"
        expected_pt_rel = "pt/grafo/index.html" if rel == "graph/index.html" else f"pt/{rel}"
        assert pt_file == site / expected_pt_rel, f"{f}: PT switch {pt_file} != {site / expected_pt_rel}"

for idx_name, must_start_pt in (("search-index.en.json", False), ("search-index.pt.json", True)):
    sidx = json.loads((site / "assets" / idx_name).read_text(encoding="utf-8"))
    assert len(sidx) >= 30
    for item in sidx:
        if must_start_pt:
            assert item["url"].startswith("pt/"), f"PT search entry escapes /pt/: {item}"
        else:
            assert not item["url"].startswith("pt/"), f"EN search entry points into /pt/: {item}"
        path_part, _, frag = item["url"].partition("#")
        target = (site / path_part).resolve()
        target_file = (target / "index.html") if target.is_dir() else target
        assert target_file.is_file(), f"{idx_name} broken url: {item}"
        if frag:
            assert frag in page_ids[target_file], f"{idx_name} broken fragment #{frag}: {item}"
PY
'

ck "SPEC-0011/4 + SPEC-0012/6: every page has locale-matching html[lang], <title>, meta description, hreflang tags, 1 <h1>, and unique IDs" '
python3 - "$OUT1" << "PY"
import pathlib, sys
from html.parser import HTMLParser

site = pathlib.Path(sys.argv[1]).resolve()
class SEOParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.lang = None
        self.h1 = 0
        self.in_title = False
        self.title_text = []
        self.meta_desc = ""
        self.ids = []
        self.hreflangs = set()
        self.has_canonical = False
    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if tag == "html":
            self.lang = d.get("lang")
        elif tag == "h1":
            self.h1 += 1
        elif tag == "title":
            self.in_title = True
        elif tag == "meta" and d.get("name") == "description":
            self.meta_desc = d.get("content", "").strip()
        elif tag == "link" and d.get("rel") == "canonical" and d.get("href"):
            self.has_canonical = True
        elif tag == "link" and d.get("rel") == "alternate" and d.get("hreflang"):
            self.hreflangs.add(d["hreflang"])
        if "id" in d:
            self.ids.append(d["id"])
    def handle_endtag(self, tag):
        if tag == "title":
            self.in_title = False
    def handle_data(self, data):
        if self.in_title:
            self.title_text.append(data)

for f in sorted(site.rglob("*.html")):
    rel = f.relative_to(site).as_posix()
    txt = f.read_text(encoding="utf-8")
    assert "\x00" not in txt, f"{f}: leaked placeholder"
    p = SEOParser()
    p.feed(txt)
    expected_lang = "pt-BR" if rel.startswith("pt/") else "en"
    assert p.lang == expected_lang, f"{f}: lang={p.lang}, expected {expected_lang}"
    assert p.h1 == 1, f"{f}: h1 count={p.h1}"
    assert "".join(p.title_text).strip(), f"{f}: empty <title>"
    assert len(p.meta_desc) >= 20, f"{f}: missing/short meta description"
    assert p.has_canonical, f"{f}: missing canonical link"
    assert p.hreflangs == {"en", "pt-BR", "x-default"}, f"{f}: hreflangs={p.hreflangs}"
    assert len(p.ids) == len(set(p.ids)), f"{f}: duplicate element IDs"
PY
'

ck "SPEC-0011/5: prose auto-links ADR-NNNN/SPEC-NNNN within each locale while keeping <pre><code> blocks literal" '
python3 - "$OUT1" << "PY"
import pathlib, re, sys
site = pathlib.Path(sys.argv[1])
for std_rel in ("standard/index.html", "pt/standard/index.html"):
    std = (site / std_rel).read_text(encoding="utf-8")
    assert re.search(r"<a class=\"doc-inline-ref\" href=\"\.\./adr/0017-[^\"]+\">ADR-0017</a>", std), f"ADR-0017 not linked in {std_rel}"
    assert re.search(r"<a class=\"doc-inline-ref\" href=\"\.\./adr/0009-[^\"]+\">ADR-0009</a>", std), f"ADR-0009 not linked in {std_rel}"
    m_code = re.search(r"<pre><code[^>]*>[^<]*builds-on: \[ADR-0005\][^<]*</code></pre>", std)
    assert m_code is not None, f"Code block with [ADR-0005] was corrupted in {std_rel}"
PY
'

