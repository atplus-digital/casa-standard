#!/usr/bin/env bash
# Scenarios for SPEC-0007 and SPEC-0012 (docs-reserve). DoD: exit 0 = all green.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RESERVE="$ROOT/scripts/docs-reserve"
INIT="$ROOT/scripts/casa-init"
TODAY="$(date +%F)"
GIT_CONFIG_GLOBAL=/dev/null; GIT_CONFIG_NOSYSTEM=1; export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM
pass=0; fail=0
ck() { if eval "$2" >/dev/null 2>&1; then echo "PASS: $1"; pass=$((pass+1)); else echo "FAIL: $1"; fail=$((fail+1)); fi; }

mkr() { R="$(mktemp -d)/r"; python3 "$INIT" "$R" --repo-id t >/dev/null; }

# SPEC-0007/1 + SPEC-0012/4 — first reservation in new repo: 0001, template file, canonical EN ledger
mkr
OUT=$(python3 "$RESERVE" adr "Decisão sobre autenticação" --root "$R" 2>&1)
ck "SPEC-0007/1: reserves ADR-0001"               'echo "$OUT" | grep -q "Reserved ADR-0001"'
ck "SPEC-0007/1: file created with ASCII slug"    '[ -f "$R/docs/adr/0001-decisao-sobre-autenticacao.md" ]'
ck "SPEC-0007/1: H1 receives title"               'grep -q "^# Decisão sobre autenticação$" "$R/docs/adr/0001-decisao-sobre-autenticacao.md"'
ck "SPEC-0007/1: date stamped to today"           'grep -q "^date: $TODAY" "$R/docs/adr/0001-decisao-sobre-autenticacao.md"'
ck "SPEC-0007/1 + SPEC-0012/4: EN ledger created" 'grep -q "^## ADR Reservations$" "$R/docs/BACKLOG.md" && grep -qF "| 0001 | Decisão sobre autenticação | $TODAY | in use |" "$R/docs/BACKLOG.md"'

# SPEC-0007/2 — layers number independently; sequence advances
OUT=$(python3 "$RESERVE" spec "Inbox delivery" --root "$R" 2>&1)
ck "SPEC-0007/2: first Spec is SPEC-0001"         'echo "$OUT" | grep -q "Reserved SPEC-0001"'
OUT=$(python3 "$RESERVE" adr "Another decision" --root "$R" 2>&1)
ck "SPEC-0007/2: next ADR is 0002"                'echo "$OUT" | grep -q "Reserved ADR-0002"'

# SPEC-0007/3 + SPEC-0012/4 — legacy PT-BR ledger (`## Reservas ADR`) is recognized & appended in place!
mkr
mkdir -p "$R/docs"
cat > "$R/docs/BACKLOG.md" <<EOF
# Backlog — t

## Reservas ADR

| NNNN | título | data | situação |
|---|---|---|---|
| 0007 | reserva manual de outra branch | 2026-01-01 | reservado |
EOF
OUT=$(python3 "$RESERVE" adr "Nova decisão" --root "$R" 2>&1)
ck "SPEC-0007/3: honors manual reservation (0008)" 'echo "$OUT" | grep -q "Reserved ADR-0008"'
ck "SPEC-0007/3: gaps are noted"                   'echo "$OUT" | grep -q "gap(s)"'
ck "SPEC-0012/4: appends to legacy ## Reservas ADR without duplicating section" \
   'grep -q "^## Reservas ADR$" "$R/docs/BACKLOG.md" && ! grep -q "^## ADR Reservations$" "$R/docs/BACKLOG.md"'

# SPEC-0007/3b — prefixed ID cell (ADR-0004) also parsed
mkr
mkdir -p "$R/docs"
cat > "$R/docs/BACKLOG.md" <<EOF
# Backlog — t

## ADR Reservations

| ID | File | Status |
|---|---|---|
| ADR-0004 | 0004-x.md | in use |
EOF
OUT=$(python3 "$RESERVE" adr "Compat" --root "$R" 2>&1)
ck "SPEC-0007/3b: row with ADR- prefix counts"    'echo "$OUT" | grep -q "Reserved ADR-0005"'

# SPEC-0007/4 — unparseable line inside section: explicit WARNING, operation continues
mkr
mkdir -p "$R/docs"
cat > "$R/docs/BACKLOG.md" <<EOF
# Backlog — t

## ADR Reservations

| NNNN | title | date | status |
|---|---|---|---|
| 0002 | ok | 2026-01-01 | in use |
0005-0009: reserved for phase 2 (legacy prose)
EOF
OUT=$(python3 "$RESERVE" adr "Keep going" --root "$R" 2>&1)
ck "SPEC-0007/4: unreadable line emits WARNING"   'echo "$OUT" | grep -q "WARNING.*unreadable"'
ck "SPEC-0007/4: operation continues (0003)"      'echo "$OUT" | grep -q "Reserved ADR-0003"'

# SPEC-0007/5 — backlog in docs/context/ without docs/BACKLOG.md: refuses cleanly
mkr
mkdir -p "$R/docs/context"; printf '# Backlog\n' > "$R/docs/context/BACKLOG.md"
OUT=$(python3 "$RESERVE" adr "Should not create" --root "$R" 2>&1); RC=$?
ck "SPEC-0007/5: refuses misplaced backlog"       '[ "$RC" -ne 0 ] && echo "$OUT" | grep -q "ADR-0011"'
ck "SPEC-0007/5: nothing created"                 '[ ! -d "$R/docs/adr" ] && [ ! -f "$R/docs/BACKLOG.md" ]'

# SPEC-0007/6 — accents and punctuation transliterate to ASCII kebab slug
mkr
python3 "$RESERVE" spec "Notificações por e-mail: envio & retry" --root "$R" >/dev/null 2>&1
ck "SPEC-0007/6: slug transliterates accents"     '[ -f "$R/docs/specs/0001-notificacoes-por-e-mail-envio-retry.md" ]'

# SPEC-0007/7 — dry-run prints plan and writes nothing
mkr
OUT=$(python3 "$RESERVE" adr "Dry run only" --root "$R" --dry-run 2>&1)
ck "SPEC-0007/7: dry-run announces number"        'echo "$OUT" | grep -q "0001"'
ck "SPEC-0007/7: dry-run creates no files"        '[ ! -d "$R/docs/adr" ] && [ ! -f "$R/docs/BACKLOG.md" ]'

# SPEC-0007/8 — title with no ASCII slug characters fails clearly
mkr
ck "SPEC-0007/8: slugless title fails"            '! python3 "$RESERVE" adr "!!!" --root "$R"'

# SPEC-0007/9 — repo stays green after reservations (automatic emit-index)
mkr
python3 "$RESERVE" adr "First decision" --root "$R" >/dev/null 2>&1
python3 "$RESERVE" spec "First behavior" --root "$R" >/dev/null 2>&1
ck "SPEC-0007/9: docs-check green after reservations" '(cd "$R" && python3 scripts/docs-check)'

# SPEC-0009/19 — spec: title goes into body H1; frontmatter comment stays intact
mkr
python3 "$RESERVE" spec "Login with SSO" --root "$R" >/dev/null 2>&1
F="$R/docs/specs/0001-login-with-sso.md"
ck "SPEC-0009/19: spec H1 receives title"         'grep -q "^# Login with SSO$" "$F"'
ck "SPEC-0009/19: placeholder H1 removed"         '! grep -q "^# <behavior" "$F"'
ck "SPEC-0009/19: frontmatter comment intact"     'grep -q "^# design-ref: <url-or-path>" "$F"'
ck "SPEC-0009/19: generated README lists title"   'grep -q "| Login with SSO |" "$R/docs/specs/README.md"'

echo
echo "==== $pass PASS / $fail FAIL ===="
[ "$fail" -eq 0 ]
