#!/usr/bin/env python3
"""
casa-init — instala e atualiza a infraestrutura do CASA Standard num repo
adotante, em qualquer estado: vazio, novo, legado, com docs ADR/SDD.
Decisão: ADR-0004 · comportamento: SPEC-0001.

Uso:
  scripts/casa-init <destino> [--repo-id NOME] [--tier T0|T1]

Aditivo e idempotente:
  - Toolchain (da ferramenta; sobrescreve quando difere): scripts/docs-check,
    scripts/pre-commit e docs/templates/*.
  - Identidade (do repo; nunca sobrescreve): AGENTS.md é criado do template só
    se ausente — com repo-id, tier, casa-version e casa-standard-ref carimbados; se
    existir, apenas casa-standard-ref é atualizado; casa-version é a promessa do
    repo (ADR-0010) — inserida só se ausente, nunca alterada. CLAUDE.md (ponte de
    host, ADR-0009) é criado do template só se ausente; existente nunca é tocado
    (AVISO se falta @AGENTS.md).
  - Gate (ADR-0006): remote GitHub → workflow de CI (criado se ausente, com o branch
    padrão do repo; existente e divergente do template → AVISO, nunca sobrescrito);
    sem remote ou host sem adaptador de CI → pre-commit hook no diretório de hooks
    EFETIVO do git (core.hooksPath, worktree), com AVISO quando há remote (hook alheio
    não é tocado); sem .git → orienta; destino dentro de outro repo sem ser a raiz →
    não instala gate (hook e CI valem para a raiz) e orienta.
  - Diagnóstico: roda o docs-check do destino ao final e relata. Migração de
    conteúdo legado é trabalho humano (STANDARD §10), não deste script.

NUNCA toca: docs/adr|specs|context, README, LICENSE, código do repo.
Exit 0 = instalação concluída (pendência de migração é relatório, não falha).
"""
import argparse, filecmp, os, re, shutil, subprocess, sys
from pathlib import Path

SRC = Path(__file__).resolve().parent.parent
# Deve ser idêntica à CONTRACT_VERSION do docs-check (ADR-0010) — teste guarda a sincronia.
CASA_VERSION = "1.8"
TOOLCHAIN = [
    "scripts/docs-check",
    "scripts/docs-reserve",
    "scripts/casa-update-check",
    "scripts/pre-commit",
    "docs/templates/AGENTS.template.md",
    "docs/templates/CLAUDE.template.md",
    "docs/templates/adr.template.md",
    "docs/templates/spec.template.md",
    "docs/templates/context.TESTS.template.md",
    "docs/templates/docs-check.workflow.yml",
    "docs/templates/casa-update-check.workflow.yml",
]
# Pontes por host (ADR-0009) — conjunto FECHADO: host de agente que não lê AGENTS.md
# recebe um arquivo-ponte que importa o router. Host novo entra por ADR, nunca ad-hoc.
HOST_SHIM = ("CLAUDE.md", "docs/templates/CLAUDE.template.md", "@AGENTS.md")
# Workflows instalados quando o remote é GitHub (ADR-0006): gate + update-check (ADR-0016).
GITHUB_WORKFLOWS = [
    ("docs/templates/docs-check.workflow.yml", ".github/workflows/docs-check.yml",
     "gate: CI"),
    ("docs/templates/casa-update-check.workflow.yml", ".github/workflows/casa-update-check.yml",
     "update-check agendado, ADR-0016"),
]


def utf8_stdio():
    # Windows usa cp1252 no stdout redirecionado; a saída tem não-ASCII ("→").
    for s in (sys.stdout, sys.stderr):
        if hasattr(s, "reconfigure"):
            s.reconfigure(encoding="utf-8", errors="replace")


def sh(args, cwd=None):
    return subprocess.run(args, cwd=cwd, capture_output=True,
                          encoding="utf-8", errors="replace")


def remote_host(url):
    """Host de uma URL de remote: https/ssh (scheme://[user@]host/…) e scp-like (user@host:…)."""
    m = re.match(r"^[a-z][a-z0-9+.-]*://(?:[^@/]+@)?([^/:]+)", url, re.I)
    if not m:
        m = re.match(r"^(?:[^@/]+@)?([^:/]+):", url)
    return m.group(1).lower() if m else ""


def default_branch(target):
    """Branch padrão do repo, para o gatilho `push` do workflow. Nunca o branch corrente
    (pode ser o de feature em que a adoção está sendo feita)."""
    r = sh(["git", "-C", str(target), "symbolic-ref", "--quiet", "--short",
            "refs/remotes/origin/HEAD"])
    if r.returncode == 0 and "/" in r.stdout.strip():
        return r.stdout.strip().split("/", 1)[1]
    for ref in ("refs/remotes/origin/main", "refs/remotes/origin/master",
                "refs/heads/main", "refs/heads/master"):
        if sh(["git", "-C", str(target), "rev-parse", "--verify", "--quiet", ref]).returncode == 0:
            return ref.rsplit("/", 1)[1]
    return "main"


def render_workflow(tpl_text, branch):
    """O template traz `branches: [main]`; o repo recebe o seu branch padrão."""
    return tpl_text.replace("    branches: [main]\n", f"    branches: [{branch}]\n", 1)


def src_ref():
    env = os.environ.get("CASA_STANDARD_REF")
    if env:
        return env  # setado pelo install.sh (SPEC-0002): ref pinado ou sha de main
    r = sh(["git", "-C", str(SRC), "rev-parse", "--short", "HEAD"])
    return r.stdout.strip() if r.returncode == 0 else "unknown"


def say(tag, msg):
    print(f"{tag:>11}  {msg}")


def upsert_router_meta(text, ref):
    """casa-standard-ref é da ferramenta: sempre atualizado. casa-version é a PROMESSA do
    repo (ADR-0010): inserida só se ausente, NUNCA alterada — atualizá-la é ato deliberado
    de quem leu o CHANGELOG; o docs-check sinaliza enquanto declaração e toolchain divergirem."""
    lines = text.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if ln.strip().lower() == "```yaml")
        end = next(i for i in range(start + 1, len(lines)) if lines[i].strip() == "```")
    except StopIteration:
        return text, []

    changed = []

    def set_key(key, value, after_keys, only_if_missing=False):
        nonlocal end
        pattern = re.compile(rf"^({re.escape(key)}:)(\s*)(\S+)(.*)$")
        for i in range(start + 1, end):
            m = pattern.match(lines[i])
            if m:
                if only_if_missing or m.group(3) == value:
                    return
                lines[i] = f"{key}: {value}{m.group(4)}"
                changed.append(f"{key} → {value}")
                return
        insert_at = end
        for i in range(start + 1, end):
            if any(re.match(rf"^{re.escape(k)}:", lines[i]) for k in after_keys):
                insert_at = i + 1
        lines.insert(insert_at, f"{key}: {value}")
        end += 1
        changed.append(f"{key} → {value}")

    set_key("casa-version", CASA_VERSION, ["casa-tier", "casa-repo-id"], only_if_missing=True)
    set_key("casa-standard-ref", ref, ["casa-version", "casa-tier", "casa-repo-id"])
    return "\n".join(lines) + ("\n" if text.endswith("\n") else ""), changed


def main():
    utf8_stdio()
    ap = argparse.ArgumentParser(
        description="instala/atualiza a infraestrutura CASA num repo (SPEC-0001)")
    ap.add_argument("destino")
    ap.add_argument("--repo-id", default=None)
    ap.add_argument("--tier", choices=["T0", "T1"], default="T1")
    args = ap.parse_args()

    target = Path(args.destino).expanduser().resolve()
    if target == SRC:
        sys.exit("casa-init: o destino é o próprio casa-standard — nada a fazer.")
    if target.exists() and not target.is_dir():
        sys.exit(f"casa-init: destino não é diretório: {target}")
    target.mkdir(parents=True, exist_ok=True)
    repo_id = args.repo_id or target.name
    ref = src_ref()

    # 1. Toolchain — propriedade da ferramenta
    for rel in TOOLCHAIN:
        s, d = SRC / rel, target / rel
        d.parent.mkdir(parents=True, exist_ok=True)
        if not d.exists():
            shutil.copy2(s, d)
            say("criado", rel)
        elif not filecmp.cmp(s, d, shallow=False):
            shutil.copy2(s, d)
            say("atualizado", rel)
        else:
            say("em dia", rel)
    for rel in ("scripts/docs-check", "scripts/docs-reserve", "scripts/casa-update-check",
                "scripts/pre-commit"):
        (target / rel).chmod(0o755)

    # 2. Identidade — propriedade do repo (só a linha casa-standard-ref é da ferramenta)
    router = target / "AGENTS.md"
    if not router.exists():
        text = (SRC / "docs/templates/AGENTS.template.md").read_text(encoding="utf-8")
        text = text.replace("<nome-canonico-do-repo>", repo_id)
        if args.tier == "T0":
            text = text.replace("casa-tier: T1", "casa-tier: T0", 1)
        text = re.sub(r"casa-version: \S+", f"casa-version: {CASA_VERSION}", text, count=1)
        text = text.replace("casa-standard-ref: <sha>", f"casa-standard-ref: {ref}", 1)
        # write_bytes (não write_text) preserva LF no Windows — write_text traduz \n→\r\n
        router.write_bytes(text.encode("utf-8"))
        say("criado", f"AGENTS.md (router; repo-id={repo_id}, tier={args.tier} — preencha as seções)")
    else:
        old = router.read_text(encoding="utf-8")
        new, changed = upsert_router_meta(old, ref)
        if new != old:
            router.write_bytes(new.encode("utf-8"))  # preserva LF no Windows (ver acima)
            say("atualizado", "AGENTS.md: " + "; ".join(changed))
        else:
            say("preservado", "AGENTS.md (router é do repo — não sobrescrevo)")

    # 2b. Ponte de host (ADR-0009): Claude Code não lê AGENTS.md — CLAUDE.md importa o
    # router. Criada só se ausente; existente é identidade do repo, nunca tocada.
    shim_name, shim_tpl, shim_marker = HOST_SHIM
    shim = target / shim_name
    if not shim.exists():
        text = (SRC / shim_tpl).read_text(encoding="utf-8")
        shim.write_bytes(text.encode("utf-8"))  # preserva LF no Windows (ver acima)
        say("criado", f"{shim_name} (ponte → AGENTS.md, ADR-0009)")
    elif shim_marker in shim.read_text(encoding="utf-8"):
        say("em dia", f"{shim_name} (ponte → AGENTS.md)")
    else:
        say("AVISO", f"{shim_name} existe sem `{shim_marker}` — o Claude Code não carrega "
                     f"o router; adicione a linha `{shim_marker}` (ADR-0009)")

    # 3. Gate (ADR-0006): adaptador escolhido pelo host do remote; hook é o fallback
    r = sh(["git", "-C", str(target), "rev-parse", "--show-toplevel"])
    if r.returncode != 0:
        say("AVISO", "sem .git: gate não instalado — rode `git init` e casa-init de novo (STANDARD §3)")
    elif Path(r.stdout.strip()).resolve() != target:
        # O git achou um repo ANCESTRAL: hook e workflow valem para a raiz dele, onde não há
        # router nem validador — instalar ali quebraria os commits do repo pai.
        say("AVISO", f"destino está dentro do repo {r.stdout.strip()} sem ser a raiz: gate não "
                     "instalado (hook e CI valem para a raiz) — rode `git init` no destino, ou "
                     "o casa-init na raiz do repo (STANDARD §3)")
    else:
        urls = [ln.split(None, 1)[1]
                for ln in sh(["git", "-C", str(target), "config", "--get-regexp",
                              r"^remote\..*\.url$"]).stdout.splitlines() if " " in ln]
        if any(remote_host(u) == "github.com" for u in urls):
            branch = default_branch(target)
            for tpl, dest, label in GITHUB_WORKFLOWS:
                wf = target / dest
                content = render_workflow((SRC / tpl).read_text(encoding="utf-8"), branch)
                if not wf.exists():
                    wf.parent.mkdir(parents=True, exist_ok=True)
                    wf.write_bytes(content.encode("utf-8"))  # preserva LF no Windows
                    extra = f"; branch padrão: {branch}" if "branches:" in content else ""
                    say("criado", f"{dest} ({label}{extra})")
                elif wf.read_text(encoding="utf-8") == content:
                    say("em dia", dest)
                else:
                    # O workflow é do repo (pode ter sido customizado) — nunca sobrescrito; mas
                    # correção do template não chega sozinha: o adotante precisa saber.
                    say("AVISO", f"{dest} difere do template desta versão — compare com {tpl} "
                                 "e incorpore o que fizer sentido (o casa-init não sobrescreve)")
            say("nota", f"marque o check `docs-check` como OBRIGATÓRIO na proteção do branch "
                        f"{branch} — sem isso o CI avisa, mas não bloqueia o merge (STANDARD §3)")
        else:
            if urls:
                say("AVISO", f"remote sem adaptador de CI ({remote_host(urls[0]) or urls[0]}): "
                             "gate local via pre-commit hook (ADR-0006) — integre "
                             "`scripts/docs-check` ao CI do seu host")
            # Diretório de hooks EFETIVO: respeita core.hooksPath e, em worktree, o diretório
            # comum — .git/hooks fixo instalaria um hook que o git nunca executa.
            hp = Path(sh(["git", "-C", str(target), "rev-parse", "--git-path",
                          "hooks/pre-commit"]).stdout.strip())
            hook = hp if hp.is_absolute() else (target / hp)
            hooks_cfg = sh(["git", "-C", str(target), "config", "--get", "core.hooksPath"]).stdout.strip()
            if hooks_cfg:
                say("nota", f"core.hooksPath={hooks_cfg}: o hook vai para o diretório configurado")
            ours = target / "scripts" / "pre-commit"
            if hook.exists() or hook.is_symlink():
                try:
                    same = hook.resolve() == ours.resolve() or hook.read_bytes() == ours.read_bytes()
                except OSError:
                    same = False
                if same:
                    say("em dia", f"{os.path.relpath(hook, target)} (gate: local)")
                else:
                    say("AVISO", f"{hook} existe e não é o do CASA — não toco; "
                                 "integre `scripts/docs-check` a ele")
            else:
                hook.parent.mkdir(parents=True, exist_ok=True)
                # Symlink só quando o hook mora dentro deste checkout; num worktree o diretório
                # de hooks é COMUM a todos os checkouts — vai cópia, que resolve o validador
                # pelo toplevel de quem commita (e um link para outro worktree apodreceria).
                inside = target in hook.parent.resolve().parents
                try:
                    if not inside:
                        raise OSError
                    hook.symlink_to(os.path.relpath(ours, hook.parent))
                except OSError:
                    shutil.copy2(ours, hook)
                    hook.chmod(0o755)
                say("criado", f"{os.path.relpath(hook, target)} → scripts/pre-commit (gate: local, ADR-0006)")

    # 4. Diagnóstico — migração de conteúdo é humana (§10)
    print()
    r = sh([sys.executable, str(target / "scripts" / "docs-check")], cwd=target)
    print(r.stdout.strip() or "(docs-check sem saída)")
    if r.returncode != 0:
        print("→ docs existentes precisam de migração de conteúdo (STANDARD §10) — o gate vai cobrar.")
    else:
        print(f"→ repo verde no CASA (origem: casa-standard@{ref}).")


if __name__ == "__main__":
    main()
