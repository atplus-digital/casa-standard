#!/usr/bin/env python3
"""
casa-init — installs and updates CASA Standard infrastructure in an adopting
repository in any state: empty, greenfield, legacy, or with existing ADR/SDD docs.
Decision: ADR-0004 · behavior: SPEC-0001.

Usage:
  scripts/casa-init <target> [--repo-id NAME] [--tier T0|T1]

Additive and idempotent:
  - Toolchain (tool-owned; overwritten on drift): scripts/docs-check,
    scripts/docs-reserve, scripts/casa-update-check, scripts/pre-commit, and
    docs/templates/*.
  - Identity (repo-owned; never overwritten): AGENTS.md is created from template
    only if missing — stamped with repo-id, tier, casa-version, and casa-standard-ref;
    if present, only casa-standard-ref is updated; casa-version is the repo's own
    promise (ADR-0010) — inserted only if missing, never altered. CLAUDE.md (host shim,
    ADR-0009) is created from template only if missing; existing files are never
    touched (WARNING if @AGENTS.md is absent).
  - Delivery-cycle skills (ADR-0017, T1 only): casa-explore/propose/apply/verify/close
    in .agents/skills/ and .claude/skills/ — tool-owned, updated on drift; custom repo
    skills with other names are never touched.
  - Gate (ADR-0006): GitHub remote → CI workflows (created if missing using the repo's
    default branch; existing divergent workflow → WARNING, never overwritten); no
    remote or host without CI adapter → pre-commit hook in git's EFFECTIVE hooks
    directory (core.hooksPath, worktree), with WARNING when a remote exists (foreign
    hooks are never touched); no .git → prints guidance; target inside a parent repo
    without being its root → skips gate installation and prints guidance.
  - Diagnostic: runs target's docs-check at the end and reports status. Legacy content
    migration is human work (STANDARD §10), not performed by this script.

NEVER touches: docs/adr|specs|context, README, LICENSE, or application code.
Exit 0 = installation completed (pending content migration is reported, not a failure).
"""
import argparse, filecmp, os, re, shutil, subprocess, sys
from pathlib import Path

SRC = Path(__file__).resolve().parent.parent
# Must match CONTRACT_VERSION in docs-check (ADR-0010) — test-casa-init guards sync.
CASA_VERSION = "1.11"
TOOLCHAIN = [
    "scripts/docs-check",
    "scripts/docs-reserve",
    "scripts/casa-update-check",
    "scripts/pre-commit",
    "docs/templates/AGENTS.template.md",
    "docs/templates/CLAUDE.template.md",
    "docs/templates/adr.template.md",
    "docs/templates/spec.template.md",
    "docs/templates/context.TESTS.template.md",
    "docs/templates/docs-check.workflow.yml",
    "docs/templates/casa-update-check.workflow.yml",
]
# Host shims (ADR-0009) — CLOSED set: agent hosts that do not read AGENTS.md natively
# receive a shim importing the router. Adding a host requires an ADR, never ad-hoc edits.
HOST_SHIM = ("CLAUDE.md", "docs/templates/CLAUDE.template.md", "@AGENTS.md")
# Delivery-cycle skills (ADR-0017): tool-owned — casa-* updated on drift; repo skills
# under other names are never touched. Target directories form a CLOSED set: cross-client
# convention (.agents/skills) + Claude Code (.claude/skills). New directory = ADR.
SKILLS = ["casa-explore", "casa-propose", "casa-apply", "casa-verify", "casa-close"]
SKILL_DIRS = [".agents/skills", ".claude/skills"]
SKILL_MARKER = "\n# CASA · "  # heading present in casa-* skills across every version
# Retired or renamed casa-* skills in future versions: listed here to clean up adopters.
RETIRED_SKILLS = []
# Workflows installed when remote host is GitHub (ADR-0006): gate + update-check (ADR-0016).
GITHUB_WORKFLOWS = [
    ("docs/templates/docs-check.workflow.yml", ".github/workflows/docs-check.yml",
     "gate: CI"),
    ("docs/templates/casa-update-check.workflow.yml", ".github/workflows/casa-update-check.yml",
     "scheduled update-check, ADR-0016"),
]


def utf8_stdio():
    # Windows defaults to cp1252 on redirected stdout; output contains non-ASCII ("→").
    for s in (sys.stdout, sys.stderr):
        if hasattr(s, "reconfigure"):
            s.reconfigure(encoding="utf-8", errors="replace")


def sh(args, cwd=None):
    return subprocess.run(args, cwd=cwd, capture_output=True,
                          encoding="utf-8", errors="replace")


def remote_host(url):
    """Extract host from a git remote URL: https/ssh (scheme://[user@]host/…) and scp-like."""
    m = re.match(r"^[a-z][a-z0-9+.-]*://(?:[^@/]+@)?([^/:]+)", url, re.I)
    if not m:
        m = re.match(r"^(?:[^@/]+@)?([^:/]+):", url)
    return m.group(1).lower() if m else ""


def default_branch(target):
    """Repository default branch for workflow `push` triggers — never the current branch
    (which may be the feature branch where CASA adoption is taking place)."""
    r = sh(["git", "-C", str(target), "symbolic-ref", "--quiet", "--short",
            "refs/remotes/origin/HEAD"])
    if r.returncode == 0 and "/" in r.stdout.strip():
        return r.stdout.strip().split("/", 1)[1]
    # `git push` does not write origin/HEAD: locally created repos pushed later land here.
    remote = [ln[len("refs/remotes/origin/"):] for ln in sh(
        ["git", "-C", str(target), "for-each-ref", "--format=%(refname)",
         "refs/remotes/origin/"]).stdout.split() if not ln.endswith("/HEAD")]
    for name in ("main", "master"):
        if name in remote:
            return name
    if len(remote) == 1:
        return remote[0]
    for name in ("main", "master"):
        if sh(["git", "-C", str(target), "rev-parse", "--verify", "--quiet",
               f"refs/heads/{name}"]).returncode == 0:
            return name
    return "main"


def render_workflow(tpl_text, branch):
    """Templates ship `branches: [main]`; adopters receive their actual default branch."""
    return tpl_text.replace("    branches: [main]\n", f"    branches: [{branch}]\n", 1)


def src_ref():
    env = os.environ.get("CASA_STANDARD_REF")
    if env:
        return env  # set by install.sh (SPEC-0002): pinned ref or main sha
    r = sh(["git", "-C", str(SRC), "rev-parse", "--short", "HEAD"])
    return r.stdout.strip() if r.returncode == 0 else "unknown"


def say(tag, msg):
    print(f"{tag:>11}  {msg}")


def upsert_router_meta(text, ref):
    """casa-standard-ref is tool-owned: always updated. casa-version is the repo's PROMISE
    (ADR-0010): inserted only if missing, NEVER altered — bumping it is a deliberate act
    after reading CHANGELOG; docs-check warns while declaration and toolchain diverge."""
    lines = text.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if ln.strip().lower() == "```yaml")
        end = next(i for i in range(start + 1, len(lines)) if lines[i].strip() == "```")
    except StopIteration:
        return text, []

    changed = []

    def set_key(key, value, after_keys, only_if_missing=False):
        nonlocal end
        pattern = re.compile(rf"^({re.escape(key)}:)(\s*)(\S+)(.*)$")
        for i in range(start + 1, end):
            m = pattern.match(lines[i])
            if m:
                if only_if_missing or m.group(3) == value:
                    return
                lines[i] = f"{key}: {value}{m.group(4)}"
                changed.append(f"{key} → {value}")
                return
        insert_at = end
        for i in range(start + 1, end):
            if any(re.match(rf"^{re.escape(k)}:", lines[i]) for k in after_keys):
                insert_at = i + 1
        lines.insert(insert_at, f"{key}: {value}")
        end += 1
        changed.append(f"{key} → {value}")

    set_key("casa-version", CASA_VERSION, ["casa-tier", "casa-repo-id"], only_if_missing=True)
    set_key("casa-standard-ref", ref, ["casa-version", "casa-tier", "casa-repo-id"])
    return "\n".join(lines) + ("\n" if text.endswith("\n") else ""), changed


def _is_casa_skill(path):
    try:
        return SKILL_MARKER in path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def router_tier(text, fallback):
    """Read casa-tier from the router's yaml block (ignoring HTML comments, accepting quotes
    and inline comments like docs-check); falls back to --tier if absent."""
    visible = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    yb = re.search(r"```yaml\s*\n(.*?)\n```", visible, flags=re.I | re.S)
    if yb:
        m = re.search(r"^casa-tier:\s*(.*)$", yb.group(1), flags=re.M)
        if m:
            val = re.split(r"\s+#", m.group(1).strip(), maxsplit=1)[0].strip().strip("'\"")
            if val:
                return val
    return fallback


def render_skill(data, ref):
    """Template links point to STANDARD on `main`; adopters get links pinned to the
    installed toolchain snapshot (casa-standard-ref)."""
    data = data.replace(b"\r\n", b"\n")  # Windows clone with core.autocrlf=true → LF
    if re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z._/-]*", ref or "") and ref not in ("unknown", "local"):
        return data.replace(b"/casa-standard/blob/main/", f"/casa-standard/blob/{ref}/".encode())
    return data


def remove_casa_skills(target):
    removed = 0
    for base in SKILL_DIRS:
        try:
            for name in (*SKILLS, *RETIRED_SKILLS):
                old = target / base / name / "SKILL.md"
                if old.is_file() and _is_casa_skill(old):
                    shutil.rmtree(old.parent)
                    removed += 1
            skills_dir = target / base
            if skills_dir.is_dir() and not any(skills_dir.iterdir()):
                skills_dir.rmdir()
                if skills_dir.parent.is_dir() and not any(skills_dir.parent.iterdir()):
                    skills_dir.parent.rmdir()
        except OSError:
            continue
    return removed


def install_skills(target, ref):
    for base in SKILL_DIRS:
        count = {"created": 0, "updated": 0, "up to date": 0, "removed": 0}
        try:
            for name in RETIRED_SKILLS:  # retired casa-* skill: remove only if ours
                old = target / base / name / "SKILL.md"
                if old.is_file() and _is_casa_skill(old):
                    shutil.rmtree(old.parent)
                    count["removed"] += 1
            for name in SKILLS:
                data = render_skill((SRC / "docs/templates/skills" / name / "SKILL.md").read_bytes(), ref)
                dest = target / base / name / "SKILL.md"
                dest.parent.mkdir(parents=True, exist_ok=True)
                if dest.is_symlink() and not dest.exists():
                    dest.unlink()
                if not dest.exists():
                    count["created"] += 1
                elif dest.read_bytes() != data:
                    count["updated"] += 1
                else:
                    count["up to date"] += 1
                    continue
                dest.write_bytes(data)  # bytes: preserves LF on Windows
        except OSError as e:  # e.g., `.claude` is a regular file — do not abort installation
            say("WARNING", f"{base}: could not install cycle skills ({e}) — continue without "
                           "them or free the directory path (ADR-0017)")
            continue
        tag = next((k for k in ("created", "updated", "removed") if count[k]), "up to date")
        detail = ", ".join(f"{v} {k}" for k, v in count.items() if v)
        say(tag, f"{base}/casa-* (cycle skills, ADR-0017: {detail})")
        if sh(["git", "-C", str(target), "check-ignore", "-q",
               f"{base}/{SKILLS[0]}/SKILL.md"]).returncode == 0:
            say("WARNING", f"{base}/ is ignored by .gitignore — skills stay only on this "
                           "machine; track them in git for teammates and CI agents (ADR-0017)")


# Recognizes both canonical EN (1.11+) and legacy PT-BR (1.0–1.10) CASA pre-commit hooks.
HOOK_MARKERS = ("CASA Standard local gate", "Gate local do CASA Standard")


def _is_casa_hook(path):
    """True if hook was installed by any version of casa-init (copy or symlink)."""
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
        return any(m in text for m in HOOK_MARKERS)
    except OSError:
        return path.is_symlink()  # broken symlink: leftover CASA hook from removed worktree


def install_hook(target):
    """Install pre-commit in git's EFFECTIVE hooks directory (core.hooksPath, common worktree
    dir) — provided it belongs to THIS repo: global hooksPath would affect every repo."""
    def gitpath(*args):
        p = Path(sh(["git", "-C", str(target), "rev-parse", *args]).stdout.strip())
        return (p if p.is_absolute() else target / p).resolve()
    hook = gitpath("--git-path", "hooks/pre-commit")
    hooks_dir, common = hook.parent, gitpath("--git-common-dir")
    if not any(base == hooks_dir or base in hooks_dir.parents for base in (target, common)):
        say("WARNING", f"core.hooksPath points outside this repo ({hooks_dir}) — likely global "
                       "git config: refusing to install a hook affecting other repos; invoke "
                       "`scripts/pre-commit` from your hook manager (STANDARD §3)")
        return
    hooks_cfg = sh(["git", "-C", str(target), "config", "--get", "core.hooksPath"]).stdout.strip()
    if hooks_cfg:
        say("note", f"core.hooksPath={hooks_cfg}: installing hook into configured directory")
    ours = target / "scripts" / "pre-commit"
    rel = os.path.relpath(hook, target)
    verb = "created"
    if hook.exists() or hook.is_symlink():
        try:
            same = hook.resolve() == ours.resolve() or hook.read_bytes() == ours.read_bytes()
        except OSError:
            same = False
        if same:
            say("up to date", f"{rel} (gate: local)")
            return
        if not _is_casa_hook(hook):
            say("WARNING", f"{hook} exists and is not a CASA hook — leaving untouched; "
                           "integrate `scripts/docs-check` into it manually")
            return
        hook.unlink()  # copy/symlink from an earlier CASA version: upgrade in place
        verb = "updated"
    hook.parent.mkdir(parents=True, exist_ok=True)
    # Symlink only when hooks_dir lives inside this checkout; in a worktree, hooks_dir is
    # SHARED across checkouts — copy the file so it resolves docs-check from the committer's
    # own worktree toplevel rather than rotting if the worktree is removed.
    try:
        if not (target == hooks_dir or target in hooks_dir.parents):
            raise OSError
        hook.symlink_to(os.path.relpath(ours, hooks_dir))
    except OSError:
        shutil.copy2(ours, hook)
        hook.chmod(0o755)
    say(verb, f"{rel} → scripts/pre-commit (gate: local, ADR-0006)")


def main():
    utf8_stdio()
    ap = argparse.ArgumentParser(
        description="install/update CASA Standard infrastructure in a repository (SPEC-0001)")
    ap.add_argument("target")
    ap.add_argument("--repo-id", default=None)
    ap.add_argument("--tier", choices=["T0", "T1"], default="T1")
    args = ap.parse_args()

    target = Path(args.target).expanduser().resolve()
    if target == SRC:
        sys.exit("casa-init: target is casa-standard itself — nothing to do.")
    if target.exists() and not target.is_dir():
        sys.exit(f"casa-init: target is not a directory: {target}")
    target.mkdir(parents=True, exist_ok=True)
    repo_id = args.repo_id or target.name
    ref = src_ref()

    # 1. Toolchain — tool-owned
    for rel in TOOLCHAIN:
        s, d = SRC / rel, target / rel
        d.parent.mkdir(parents=True, exist_ok=True)
        if not d.exists():
            shutil.copy2(s, d)
            say("created", rel)
        elif not filecmp.cmp(s, d, shallow=False):
            shutil.copy2(s, d)
            say("updated", rel)
        else:
            say("up to date", rel)
    for rel in ("scripts/docs-check", "scripts/docs-reserve", "scripts/casa-update-check",
                "scripts/pre-commit"):
        (target / rel).chmod(0o755)

    # 2. Identity — repo-owned (only casa-standard-ref is tool-owned)
    router = target / "AGENTS.md"
    if not router.exists():
        text = (SRC / "docs/templates/AGENTS.template.md").read_text(encoding="utf-8")
        text = text.replace("<repo-canonical-name>", repo_id).replace("<nome-canonico-do-repo>", repo_id)
        if args.tier == "T0":
            text = text.replace("casa-tier: T1", "casa-tier: T0", 1)
        text = re.sub(r"casa-version: \S+", f"casa-version: {CASA_VERSION}", text, count=1)
        text = text.replace("casa-standard-ref: <sha>", f"casa-standard-ref: {ref}", 1)
        # write_bytes preserves LF on Windows (write_text translates \n → \r\n)
        router.write_bytes(text.encode("utf-8"))
        say("created", f"AGENTS.md (router; repo-id={repo_id}, tier={args.tier} — fill in sections)")
    else:
        old = router.read_text(encoding="utf-8")
        new, changed = upsert_router_meta(old, ref)
        if new != old:
            router.write_bytes(new.encode("utf-8"))
            say("updated", "AGENTS.md: " + "; ".join(changed))
        else:
            say("preserved", "AGENTS.md (router belongs to the repo — never overwritten)")

    # 2b. Host shim (ADR-0009): Claude Code does not read AGENTS.md natively — CLAUDE.md
    # imports the router. Created only if missing; existing file is repo identity.
    shim_name, shim_tpl, shim_marker = HOST_SHIM
    shim = target / shim_name
    if not shim.exists():
        text = (SRC / shim_tpl).read_text(encoding="utf-8")
        shim.write_bytes(text.encode("utf-8"))
        say("created", f"{shim_name} (shim → AGENTS.md, ADR-0009)")
    elif shim_marker in shim.read_text(encoding="utf-8"):
        say("up to date", f"{shim_name} (shim → AGENTS.md)")
    else:
        say("WARNING", f"{shim_name} exists without `{shim_marker}` — Claude Code will not "
                       f"load the router; add `{shim_marker}` (ADR-0009)")

    # 2c. Delivery-cycle skills (ADR-0017) — T1 only: T0 repos have no ADRs/Specs.
    if router_tier(router.read_text(encoding="utf-8", errors="replace"), args.tier) == "T0":
        if remove_casa_skills(target):
            say("removed", "cycle skills (casa-*): repo switched to T0 (ADR-0017)")
        else:
            say("skipped", "cycle skills (casa-*): T0 repo does not use ADRs/Specs (ADR-0017)")
    else:
        install_skills(target, ref)

    # 3. Gate (ADR-0006): CI adapter selected by remote host; pre-commit hook is fallback
    r = sh(["git", "-C", str(target), "rev-parse", "--show-toplevel"])
    if r.returncode != 0:
        say("WARNING", "no .git directory: gate not installed — run `git init` then re-run casa-init (STANDARD §3)")
    elif Path(r.stdout.strip()).resolve() != target:
        # Git found an ANCESTOR repo: hooks and workflows apply to its root, which has no
        # router or validator — installing there would break commits in the parent repo.
        say("WARNING", f"target is inside parent repo {r.stdout.strip()} without being its root: "
                       "gate not installed (hooks and CI apply to the root) — run `git init` in "
                       "target, or run casa-init at the repo root (STANDARD §3)")
    else:
        urls = [ln.split(None, 1)[1]
                for ln in sh(["git", "-C", str(target), "config", "--get-regexp",
                              r"^remote\..*\.url$"]).stdout.splitlines() if " " in ln]
        if any(remote_host(u) == "github.com" for u in urls):
            branch = default_branch(target)
            for tpl, dest, label in GITHUB_WORKFLOWS:
                wf = target / dest
                content = render_workflow((SRC / tpl).read_text(encoding="utf-8"), branch)
                if not wf.exists():
                    wf.parent.mkdir(parents=True, exist_ok=True)
                    wf.write_bytes(content.encode("utf-8"))
                    extra = f"; default branch: {branch}" if "branches:" in content else ""
                    say("created", f"{dest} ({label}{extra})")
                elif wf.read_text(encoding="utf-8") == content:
                    say("up to date", dest)
                else:
                    # Workflows belong to the repo (may be customized) — never overwritten,
                    # but upstream template fixes won't arrive silently: warn the adopter.
                    say("WARNING", f"{dest} differs from this version's template — compare with "
                                   f"{tpl} and merge relevant updates (casa-init never overwrites)")
            say("note", f"mark the `docs-check` check as REQUIRED in branch protection for "
                        f"{branch} — otherwise CI warns without blocking merges (STANDARD §3)")
        else:
            if urls:
                say("WARNING", f"remote has no CI adapter ({remote_host(urls[0]) or urls[0]}): "
                               "installed local pre-commit hook (ADR-0006) — integrate "
                               "`scripts/docs-check` into your host's CI")
            install_hook(target)

    # 4. Diagnostic — legacy content migration is human work (§10)
    print()
    r = sh([sys.executable, str(target / "scripts" / "docs-check")], cwd=target)
    print(r.stdout.strip() or "(docs-check produced no output)")
    if r.returncode != 0:
        print("→ existing docs require content migration (STANDARD §10) — the gate will enforce it.")
    else:
        print(f"→ repo green under CASA (source: casa-standard@{ref}).")


if __name__ == "__main__":
    main()
