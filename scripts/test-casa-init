#!/usr/bin/env bash
# Cenários das SPEC-0001, 0009 e 0010 (casa-init). DoD: exit 0 = todos verdes.
# Roda local e no CI; sem dependências além de git, python3 e coreutils.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
INIT="$ROOT/scripts/casa-init"
# Versões derivadas das constantes (nunca hardcodadas): todo bump toca só os scripts.
CASA_V="$(sed -n 's/^CASA_VERSION = "\(.*\)"$/\1/p' "$INIT")"
DC_V="$(sed -n 's/^CONTRACT_VERSION = "\(.*\)"$/\1/p' "$ROOT/scripts/docs-check")"
pass=0; fail=0
ck() { if eval "$2" >/dev/null 2>&1; then echo "PASS: $1"; pass=$((pass+1)); else echo "FAIL: $1"; fail=$((fail+1)); fi; }
tree_hash() { (cd "$1" && find . -type f | LC_ALL=C sort | xargs cat | cksum); }

# EARS 1, 11, 10 — greenfield (cria destino), repo-id explícito, idempotência
A="$(mktemp -d)/novo"
python3 "$INIT" "$A" --repo-id meu-app >/dev/null
ck "EARS-1/11: router criado com repo-id"            'grep -q "casa-repo-id: meu-app" "$A/AGENTS.md"'
ck "router criado com casa-version"                  'grep -q "casa-version: $CASA_V" "$A/AGENTS.md"'
ck "ADR-0010: constantes casa-init/docs-check iguais" '[ -n "$CASA_V" ] && [ "$CASA_V" = "$DC_V" ]'
ck "ref carimbado (placeholder substituído)"         'grep -q "^casa-standard-ref: " "$A/AGENTS.md" && ! grep -q "<sha>" "$A/AGENTS.md"'
ck "docs-check verde no destino recém-criado"        '(cd "$A" && python3 scripts/docs-check)'
ck "SPEC-0005/1: ponte CLAUDE.md criada com @AGENTS.md" 'grep -q "^@AGENTS.md" "$A/CLAUDE.md"'
H1=$(tree_hash "$A"); python3 "$INIT" "$A" --repo-id meu-app >/dev/null; H2=$(tree_hash "$A")
ck "EARS-10: segunda execução não muda nenhum byte"  '[ "$H1" = "$H2" ]'

# EARS 3 — router existente é do repo
B="$(mktemp -d)/r"; mkdir -p "$B"; printf 'meu router\n' > "$B/AGENTS.md"
python3 "$INIT" "$B" >/dev/null
ck "EARS-3: AGENTS.md existente preservado"          '[ "$(cat "$B/AGENTS.md")" = "meu router" ]'

# Router antigo com bloco yaml recebe metadados tool-owned sem perder conteúdo
BV="$(mktemp -d)/rv"; mkdir -p "$BV"; cat > "$BV/AGENTS.md" <<'EOF'
# AGENTS.md
```yaml
casa-repo-id: velho
casa-tier: T1
```
conteúdo do repo
EOF
python3 "$INIT" "$BV" >/dev/null
ck "router antigo sem casa-version a recebe"         'grep -q "casa-version: $CASA_V" "$BV/AGENTS.md"'
ck "router antigo recebe casa-standard-ref"          'grep -q "^casa-standard-ref: " "$BV/AGENTS.md"'
ck "router antigo preserva conteúdo do repo"         'grep -q "conteúdo do repo" "$BV/AGENTS.md"'

# ADR-0010 — casa-version existente é PROMESSA do repo: nunca alterada; ref é da ferramenta
PV="$(mktemp -d)/pv"; mkdir -p "$PV"; cat > "$PV/AGENTS.md" <<'EOF'
# AGENTS.md
```yaml
casa-repo-id: velho
casa-tier: T1
casa-version: 0.9
casa-standard-ref: ref-antiga
```
conteúdo do repo
EOF
python3 "$INIT" "$PV" >/dev/null
ck "ADR-0010: casa-version existente não é alterada" 'grep -q "casa-version: 0.9" "$PV/AGENTS.md"'
ck "ADR-0010: casa-standard-ref é atualizado"        '! grep -q "casa-standard-ref: ref-antiga" "$PV/AGENTS.md"'

# SPEC-0005/2,3 — ponte CLAUDE.md existente é identidade do repo
CS="$(mktemp -d)/shim-ok"; mkdir -p "$CS"; printf '@AGENTS.md\nregras minhas\n' > "$CS/CLAUDE.md"
OUT=$(python3 "$INIT" "$CS" 2>&1)
ck "SPEC-0005/2: CLAUDE.md com @AGENTS.md intocado"  '[ "$(cat "$CS/CLAUDE.md")" = "@AGENTS.md
regras minhas" ]'
ck "SPEC-0005/2: e relatado em dia"                  'echo "$OUT" | grep -q "em dia.*CLAUDE.md"'
CA="$(mktemp -d)/shim-alheio"; mkdir -p "$CA"; printf 'instrucoes custom\n' > "$CA/CLAUDE.md"
OUT=$(python3 "$INIT" "$CA" 2>&1)
ck "SPEC-0005/3: CLAUDE.md sem @AGENTS.md preservado" '[ "$(cat "$CA/CLAUDE.md")" = "instrucoes custom" ]'
ck "SPEC-0005/3: e gera AVISO com a linha a adicionar" 'echo "$OUT" | grep -q "AVISO.*CLAUDE.md.*@AGENTS.md"'

# EARS 4 — toolchain desatualizada é da ferramenta
C="$(mktemp -d)/u"; python3 "$INIT" "$C" >/dev/null
printf '# versao velha\n' > "$C/scripts/docs-check"
OUT=$(python3 "$INIT" "$C" 2>&1)
ck "EARS-4: toolchain divergente é sobrescrita"      'cmp -s "$ROOT/scripts/docs-check" "$C/scripts/docs-check"'
ck "EARS-4: e relatada como atualizada"              'echo "$OUT" | grep -q "atualizado.*scripts/docs-check"'

# EARS 6 — git sem remote → hook
D="$(mktemp -d)/g"; mkdir -p "$D"; git init -q "$D"
python3 "$INIT" "$D" >/dev/null
ck "EARS-6: pre-commit hook instalado sem remote"    '[ -e "$D/.git/hooks/pre-commit" ]'

# EARS 7 — git com remote GitHub → workflows, sem hook (URL scp-like cobre esse parser)
E="$(mktemp -d)/h"; mkdir -p "$E"; git init -q "$E"; git -C "$E" remote add origin git@github.com:org/x.git
python3 "$INIT" "$E" >/dev/null
ck "EARS-7: workflow de CI criado com remote GitHub" '[ -f "$E/.github/workflows/docs-check.yml" ]'
ck "EARS-7: hook não instalado com remote GitHub"    '[ ! -e "$E/.git/hooks/pre-commit" ]'
ck "SPEC-0008/7: update-check criado com remote GitHub" '[ -f "$E/.github/workflows/casa-update-check.yml" ]'

# EARS 12 — remote sem adaptador de CI (ex.: GitLab) → hook + AVISO, sem workflow (ADR-0006)
H="$(mktemp -d)/gl"; mkdir -p "$H"; git init -q "$H"; git -C "$H" remote add origin https://gitlab.com/org/x.git
OUT=$(python3 "$INIT" "$H" 2>&1)
ck "EARS-12: hook instalado com remote não-GitHub"   '[ -e "$H/.git/hooks/pre-commit" ]'
ck "EARS-12: workflow não criado com remote não-GitHub" '[ ! -f "$H/.github/workflows/docs-check.yml" ]'
ck "SPEC-0008/7: update-check não criado sem GitHub" '[ ! -f "$H/.github/workflows/casa-update-check.yml" ]'
ck "EARS-12: AVISO orienta integrar ao CI do host"   'echo "$OUT" | grep -q "AVISO.*sem adaptador de CI.*gitlab.com"'

# EARS 8 — hook alheio não é tocado
F="$(mktemp -d)/f"; mkdir -p "$F"; git init -q "$F"
printf '#!/bin/sh\necho alheio\n' > "$F/.git/hooks/pre-commit"; chmod +x "$F/.git/hooks/pre-commit"
OUT=$(python3 "$INIT" "$F" 2>&1)
ck "EARS-8: hook alheio preservado"                  'grep -q "echo alheio" "$F/.git/hooks/pre-commit"'
ck "EARS-8: hook alheio gera AVISO"                  'echo "$OUT" | grep -q "AVISO.*não é o do CASA"'

# EARS 5, 9 — legado sem .git e com docs inválidos: instala, relata, exit 0
G="$(mktemp -d)/l"; mkdir -p "$G/docs/adr"; printf '# doc legado sem frontmatter\n' > "$G/docs/adr/0001-legado.md"
OUT=$(python3 "$INIT" "$G" 2>&1); RC=$?
ck "EARS-9: exit 0 mesmo com docs legados inválidos" '[ "$RC" -eq 0 ]'
ck "EARS-9: migração pendente relatada"              'echo "$OUT" | grep -q "migração"'
ck "EARS-5: sem .git orienta e não instala gate"     'echo "$OUT" | grep -q "sem .git"'

# EARS 2 — destino = casa-standard
ck "EARS-2: auto-destino abortado com exit != 0"     '! python3 "$INIT" "$ROOT"'

# --- SPEC-0009: gate confiável ---
gitrepo() { D="$(mktemp -d)/$1"; mkdir -p "$D"; git init -q -b "${2:-main}" "$D";
            git -C "$D" config user.email casa@example.invalid; git -C "$D" config user.name CASA; }

# SPEC-0009/1 — DoD do router novo é o gate real, não comando de exemplo
A9="$(mktemp -d)/novo"; python3 "$INIT" "$A9" --repo-id app >/dev/null
ck "SPEC-0009/1: DoD do router novo roda o docs-check" \
   'sed -n "/^## Como validar/,/^## /p" "$A9/AGENTS.md" | grep -q "^python3 scripts/docs-check"'
ck "SPEC-0009/1: DoD do router novo sem npm de exemplo" \
   '! sed -n "/^## Como validar/,/^## /p" "$A9/AGENTS.md" | grep -q "^npm"'

# SPEC-0009/15 — core.hooksPath: hook vai para o diretório que o git executa
gitrepo hp; git -C "$D" config core.hooksPath .githooks
OUT=$(python3 "$INIT" "$D" 2>&1)
ck "SPEC-0009/15: hook instalado no core.hooksPath" '[ -e "$D/.githooks/pre-commit" ] && [ ! -e "$D/.git/hooks/pre-commit" ]'

# SPEC-0009/16 — worktree: hook no diretório comum, como cópia; checkout sem toolchain segue livre
gitrepo wtmain; git -C "$D" commit -q --allow-empty -m i; MAIN="$D"
WT="$(mktemp -d)/wt"; git -C "$MAIN" worktree add -q "$WT" -b feat
python3 "$INIT" "$WT" >/dev/null 2>&1
ck "SPEC-0009/16: hook do worktree no diretório comum" '[ -f "$MAIN/.git/hooks/pre-commit" ]'
ck "SPEC-0009/16: hook comum é cópia, não link para um worktree" '[ ! -L "$MAIN/.git/hooks/pre-commit" ]'
echo x > "$MAIN/x.txt"; git -C "$MAIN" add x.txt
ck "SPEC-0009/16: checkout sem toolchain não é bloqueado" 'git -C "$MAIN" commit -q -m x'

# SPEC-0009/17 — destino é subpasta de outro repo: não instala gate no repo pai
gitrepo pai; echo x > "$D/f"; git -C "$D" add f; git -C "$D" commit -q -m i
OUT=$(python3 "$INIT" "$D/sub" 2>&1)
ck "SPEC-0009/17: subpasta não instala hook no repo pai" '[ ! -e "$D/.git/hooks/pre-commit" ]'
ck "SPEC-0009/17: AVISO orienta" 'echo "$OUT" | grep -q "AVISO.*sem ser a raiz"'
echo y >> "$D/f"; git -C "$D" add f
ck "SPEC-0009/17: repo pai segue commitando" 'git -C "$D" commit -q -m y'

# SPEC-0009/18 — GitHub com branch padrão master; workflow divergente gera AVISO
gitrepo ghm master; git -C "$D" remote add origin git@github.com:acme/app.git
git -C "$D" commit -q --allow-empty -m i
OUT=$(python3 "$INIT" "$D" 2>&1)
WF="$D/.github/workflows/docs-check.yml"
ck "SPEC-0009/18: push no branch padrão real" 'grep -q "branches: \[master\]" "$WF"'
ck "SPEC-0009/18: base de comparação vem do evento" 'grep -q "github.base_ref" "$WF" && grep -q "github.event.before" "$WF"'
ck "SPEC-0009/18: nota de check obrigatório" 'echo "$OUT" | grep -q "OBRIGATÓRIO na proteção do branch master"'
echo "# customizado" >> "$WF"
OUT=$(python3 "$INIT" "$D" 2>&1)
ck "SPEC-0009/18: workflow divergente gera AVISO e é preservado" \
   'echo "$OUT" | grep -q "AVISO.*difere do template" && grep -q "customizado" "$WF"'

# --- SPEC-0010: skills do ciclo (ADR-0017) ---
SK="$(mktemp -d)/sk"; python3 "$INIT" "$SK" --repo-id sk >/dev/null
NAMES="casa-explore casa-propose casa-apply casa-verify casa-close"
all_in() { for n in $NAMES; do [ -f "$1/$n/SKILL.md" ] || return 1; done; }

# SPEC-0010/1 — T1: as cinco skills nos dois diretórios
ck "SPEC-0010/1: skills em .agents/skills"         'all_in "$SK/.agents/skills"'
ck "SPEC-0010/1: skills em .claude/skills"         'all_in "$SK/.claude/skills"'

# SPEC-0010/2 — cópias idênticas entre si e ao template (um fato, uma fonte)
same_all() { for n in $NAMES; do cmp -s "$ROOT/docs/templates/skills/$n/SKILL.md" "$SK/.agents/skills/$n/SKILL.md" &&
             cmp -s "$ROOT/docs/templates/skills/$n/SKILL.md" "$SK/.claude/skills/$n/SKILL.md" || return 1; done; }
ck "SPEC-0010/2: cópias idênticas ao template"     'same_all'

# SPEC-0010/3 — formato Agent Skills portável (agentskills.io/specification)
ck "SPEC-0010/3: frontmatter válido e portável" 'python3 - "$ROOT/docs/templates/skills" <<'"'"'EOF'"'"'
import re, sys
from pathlib import Path
dirs = sorted(p for p in Path(sys.argv[1]).iterdir() if p.is_dir())
assert len(dirs) == 5, dirs
for d in dirs:
    t = (d / "SKILL.md").read_text(encoding="utf-8")
    assert t.startswith("---\n"), d
    fm = t.split("---\n")[1]
    keys = dict(re.findall(r"^([a-z-]+): (.*)$", fm, re.M))
    assert set(keys) == {"name", "description"}, (d, keys)            # só campos portáveis
    n, desc = keys["name"], keys["description"]
    assert n == d.name and re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", n) and len(n) <= 64, n
    assert 0 < len(desc) <= 1024 and "<" not in desc and ">" not in desc, d
    assert ": " not in desc and " #" not in desc, d                    # escalar YAML simples
EOF'

# SPEC-0010/4 — todo scripts/… citado nas skills existe na toolchain instalada
cmds_exist() { for s in $(grep -oh "scripts/[a-z-]*" "$SK"/.agents/skills/*/SKILL.md | sort -u); do
               [ -f "$SK/$s" ] || return 1; done; }
ck "SPEC-0010/4: comandos citados existem no destino" 'cmds_exist'

# SPEC-0010/5 — casa-* alterada volta ao template; skill do repo com outro nome intocada
echo "edição local" >> "$SK/.claude/skills/casa-verify/SKILL.md"
mkdir -p "$SK/.claude/skills/minha-skill"; printf -- "---\nname: minha-skill\ndescription: x\n---\n" > "$SK/.claude/skills/minha-skill/SKILL.md"
OUT=$(python3 "$INIT" "$SK" 2>&1)
ck "SPEC-0010/5: casa-* divergente é atualizada"   'same_all && echo "$OUT" | grep -q "atualizado.*claude/skills/casa-"'
ck "SPEC-0010/5: skill do repo intocada"           'grep -q "name: minha-skill" "$SK/.claude/skills/minha-skill/SKILL.md"'

# SPEC-0010/6 — T0 não recebe skills (sem ADR/Spec para o ciclo operar)
T0="$(mktemp -d)/t0"; python3 "$INIT" "$T0" --tier T0 >/dev/null
ck "SPEC-0010/6: T0 sem skills"                    '[ ! -e "$T0/.agents/skills" ] && [ ! -e "$T0/.claude/skills" ]'

echo
echo "==== $pass PASS / $fail FAIL ===="
[ "$fail" -eq 0 ]
